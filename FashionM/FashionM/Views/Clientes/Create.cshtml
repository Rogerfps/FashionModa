@model Clientes

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<link rel="stylesheet" href="~/css/Cliente/ClienteCreate.css" />

<!-- HEADER MINIMALISTA -->
<div class="neo-header">
    <div class="title-container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="title-glow">Nuevo Cliente</h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Ingresa la información del nuevo cliente</p>
        </div>
        <a asp-action="Index" class="back-link">
            <span>←</span> Volver al listado
        </a>
    </div>
</div>

<div class="container-fluid px-4" style="max-width: 1200px; margin: 0 auto;">
    <div class="form-card">
        <!-- Encabezado de creación -->
        <div class="create-header">
            <div class="create-icon">
                ✨
            </div>
            <div class="create-title">
                <h3>Registrar Nuevo Cliente</h3>
                <div class="create-subtitle">
                    Completa todos los campos obligatorios para crear un nuevo cliente en el sistema
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Mostrar errores generales -->
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-grid">
                <!-- SECCIÓN 1: Identificación -->
                <div class="form-section">
                    <div class="section-title">
                        <span>🆔</span> Identificación
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Cedula">Número de Cédula</label>
                        <input asp-for="Cedula" class="form-control-modern" placeholder="Ej: 1-1234-5678" />
                        <span asp-validation-for="Cedula" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Codigo">Código de Cliente</label>
                        <input asp-for="Codigo" class="form-control-modern" placeholder="Ej: CLT001" />
                        <span asp-validation-for="Codigo" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="IDTipo">Tipo de Identificación</label>
                        <select asp-for="IDTipo"
                                asp-items="ViewBag.TiposIdentificacion"
                                class="form-control-modern">
                            <option value="">-- Seleccione tipo --</option>
                        </select>
                        <span asp-validation-for="IDTipo" class="validation-message"></span>
                    </div>
                </div>

                <!-- SECCIÓN 2: Nombre -->
                <div class="form-section">
                    <div class="section-title">
                        <span>👤</span> Nombre Completo
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Nombre">Nombre</label>
                        <input asp-for="Nombre" class="form-control-modern" placeholder="Nombre(s)" />
                        <span asp-validation-for="Nombre" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Apellidos">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control-modern" placeholder="Apellido(s)" />
                        <span asp-validation-for="Apellidos" class="validation-message"></span>
                    </div>
                </div>

                <!-- SECCIÓN 3: Contacto -->
                <div class="form-section">
                    <div class="section-title">
                        <span>📞</span> Contacto
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Correo">Correo Electrónico</label>
                        <input asp-for="Correo" class="form-control-modern" type="email" placeholder="cliente@email.com" />
                        <span asp-validation-for="Correo" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Telefonos">Teléfonos</label>
                        <input asp-for="Telefonos" class="form-control-modern" placeholder="8888-8888 / 2222-2222" />
                        <span asp-validation-for="Telefonos" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Direccion">Dirección</label>
                        <input asp-for="Direccion" class="form-control-modern" placeholder="Dirección exacta" />
                        <span asp-validation-for="Direccion" class="validation-message"></span>
                    </div>
                </div>

                <!-- SECCIÓN 4: Comercio -->
                <div class="form-section">
                    <div class="section-title">
                        <span>🏢</span> Comercio
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Comercio">Nombre del Comercio</label>
                        <input asp-for="Comercio" class="form-control-modern" placeholder="Razón social" />
                        <span asp-validation-for="Comercio" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="ActividadEconomica">Actividad Económica</label>
                        <input asp-for="ActividadEconomica" class="form-control-modern" placeholder="Actividad principal" />
                        <span asp-validation-for="ActividadEconomica" class="validation-message"></span>
                    </div>
                </div>

                <!-- SECCIÓN 5: Información Comercial (full width) -->
                <div class="form-section full-width">
                    <div class="section-title">
                        <span>📊</span> Información Comercial
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
                        <div class="form-group-modern">
                            <label asp-for="Agente">Agente Asignado</label>
                            <input asp-for="Agente" class="form-control-modern" placeholder="Nombre del agente" />
                            <span asp-validation-for="Agente" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="Transporte">Transporte</label>
                            <input asp-for="Transporte" class="form-control-modern" placeholder="Método de transporte" />
                            <span asp-validation-for="Transporte" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="Zona">Zona Geográfica</label>
                            <input asp-for="Zona" class="form-control-modern" placeholder="Zona" />
                            <span asp-validation-for="Zona" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="LimiteCredito">Límite de Crédito (₡)</label>
                            <input asp-for="LimiteCredito" class="form-control-modern" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="LimiteCredito" class="validation-message"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Empresa" class="form-label"></label>
                            <input asp-for="Empresa" class="form-control" />
                            <span asp-validation-for="Empresa" class="text-danger"></span>
                        </div>

                    </div>
                </div>

                <!-- SECCIÓN 6: Estado -->
                <div class="form-section full-width">
                    <div class="checkbox-wrapper">
                        <input asp-for="Estado" class="checkbox-modern" type="checkbox" checked />
                        <label asp-for="Estado" class="checkbox-label">
                            Cliente Activo
                            <small class="d-block text-muted" style="font-size: 0.75rem; font-weight: normal;">
                                Los clientes inactivos no aparecerán en búsquedas por defecto. Por defecto, los nuevos clientes están activos.
                            </small>
                        </label>
                    </div>
                </div>
            </div>

            

            <!-- Botones de acción -->
            <div class="action-buttons">
                <a asp-action="Index" class="btn-neo-outline">
                    <span>←</span> Cancelar
                </a>
                <button type="submit" class="btn-create">
                    <span>💾</span> Guardar Cliente
                </button>
            </div>
        </form>
    </div>
</div>