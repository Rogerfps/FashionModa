@model Clientes

@{
    ViewData["Title"] = "Editar Cliente";
}

<link rel="stylesheet" href="~/css/Cliente/ClienteEdit.css" />

<!-- HEADER MINIMALISTA -->
<div class="neo-header">
    <div class="title-container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="title-glow">Editar Cliente</h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Modifica la información del cliente</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Cedula" class="back-link">
            <span>←</span> Ver detalles
        </a>
    </div>
</div>

<div class="container-fluid px-4" style="max-width: 1200px; margin: 0 auto;">
    <div class="form-card">
        <!-- Encabezado con información del cliente -->
        <div class="edit-header">
            <div class="edit-avatar">
                @Model.Nombre.Substring(0, 1)@Model.Apellidos.Substring(0, 1)
            </div>
            <div class="edit-title">
                <h3>@Model.Nombre @Model.Apellidos</h3>
                <div class="edit-subtitle">
                    <span class="edit-badge">Código: @Model.Codigo</span>
                    <span class="edit-badge">Cédula: @Model.Cedula</span>
                </div>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Cedula" />

            <div class="form-grid">
                <!-- SECCIÓN 1: Información Personal -->
                <div class="form-section">
                    <div class="section-title">
                        <span>👤</span> Información Personal
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Codigo">Código</label>
                        <input asp-for="Codigo" class="form-control-modern" placeholder="Ej: CLT001" />
                        <span asp-validation-for="Codigo" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Nombre">Nombre</label>
                        <input asp-for="Nombre" class="form-control-modern" placeholder="Nombre completo" />
                        <span asp-validation-for="Nombre" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Apellidos">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control-modern" placeholder="Apellidos completos" />
                        <span asp-validation-for="Apellidos" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="IDTipo">Tipo de Identificación</label>
                        <select asp-for="IDTipo"
                                asp-items="ViewBag.TiposIdentificacion"
                                class="form-control-modern">
                            <option value="">-- Seleccione tipo --</option>
                        </select>
                        <span asp-validation-for="IDTipo" class="validation-message"></span>
                    </div>
                </div>

                <!-- SECCIÓN 2: Contacto -->
                <div class="form-section">
                    <div class="section-title">
                        <span>📞</span> Contacto
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Correo">Correo Electrónico</label>
                        <input asp-for="Correo" class="form-control-modern" type="email" placeholder="cliente@email.com" />
                        <span asp-validation-for="Correo" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Telefonos">Teléfonos</label>
                        <input asp-for="Telefonos" class="form-control-modern" placeholder="8888-8888 / 2222-2222" />
                        <span asp-validation-for="Telefonos" class="validation-message"></span>
                    </div>

                    <div class="form-group-modern">
                        <label asp-for="Direccion">Dirección</label>
                        <input asp-for="Direccion" class="form-control-modern" placeholder="Dirección exacta" />
                        <span asp-validation-for="Direccion" class="validation-message"></span>
                    </div>
                </div>

                <!-- SECCIÓN 3: Información Comercial (full width) -->
                <div class="form-section full-width">
                    <div class="section-title">
                        <span>🏢</span> Información Comercial
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
                        <div class="form-group-modern">
                            <label asp-for="Comercio">Comercio</label>
                            <input asp-for="Comercio" class="form-control-modern" placeholder="Nombre del comercio" />
                            <span asp-validation-for="Comercio" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="ActividadEconomica">Actividad Económica</label>
                            <input asp-for="ActividadEconomica" class="form-control-modern" placeholder="Actividad" />
                            <span asp-validation-for="ActividadEconomica" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="Agente">Agente</label>
                            <input asp-for="Agente" class="form-control-modern" placeholder="Agente asignado" />
                            <span asp-validation-for="Agente" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="Transporte">Transporte</label>
                            <input asp-for="Transporte" class="form-control-modern" placeholder="Transporte" />
                            <span asp-validation-for="Transporte" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="Zona">Zona</label>
                            <input asp-for="Zona" class="form-control-modern" placeholder="Zona geográfica" />
                            <span asp-validation-for="Zona" class="validation-message"></span>
                        </div>

                        <div class="form-group-modern">
                            <label asp-for="LimiteCredito">Límite de Crédito (₡)</label>
                            <input asp-for="LimiteCredito" class="form-control-modern" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="LimiteCredito" class="validation-message"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Empresa" class="form-label"></label>
                            <input asp-for="Empresa" class="form-control" />
                            <span asp-validation-for="Empresa" class="text-danger"></span>
                        </div>

                    </div>
                </div>

                <!-- SECCIÓN 4: Estado -->
                <div class="form-section full-width">
                    <div class="checkbox-wrapper">
                        <input asp-for="Estado" class="checkbox-modern" type="checkbox" />
                        <label asp-for="Estado" class="checkbox-label">
                            Cliente Activo
                            <small class="d-block text-muted" style="font-size: 0.75rem; font-weight: normal;">
                                Los clientes inactivos no aparecerán en búsquedas por defecto
                            </small>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="action-buttons">
                <a asp-action="Index" class="btn-neo-outline">
                    <span>←</span> Cancelar
                </a>
                <button type="submit" class="btn-save">
                    <span>💾</span> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>