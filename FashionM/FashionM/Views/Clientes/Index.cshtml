
@model IEnumerable<FashionM.Models.Clientes>

@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="~/css/Cliente/ClienteIndex.css" />

<!-- HEADER -->
<div class="neo-header">
    <div class="title-container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="title-glow">Clientes</h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                Gestiona tu cartera de clientes
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="ExportarExcel"
               asp-route-buscar="@Context.Request.Query["buscar"]"
               asp-route-estado="@Context.Request.Query["estado"]"
               asp-route-zona="@Context.Request.Query["zona"]"
               asp-route-empresa="@Context.Request.Query["empresa"]"
               class="btn-neo">
                📊 Descargar Excel
            </a>

            <a asp-action="Create" class="btn-neo">
                <span>+</span> Nuevo Cliente
            </a>
        </div>
    </div>
</div>

<div class="container-fluid px-4" style="max-width: 1600px; margin: 0 auto;">

    <!-- FILTROS -->
    <div class="filters-container">
        <form asp-action="Index" method="get">
            <div class="row g-3">

                <div class="col-lg-4">
                    <div class="filter-label">Buscar</div>
                    <input type="text"
                           name="buscar"
                           value="@Context.Request.Query["buscar"]"
                           class="filter-input w-100"
                           placeholder="Código, nombre, alias, cédula o teléfono"
                           oninput="clearTimeout(window.t); window.t = setTimeout(() => this.form.submit(), 800);" />
                </div>

                <div class="col-lg-2">
                    <div class="filter-label">Estado</div>
                    <select name="estado"
                            class="filter-input w-100"
                            onchange="this.form.submit()">
                        <option value="">Todos</option>
                        <option value="true"
                                selected="@(Context.Request.Query["estado"] == "true")">
                            Activos
                        </option>
                        <option value="false"
                                selected="@(Context.Request.Query["estado"] == "false")">
                            Inactivos
                        </option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <div class="filter-label">Zona</div>
                    <select name="zona"
                            class="filter-input w-100"
                            onchange="this.form.submit()">
                        <option value="">Todas</option>

                        @if (ViewBag.Zonas != null)
                        {
                            foreach (var z in ViewBag.Zonas as List<string>)
                            {
                                <option value="@z"
                                        selected="@(Context.Request.Query["zona"] == z)">
                                    @z
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <div class="filter-label">Empresa</div>
                    <select name="empresa"
                            class="filter-input w-100"
                            onchange="this.form.submit()">
                        <option value="">Todas</option>

                        @if (ViewBag.Empresas != null)
                        {
                            foreach (var e in ViewBag.Empresas as List<string>)
                            {
                                <option value="@e"
                                        selected="@(Context.Request.Query["empresa"] == e)">
                                    @e
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2 d-flex align-items-end">
                    <button type="submit" class="btn-neo-outline w-100">
                        Filtrar
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- TABLA DE CLIENTES -->
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="modern-table">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Cédula</th>
                        <th>Alias</th>
                        <th>Teléfono</th>
                        <th>Zona</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="empty-state">
                                    <div class="empty-state-icon">📋</div>
                                    <h5>No hay clientes</h5>
                                    <p class="text-muted">
                                        No se encontraron clientes con los filtros seleccionados.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- CÓDIGO -->
                                <td>
                                    <span class="code-badge">
                                        @item.Codigo
                                    </span>
                                </td>

                                <!-- CLIENTE -->
                                <td class="fw-bold">
                                    @item.Nombre @item.Apellidos
                                </td>

                                <!-- CÉDULA -->
                                <td>
                                    @item.Cedula
                                </td>

                                <!-- ALIAS -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Alias))
                                    {
                                        <span class="zona-tag">
                                            @item.Alias
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <!-- TELÉFONO -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Telefonos))
                                    {
                                        @item.Telefonos
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <!-- ZONA -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Zona))
                                    {
                                        <span class="zona-tag">
                                            @item.Zona
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <!-- ESTADO -->
                                <td>
                                    <span class="status-badge @(item.Estado ? "active" : "inactive")">
                                        @(item.Estado ? "Activo" : "Inactivo")
                                    </span>
                                </td>

                                <!-- ACCIONES -->
                                <td>
                                    <div class="dropdown">
                                        <button type="button"
                                                class="action-btn"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Acciones">
                                            ⋮
                                        </button>

                                        <ul class="dropdown-menu action-dropdown dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="Details"
                                                   asp-route-id="@item.Cedula">
                                                    👁️ Detalles
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Cedula">
                                                    ✏️ Editar
                                                </a>
                                            </li>

                                            <li>
                                                <hr class="dropdown-divider" />
                                            </li>

                                            <li>
                                                <a class="dropdown-item text-danger"
                                                   asp-action="Delete"
                                                   asp-route-id="@item.Cedula">
                                                    🗑️ Eliminar
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- PAGINACIÓN -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <ul class="pagination-modern">
            @for (int i = 1; i <= (int)ViewBag.TotalPaginas; i++)
            {
                <li class="page-item-modern @(i == (int)ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link-modern"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-buscar="@Context.Request.Query["buscar"]"
                       asp-route-estado="@Context.Request.Query["estado"]"
                       asp-route-zona="@Context.Request.Query["zona"]"
                       asp-route-empresa="@Context.Request.Query["empresa"]">
                        @i
                    </a>
                </li>
            }
        </ul>
    }

</div>
