@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/Home/Home.css" />



<div class="hero-section">
    <div class="hero-card">
        <!-- Logo centrado -->
        <div class="logo-container">
            <img src="~/images/LogoDavid.png" alt="El David" class="logo-img" />
        </div>

        <!-- Título -->
        <h1 class="hero-title">
            El David
        </h1>

        <p class="hero-subtitle">
            Sistema de administracion y pedidos
        </p>

        <!-- Módulos en grid -->
        <div class="modules-grid">

            <!-- Clientes -->
            <a asp-controller="Clientes" asp-action="Index" class="module-card">
                <div class="module-icon">👥</div>
                <div class="module-content">
                    <div class="module-title">Clientes</div>
                    <div class="module-desc">Administración de cartera de clientes</div>
                </div>
            </a>

            <!-- Proveedores -->
            <a asp-controller="ProveedorCatalogo" asp-action="Index" class="module-card">
                <div class="module-icon">🏭</div>
                <div class="module-content">
                    <div class="module-title">Proveedores</div>
                    <div class="module-desc">Gestión de tus proveedores</div>
                </div>
            </a>

            <!-- Inventario -->
            <a asp-controller="Inventarios" asp-action="Index" class="module-card">
                <div class="module-icon">📦</div>
                <div class="module-content">
                    <div class="module-title">Inventario</div>
                    <div class="module-desc">Gestión de inventarios</div>
                </div>
            </a>

            <!-- Movimientos de Inventario -->
            <a asp-controller="MovimientosInventario" asp-action="Index" class="module-card">
                <div class="module-icon">🔄</div>
                <div class="module-content">
                    <div class="module-title">Movimientos</div>
                    <div class="module-desc">Entradas y salidas de inventario</div>
                </div>
            </a>

            <!-- Pedidos Clientes -->
            <a asp-controller="PedidoCliente" asp-action="Index" class="module-card">
                <div class="module-icon">🛒</div>
                <div class="module-content">
                    <div class="module-title">Pedidos Clientes</div>
                    <div class="module-desc">Control de pedidos de clientes</div>
                </div>
            </a>

            <!-- Pedidos Proveedores -->
            <a asp-controller="PedidoProveedor" asp-action="Index" class="module-card">
                <div class="module-icon">🚛</div>
                <div class="module-content">
                    <div class="module-title">Pedidos Proveedores</div>
                    <div class="module-desc">Órdenes a proveedores</div>
                </div>
            </a>
     
            <!-- Proformas -->
            <a asp-controller="Proformas" asp-action="Index" class="module-card">
                <div class="module-icon">📄</div>
                <div class="module-content">
                    <div class="module-title">Proformas</div>
                    <div class="module-desc">Cotizaciones y presupuestos</div>
                </div>
            </a>

            <!-- Empresas -->
            <a asp-controller="Empresas" asp-action="Index" class="module-card">
                <div class="module-icon">🏢</div>
                <div class="module-content">
                    <div class="module-title">Empresas</div>
                    <div class="module-desc">Gestión de empresas asociadas</div>
                </div>
            </a>

            <!-- Provedores
            <a asp-controller="ProveedorCatalogo" asp-action="Index" class="module-card">
                <div class="module-icon">🏢</div>
                <div class="module-content">
                    <div class="module-title">Proveedores 2.0</div>
                    <div class="module-desc">Reparacion de proveedores</div>
                </div>
            </a>-->

            <!-- Usuarios -->
            <a asp-controller="Account" asp-action="Usuarios" class="module-card">
                <div class="module-icon">👤</div>
                <div class="module-content">
                    <div class="module-title">Usuarios</div>
                    <div class="module-desc">Modulo de usuarios</div>
                </div>
            </a>

        </div>
        

        <!-- Stats rápidos (opcional)
        <div class="stats-section">
            <div class="stat-item">
                <div class="stat-number">150+</div>
                <div class="stat-label">Productos</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">45</div>
                <div class="stat-label">Clientes</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">12</div>
                <div class="stat-label">Proveedores</div>
            </div>
        </div>
        -->
    </div>
</div>