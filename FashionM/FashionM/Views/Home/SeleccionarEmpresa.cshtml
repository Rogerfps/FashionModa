@{
    ViewData["Title"] = "Seleccionar Empresa";
}

<style>
    :root {
        --deep-blue: #0B2447;
        --ocean-blue: #19376D;
        --electric-blue: #576CBC;
        --light-bg: #F5F9FF;
        --pure-white: #FFFFFF;
        --text-gray: #64748b;
        --border-light: #e2e8f0;
        --shadow-lg: 0 25px 50px -12px rgba(0,0,0,0.15);
        --shadow-hover: 0 30px 60px -15px rgba(11, 36, 71, 0.25);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--light-bg);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .selection-container {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    /* Header */
    .selection-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

        .selection-header .icon-large {
            font-size: 3.5rem;
            display: block;
            margin-bottom: 0.5rem;
            animation: float 3s ease-in-out infinite;
        }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .selection-title {
        font-size: 2.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--deep-blue) 0%, var(--electric-blue) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .selection-subtitle {
        color: var(--text-gray);
        font-size: 1.1rem;
        margin-top: 0.5rem;
        font-weight: 400;
    }

        .selection-subtitle span {
            background: #e6f0fa;
            padding: 0.2rem 1rem;
            border-radius: 30px;
            color: var(--deep-blue);
            font-weight: 500;
        }

    /* Grid */
    .empresa-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
    }

    .empresa-card {
        position: relative;
        background: var(--pure-white);
        border-radius: 24px;
        padding: 2rem 1.2rem 1.5rem;
        text-align: center;
        text-decoration: none;
        color: inherit;
        border: 2px solid transparent;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 260px;
        overflow: hidden;
        cursor: pointer;
    }

        .empresa-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, var(--deep-blue), var(--electric-blue));
            opacity: 0;
            transition: opacity 0.4s ease;
            border-radius: 22px;
        }

        .empresa-card:hover {
            transform: translateY(-12px) scale(1.02);
            border-color: var(--electric-blue);
            box-shadow: var(--shadow-hover);
        }

            .empresa-card:hover::before {
                opacity: 0.04;
            }

        .empresa-card .badge-id {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #f1f5f9;
            color: var(--text-gray);
            font-size: 0.6rem;
            font-weight: 600;
            padding: 0.2rem 0.6rem;
            border-radius: 30px;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            z-index: 1;
        }

        .empresa-card:hover .badge-id {
            background: var(--deep-blue);
            color: white;
        }

        .empresa-card .logo-wrapper {
            width: 100%;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.2rem;
            position: relative;
            z-index: 1;
        }

            .empresa-card .logo-wrapper .logo-placeholder {
                width: 80px;
                height: 80px;
                background: #f8fafc;
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2.5rem;
                border: 1px solid var(--border-light);
                transition: all 0.3s ease;
            }

        .empresa-card:hover .logo-placeholder {
            border-color: var(--electric-blue);
            background: #f0f4ff;
            transform: scale(1.05);
        }

        .empresa-card img {
            max-width: 100%;
            max-height: 80px;
            object-fit: contain;
            border-radius: 8px;
            transition: transform 0.3s ease;
        }

        .empresa-card:hover img {
            transform: scale(1.05);
        }

        .empresa-card .empresa-name {
            font-size: 1rem;
            font-weight: 600;
            color: var(--deep-blue);
            margin: 0.3rem 0 0.2rem;
            position: relative;
            z-index: 1;
            line-height: 1.3;
        }

        .empresa-card .empresa-tag {
            font-size: 0.7rem;
            color: var(--text-gray);
            position: relative;
            z-index: 1;
            font-weight: 400;
        }

        .empresa-card .select-indicator {
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%) scaleX(0);
            width: 40%;
            height: 3px;
            background: linear-gradient(135deg, var(--deep-blue), var(--electric-blue));
            border-radius: 30px;
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .empresa-card:hover .select-indicator {
            transform: translateX(-50%) scaleX(1);
        }

        /* Glass card variant */
        .empresa-card.glass {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

            .empresa-card.glass:hover {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(15px);
            }

    /* Responsive */
    @@media (max-width: 1024px) {
        .empresa-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 768px) {
        body {
            padding: 1.5rem;
        }

        .selection-title {
            font-size: 2rem;
        }

        .selection-subtitle {
            font-size: 0.95rem;
        }

        .empresa-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .empresa-card {
            padding: 1.5rem 1rem;
            min-height: 200px;
        }

            .empresa-card .logo-wrapper {
                height: 70px;
            }

            .empresa-card img {
                max-height: 55px;
            }

            .empresa-card .empresa-name {
                font-size: 0.85rem;
            }

            .empresa-card .badge-id {
                top: 8px;
                right: 8px;
                font-size: 0.5rem;
                padding: 0.1rem 0.5rem;
            }
    }

    @@media (max-width: 480px) {
        .empresa-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.8rem;
        }

        .empresa-card {
            padding: 1rem 0.8rem;
            min-height: 150px;
            border-radius: 16px;
        }

            .empresa-card .logo-wrapper {
                height: 50px;
                margin-bottom: 0.5rem;
            }

            .empresa-card img {
                max-height: 40px;
            }

            .empresa-card .empresa-name {
                font-size: 0.7rem;
            }

            .empresa-card .empresa-tag {
                font-size: 0.55rem;
            }

        .selection-title {
            font-size: 1.6rem;
        }

        .selection-header .icon-large {
            font-size: 2.5rem;
        }
    }

    /* Animación de entrada */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .empresa-card {
        animation: fadeUp 0.6s ease forwards;
        opacity: 0;
    }

        .empresa-card:nth-child(1) {
            animation-delay: 0.05s;
        }

        .empresa-card:nth-child(2) {
            animation-delay: 0.1s;
        }

        .empresa-card:nth-child(3) {
            animation-delay: 0.15s;
        }

        .empresa-card:nth-child(4) {
            animation-delay: 0.2s;
        }

        .empresa-card:nth-child(5) {
            animation-delay: 0.25s;
        }
</style>

<div class="selection-container">
    <!-- HEADER -->
    <div class="selection-header">
        <span class="icon-large">🏢</span>
        <h1 class="selection-title">Selecciona tu Empresa</h1>
        <p class="selection-subtitle">
            <span>🔍</span> ¿Con cuál empresa deseas trabajar hoy?
        </p>
    </div>

    <!-- GRID DE EMPRESAS -->
    <div class="empresa-grid">

        <!-- KYROZ -->
        <a asp-action="CambiarEmpresa" asp-route-id="1" asp-route-nombre="KYROZ" class="empresa-card">
            <span class="badge-id">ID 1</span>
            <div class="logo-wrapper">
                <img src="~/images/KYROZ.png" alt="KYROZ" />
            </div>
            <h5 class="empresa-name">KYROZ</h5>
            <span class="empresa-tag">⚡ Activa</span>
            <span class="select-indicator"></span>
        </a>

        <!-- Cocalza Plus S.A -->
        <a asp-action="CambiarEmpresa" asp-route-id="2" asp-route-nombre="Cocalza Plus S.A" class="empresa-card">
            <span class="badge-id">ID 2</span>
            <div class="logo-wrapper">
                <img src="~/images/Cocalza.png" alt="Cocalza Plus S.A" />
            </div>
            <h5 class="empresa-name">COCALZA PLUS S.A</h5>
            <span class="empresa-tag">⭐ Destacada</span>
            <span class="select-indicator"></span>
        </a>

        <!-- Fashion Shoes S.A -->
        <a asp-action="CambiarEmpresa" asp-route-id="3" asp-route-nombre="Fashion Shoes S.A" class="empresa-card">
            <span class="badge-id">ID 3</span>
            <div class="logo-wrapper">
                <img src="~/images/Fashion.png" alt="Fashion Shoes S.A" />
            </div>
            <h5 class="empresa-name">FASHION SHOES S.A</h5>
            <span class="empresa-tag">👟 Zapatos</span>
            <span class="select-indicator"></span>
        </a>

        <!-- LSG Moda S.A -->
        <a asp-action="CambiarEmpresa" asp-route-id="4" asp-route-nombre="LSG Moda S.A" class="empresa-card">
            <span class="badge-id">ID 4</span>
            <div class="logo-wrapper">
                <img src="~/images/lsg.jpg" alt="LSG Moda S.A" />
            </div>
            <h5 class="empresa-name">LSG Moda S.A</h5>
            <span class="empresa-tag">✨ Moda</span>
            <span class="select-indicator"></span>
        </a>

        <!-- Maxi Plus 23 S.A -->
        <a asp-action="CambiarEmpresa" asp-route-id="5" asp-route-nombre="Maxi Plus 23 S.A" class="empresa-card">
            <span class="badge-id">ID 5</span>
            <div class="logo-wrapper">
                <img src="~/images/Maxiplus.jpeg" alt="Maxi Plus 23 S.A" />
            </div>
            <h5 class="empresa-name">MAXI PLUS 23 S.A</h5>
            <span class="empresa-tag">📦 Mayorista</span>
            <span class="select-indicator"></span>
        </a>

    </div>
</div>
