@using FashionM.Enums
@model IEnumerable<PedidoCliente>

@{
    ViewData["Title"] = "Pedidos de Clientes";
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int paginaActual = ViewBag.PaginaActual ?? 1;
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoIndex.css" />

<!-- HEADER -->
<div class="page-header">
    <h1 class="page-title">
        📋 Pedidos de Clientes
    </h1>
</div>

<!-- FILTROS -->
<div class="filters-container">
    <form method="get" class="row g-3">

        <!-- BUSCAR -->
        <div class="col-md-4">
            <div class="filter-label">Buscar</div>
            <input type="text"
                   id="buscarInput"
                   name="buscar"
                   value="@Context.Request.Query["buscar"]"
                   class="filter-input"
                   placeholder="Nombre, cédula o ID..." />
        </div>

        <!-- EMPRESA -->
        <div class="col-md-3">
            <div class="filter-label">Empresa</div>

            <select id="empresaInput" name="empresa" class="filter-input">

                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Empresa) ? "selected" : null)">
                    Todas
                </option>

                @if (ViewBag.Empresas != null)
                {
                    foreach (var e in (List<string>)ViewBag.Empresas)
                    {
                        <option value="@e" selected="@(ViewBag.Empresa == e ? "selected" : null)">
                            @e
                        </option>
                    }
                }

            </select>
        </div>

        <!-- SEMANA -->
        <div class="col-md-2">
            <div class="filter-label">Semana</div>
            <input type="number"
                   id="semanaInput"
                   name="semana"
                   class="filter-input"
                   min="1"
                   max="53"
                   value="@Context.Request.Query["semana"]"
                   placeholder="Ej: 32" />
        </div>

        <!-- LIMPIAR -->
        <div class="col-md-3 d-flex align-items-end">
            <a asp-action="Index" class="btn-clear w-100">
                ✖ Limpiar filtros
            </a>
        </div>

        <!-- CREAR -->
        <div class="col-12 mt-2">
            <a asp-action="Create" class="btn-create">
                ➕ Crear Nuevo Pedido
            </a>
        </div>

    </form>
</div>

<!-- TABLA -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Semana</th>
                    <th>Cliente</th>
                    <th>Transporte</th>
                    <th>Total</th>
                    <th>Secretaría</th>
                    <th>Crédito</th>
                    <th>Bodega</th>
                    <th>Entrega</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10">
                            <div class="empty-state">
                                <div class="empty-icon">📭</div>
                                <div class="empty-text">No hay pedidos registrados</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FechaPedido.ToString("dd/MM/yyyy")</td>
                            <td>@item.Semana</td>

                            <td>
                                <strong>@item.Cliente.Nombre @item.Cliente.Apellidos</strong><br />
                                <small>@item.Cliente.Cedula</small>
                            </td>

                            <td>@item.Cliente.Transporte</td>

                            <td class="total-monto">₡ @item.Total.ToString("N2")</td>

                            <!-- SECRETARIA -->
                            <td>
                                <span class="status-badge @(item.AprobadoSecretaria ? "success" : "secondary")">
                                    @(item.AprobadoSecretaria ? "Aprobado" : "Pendiente")
                                </span>
                            </td>

                            <!-- CRÉDITO -->
                            <td>
                                @switch (item.EstadoCredito)
                                {
                                    case EstadoCredito.Aprobado:
                                        <span class="status-badge success">Aprobado</span>
                                        break;
                                    case EstadoCredito.Rechazado:
                                        <span class="status-badge danger">Rechazado</span>
                                        break;
                                    case EstadoCredito.Retenido:
                                        <span class="status-badge warning">Retenido</span>
                                        break;
                                    default:
                                        <span class="status-badge secondary">Pendiente</span>
                                        break;
                                }
                            </td>

                            <!-- BODEGA -->
                            <td>
                                <span class="status-badge @(item.FirmaBodega ? "success" : "secondary")">
                                    @(item.FirmaBodega ? "Despachado" : "Pendiente")
                                </span>
                            </td>

                            <!-- ENTREGA -->
                            <td>
                                <span class="status-badge @(item.EstadoEntrega ? "success" : "secondary")">
                                    @(item.FirmaBodega ? "Entregar" : "PorEntregar")
                                </span>
                            </td>

                            <!-- ACCIONES -->
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view">👁</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit">✏️</a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn-action btn-delete"
                                   onclick="return confirm('¿Eliminar este pedido?')">🗑</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINACIÓN -->
@if (totalPaginas > 1)
{
    <ul class="pagination-modern">
        @for (int i = 1; i <= totalPaginas; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                       page = i,
                       buscar = Context.Request.Query["buscar"],
                       empresa = Context.Request.Query["empresa"],
                       semana = Context.Request.Query["semana"]
                   })">
                    @i
                </a>
            </li>
        }
    </ul>
}

<!-- SCRIPT FILTROS AUTOMÁTICOS -->
<script>
    let timeout = null;

    function aplicarFiltros() {

        clearTimeout(timeout);

        timeout = setTimeout(() => {

            document.querySelector("form").submit();

        }, 2000); // 2 segundos

    }

    document.getElementById("buscarInput")
        .addEventListener("input", aplicarFiltros);

    document.getElementById("empresaInput")
        .addEventListener("change", aplicarFiltros);

    document.getElementById("semanaInput")
        .addEventListener("input", aplicarFiltros);

</script>