@using FashionM.Enums
@model IEnumerable<PedidoCliente>

@{
    ViewData["Title"] = "Pedidos de Clientes";
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int paginaActual = ViewBag.PaginaActual ?? 1;
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoIndex.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📋</span> Pedidos de Clientes
    </h1>
</div>

<!-- Filtros -->
<div class="filters-container">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <div class="filter-label">Buscar</div>
            <input type="text"
                   name="buscar"
                   value="@Context.Request.Query["buscar"]"
                   class="filter-input"
                   placeholder="Nombre, cédula..." />
        </div>

        <div class="col-md-2">
            <div class="filter-label">Empresa</div>
            <select name="empresa" class="filter-input">
                <option value="">Todas</option>
                @if (ViewBag.Empresas != null)
                {
                    foreach (var e in ViewBag.Empresas as List<string>)
                    {
                        <option value="@e" selected="@(Context.Request.Query["empresa"] == e)">
                            @e
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <div class="filter-label">Semana</div>
            <input type="number"
                   name="semana"
                   class="filter-input"
                   min="1"
                   max="53"
                   value="@Context.Request.Query["semana"]"
                   placeholder="Ej: 32" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn-filter w-100">
                <span>🔍</span> Filtrar
            </button>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <a asp-action="Index" class="btn-clear w-100">
                <span>✖</span> Limpiar
            </a>
        </div>

        <div class="col-12 mt-3">
            <a asp-action="Create" class="btn-create">
                <span>➕</span> Crear Nuevo Pedido
            </a>
        </div>
    </form>
</div>

<!-- Tabla -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Semana</th>
                    <th>Cliente</th>
                    <th>Transporte</th>
                    <th>Total</th>
                    <th>Secretaría</th>
                    <th>Crédito</th>
                    <th>Bodega</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10">
                            <div class="empty-state">
                                <div class="empty-icon">📭</div>
                                <div class="empty-text">No hay pedidos registrados</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Id</td>
                            <td>@item.FechaPedido.ToString("dd/MM/yyyy")</td>
                            <td>@item.Semana</td>
                            <td>
                                <div class="cliente-info">
                                    <span class="cliente-nombre">@item.Cliente.Nombre @item.Cliente.Apellidos</span>
                                    <span class="cliente-cedula">@item.Cliente.Cedula</span>
                                </div>
                            </td>
                            <td>@item.Cliente.Transporte</td>
                            <td class="total-monto">₡ @item.Total.ToString("N2")</td>

                            <!-- SECRETARIA -->
                            <td>
                                <span class="status-badge @(item.AprobadoSecretaria ? "success" : "secondary")">
                                    @(item.AprobadoSecretaria ? "Aprobado" : "Pendiente")
                                </span>
                            </td>

                            <!-- CRÉDITO -->
                            <td>
                                @switch (item.EstadoCredito)
                                {
                                    case EstadoCredito.Aprobado:
                                        <span class="status-badge success">Aprobado</span>
                                        break;
                                    case EstadoCredito.Rechazado:
                                        <span class="status-badge danger">Rechazado</span>
                                        break;
                                    case EstadoCredito.Retenido:
                                        <span class="status-badge warning">Retenido</span>
                                        break;
                                    default:
                                        <span class="status-badge secondary">Pendiente</span>
                                        break;
                                }
                            </td>

                            <!-- BODEGA -->
                            <td>
                                <span class="status-badge @(item.FirmaBodega ? "success" : "secondary")">
                                    @(item.FirmaBodega ? "Despachado" : "Pendiente")
                                </span>
                            </td>

                            <!-- ACCIONES -->
                            <td>
                                <div class="action-group">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-action btn-view">
                                        👁 Ver
                                    </a>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-action btn-edit">
                                        ✏️ Editar
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn-action btn-delete"
                                       onclick="return confirm('¿Eliminar este pedido?')">
                                        🗑 Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Paginación -->
@if (totalPaginas > 1)
{
    <ul class="pagination-modern">
        @for (int i = 1; i <= totalPaginas; i++)
        {
            <li class="page-item @(i == paginaActual ? "active" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                       page = i,
                       buscar = Context.Request.Query["buscar"],
                       empresa = Context.Request.Query["empresa"],
                       semana = Context.Request.Query["semana"]
                   })">
                    @i
                </a>
            </li>
        }
    </ul>
}