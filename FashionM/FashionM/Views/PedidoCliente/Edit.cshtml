@using System.Globalization
@using FashionM.Enums
@model PedidoCliente

@{
    ViewData["Title"] = "Editar Pedido";
    var detalles = Model.Detalles?.ToList() ?? new List<PedidoClienteDetalle>();
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoEdit.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>✏️</span> Editar Pedido #@Model.Id
    </h1>
    <a asp-action="Index" class="back-link">
        <span>←</span> Volver
    </a>
</div>

<!-- Formulario -->
<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ClienteCedula" />

        <!-- Cliente -->
        <fieldset>
            <legend>👤 Cliente</legend>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input class="form-control"
                           value="@Model.Cliente.Nombre @Model.Cliente.Apellidos"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Cédula</label>
                    <input class="form-control"
                           value="@Model.Cliente.Cedula"
                           readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Transporte</label>
                    <input class="form-control"
                           value="@Model.Cliente.Transporte"
                           readonly />
                </div>
            </div>
        </fieldset>

        <!-- Datos del Pedido -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Empresa" class="form-label"></label>
                <input asp-for="Empresa" class="form-control" placeholder="Empresa" />
                <span asp-validation-for="Empresa" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Semana" class="form-label"></label>
                <input asp-for="Semana"
                       type="number"
                       min="1"
                       max="53"
                       class="form-control"
                       placeholder="Ej: 32" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Fecha Pedido</label>
                <input class="form-control"
                       value="@Model.FechaPedido.ToString("dd/MM/yyyy")"
                       readonly />
            </div>
        </div>

        <!-- Detalle del Pedido -->
        <fieldset>
            <legend>🛒 Detalle del Pedido</legend>

            <div class="table-wrapper">
                <table class="detalle-table" id="tablaDetalles">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Código</th>
                            <th>Color</th>
                            <th>Talla</th>
                            <th>Cantidad</th>
                            <th>Detalle</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < detalles.Count; i++)
                        {
                            <tr>
                                <!-- IMPORTANTE PARA BINDING -->
                                <input type="hidden" name="Detalles.Index" value="@i" />

                                <td class="texto-fijo">
                                    @detalles[i].Proveedor?.Nombre
                                </td>

                                <td>
                                    @detalles[i].CodigoProducto

                                    <input type="hidden" name="Detalles[@i].Id"
                                           value="@detalles[i].Id" />

                                    <input type="hidden" name="Detalles[@i].PedidoClienteId"
                                           value="@Model.Id" />

                                    <input type="hidden" name="Detalles[@i].ProveedorCedula"
                                           value="@detalles[i].ProveedorCedula" />

                                    <input type="hidden" name="Detalles[@i].CodigoProducto"
                                           value="@detalles[i].CodigoProducto" />
                                </td>

                                <td>
                                    @detalles[i].Color

                                    <input type="hidden" name="Detalles[@i].Color"
                                           value="@detalles[i].Color" />
                                </td>

                                <td>
                                    @detalles[i].Talla

                                    <input type="hidden" name="Detalles[@i].Talla"
                                           value="@detalles[i].Talla" />
                                </td>

                                <td>
                                    <input type="number"
                                           class="form-control cantidad"
                                           name="Detalles[@i].Cantidad"
                                           value="@detalles[i].Cantidad"
                                           min="1"
                                           onchange="recalcular()" />
                                </td>

                                <td>
                                    <input class="form-control"
                                           name="Detalles[@i].Detalle"
                                           value="@detalles[i].Detalle"
                                           placeholder="Detalle" />
                                </td>

                                <td>
                                    <input type="number"
                                           step="0.01"
                                           class="form-control precio"
                                           name="Detalles[@i].PrecioUnitario"
                                           value="@detalles[i].PrecioUnitario.ToString("0.##")"
                                           onchange="recalcular()" />
                                </td>

                                <td class="subtotal-cell subtotal">
                                    @((detalles[i].Cantidad * detalles[i].PrecioUnitario).ToString("0.00", CultureInfo.InvariantCulture))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </fieldset>

        <!-- Observaciones -->
        <div class="mt-4">
            <label asp-for="Observaciones" class="form-label"></label>
            <textarea asp-for="Observaciones"
                      class="form-control"
                      rows="3"
                      placeholder="Notas adicionales sobre el pedido..."></textarea>
        </div>

        <!-- Total -->
        <div class="total-box">
            <div class="total-label">Total del Pedido</div>
            <div class="total-value" id="totalPedido">
                ₡ @Model.Total.ToString("N2", CultureInfo.InvariantCulture)
            </div>
        </div>

        <!-- Botones -->
        <div class="action-buttons">
            <button type="submit" class="btn-save">
                💾 Guardar Cambios
            </button>
            <a asp-action="Index" class="btn-cancel">
                ← Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function recalcular() {
            let total = 0;

            document.querySelectorAll("#tablaDetalles tbody tr").forEach(row => {
                const cantidad = parseFloat(row.querySelector(".cantidad")?.value || 0);
                const precio = parseFloat(row.querySelector(".precio")?.value || 0);

                const subtotal = cantidad * precio;

                row.querySelector(".subtotal").innerText = subtotal.toFixed(2);
                total += subtotal;
            });

            document.getElementById("totalPedido").innerText = "₡ " + total.toFixed(2);
        }
    </script>
}