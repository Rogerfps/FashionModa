@model PedidoCliente

@{
    ViewData["Title"] = "Editar Pedido";
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoCreate.css" />

<div class="page-header">
    <h1 class="page-title">✏️ Editar Pedido #@Model.Id</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="back-link">← Volver</a>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post" onsubmit="generarDetalles()">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <!-- EMPRESA -->
        <div class="mt-3">
            <label class="fw-bold">Empresa</label>
            <div class="d-flex flex-wrap gap-3">
                @{
                    var empresas = new[] {
                "Cocalza Plus S.A",
                "Fashion Shoes S.A",
                "LSG Moda S.A",
                "Maxi Plus 23 S.A"
            };
                }

                @foreach (var e in empresas)
                {
                    <label class="form-check">
                        <input type="radio" name="Empresa" value="@e"
                               class="form-check-input"
                        @(Model.Empresa == e ? "checked" : "") />
                        <span class="form-check-label">@e</span>
                    </label>
                }
            </div>
        </div>

        <!-- SEMANA -->
        <div class="mt-3">
            <label>Semana</label>
            <input asp-for="Semana" class="form-control" />
        </div>

        <h4 class="mt-4">🛒 Detalle del Pedido</h4>

        <table class="table">
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th>Código</th>
                    <th>Color</th>
                    <th>Detalle</th>
                    <th>Tallas</th>
                    <th></th>
                </tr>
            </thead>

            <tbody id="tablaDetalle">

                @{
                    var grupos = Model.Detalles
                        .GroupBy(d => new
                        {
                            d.ProveedorCatalogoId,
                            d.CodigoProducto,
                            d.Color,
                            d.Detalle
                        }).ToList();

                    int i = 0;
                }

                @foreach (var g in grupos)
                {
                    var p = g.First();

                    <tr>
                        <td>
                            <select class="form-control"
                                    id="prov_@i"
                                    data-selected="@p.ProveedorCatalogoId"
                                    onchange="cargarCodigos(this, @i)">
                            </select>
                        </td>

                        <td>
                            <select class="form-control"
                                    id="codigo_@i"
                                    data-selected="@p.CodigoProducto"
                                    onchange="cargarInfoZapato(this, @i)">
                            </select>
                        </td>

                        <td>
                            <select class="form-control" id="color_@i"
                                    data-selected="@p.Color"></select>
                        </td>

                        <td>
                            <select class="form-control" id="detalle_@i"
                                    data-selected="@p.Detalle"></select>
                        </td>

                        <td>
                            <div id="tallas_@i"
                                 data-tallas='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                              g.Select(x => new { x.Talla, x.Cantidad })
                                          ))'>
                            </div>
                        </td>

                        <td>
                            <button type="button" class="btn btn-danger"
                                    onclick="eliminarFila(this, @i)">
                                ✕
                            </button>
                        </td>
                    </tr>

                    i++;
                }

            </tbody>
        </table>

        <button type="button" onclick="agregarFila()" class="btn btn-primary">
            ➕ Agregar Producto
        </button>

        <div class="mt-4">
            <label>Observaciones</label>
            <textarea asp-for="Observaciones" class="form-control"></textarea>
        </div>

        <div id="detallesHidden"></div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">💾 Guardar</button>
        </div>

    </form>
</div>

@section Scripts {
    <script>

        let filaIndex = document.querySelectorAll("#tablaDetalle tr").length;
        let proveedoresCache = [];

        // =========================
        // PROVEEDORES
        // =========================
        async function cargarProveedores() {

            if (proveedoresCache.length > 0)
                return proveedoresCache;

            const r = await fetch("/PedidoCliente/ObtenerProveedores");
            proveedoresCache = await r.json();

            return proveedoresCache;
        }

        // =========================
        // AGREGAR FILA
        // =========================
        async function agregarFila() {

            const proveedores = await cargarProveedores();

            let options = `<option value="">Seleccione</option>`;

            proveedores.forEach(p => {
                options += `<option value="${p.id}">${p.nombre}</option>`;
            });

            const row = `
            <tr>
                <td>
                    <select class="form-control"
                            id="prov_${filaIndex}"
                            onchange="cargarCodigos(this, ${filaIndex})">
                        ${options}
                    </select>
                </td>

                <td>
                    <select class="form-control"
                            id="codigo_${filaIndex}"
                            onchange="cargarInfoZapato(this, ${filaIndex})">
                        <option value="">Seleccione</option>
                    </select>
                </td>

                <td><select class="form-control" id="color_${filaIndex}"></select></td>
                <td><select class="form-control" id="detalle_${filaIndex}"></select></td>

                <td><div id="tallas_${filaIndex}"></div></td>

                <td>
                    <button type="button" class="btn btn-danger"
                            onclick="eliminarFila(this, ${filaIndex})">✕</button>
                </td>
            </tr>`;

            document.getElementById("tablaDetalle")
                .insertAdjacentHTML("beforeend", row);

            filaIndex++;
        }

        // =========================
        // CODIGOS
        // =========================
        async function cargarCodigos(select, i) {

            const proveedorId = select.value;

            const r = await fetch(`/PedidoCliente/ObtenerCodigosPorProveedor?proveedorId=${proveedorId}`);
            const data = await r.json();

            let combo = document.getElementById(`codigo_${i}`);
            let selected = combo.dataset?.selected;

            combo.innerHTML = `<option value="">Seleccione</option>`;

            data.forEach(c => {
                combo.innerHTML += `<option value="${c}">${c}</option>`;
            });

            if (selected) combo.value = selected;
        }

        // =========================
        // INFO ZAPATO
        // =========================
        async function cargarInfoZapato(select, i) {

            const codigo = select.value;
            const proveedorId = document.getElementById(`prov_${i}`).value;

            const r = await fetch(`/PedidoCliente/ObtenerInfoZapato?codigo=${codigo}&proveedorId=${proveedorId}`);
            const data = await r.json();

            if (!data) return;

            let color = document.getElementById(`color_${i}`);
            let detalle = document.getElementById(`detalle_${i}`);
            let cont = document.getElementById(`tallas_${i}`);

            let tallasData = [];

            if (cont.dataset.tallas) {
                try {
                    tallasData = JSON.parse(cont.dataset.tallas);
                } catch {
                    tallasData = [];
                }
            }

            // COLOR
            color.innerHTML = data.colores.map(c => `<option>${c}</option>`).join("");
            if (color.dataset.selected) color.value = color.dataset.selected;

            // DETALLE
            detalle.innerHTML = data.detalles.map(d => `<option>${d}</option>`).join("");
            if (detalle.dataset.selected) detalle.value = detalle.dataset.selected;

            // TALLAS
            cont.innerHTML = "";

            data.tallas.forEach(t => {

                let match = tallasData.find(x => x.Talla == t.numero);
                let cantidad = match ? match.Cantidad : 0;

                cont.innerHTML += `
                <div class="d-flex mb-1 align-items-center">
                    <span style="width:40px">${t.numero}</span>
                    <input type="number"
                           value="${cantidad}"
                           min="0"
                           class="form-control form-control-sm"
                           data-talla="${t.numero}"
                           data-precio="${t.precio}"
                           onchange="generarDetalles()" />
                </div>`;
            });

            cont.dataset.tallas = JSON.stringify(tallasData);

            generarDetalles();
        }

        // =========================
        // GENERAR DETALLES
        // =========================
        function generarDetalles() {

            const contenedor = document.getElementById("detallesHidden");
            contenedor.innerHTML = "";

            let index = 0;

            for (let fila = 0; fila < filaIndex; fila++) {

                if (!document.getElementById(`prov_${fila}`)) continue;

                const cont = document.getElementById(`tallas_${fila}`);
                if (!cont) continue;

                const inputs = cont.querySelectorAll("input");

                inputs.forEach(input => {

                    let cantidad = parseInt(input.value || 0);

                    if (cantidad > 0) {

                        const html = `
                        <input type="hidden" name="Detalles[${index}].ProveedorCatalogoId" value="${document.getElementById(`prov_${fila}`).value}" />
                        <input type="hidden" name="Detalles[${index}].CodigoProducto" value="${document.getElementById(`codigo_${fila}`).value}" />
                        <input type="hidden" name="Detalles[${index}].Color" value="${document.getElementById(`color_${fila}`).value}" />
                        <input type="hidden" name="Detalles[${index}].Detalle" value="${document.getElementById(`detalle_${fila}`).value}" />
                        <input type="hidden" name="Detalles[${index}].Talla" value="${input.dataset.talla}" />
                        <input type="hidden" name="Detalles[${index}].Cantidad" value="${cantidad}" />
                        <input type="hidden" name="Detalles[${index}].PrecioUnitario" value="${input.dataset.precio}" />
                        `;

                        contenedor.insertAdjacentHTML("beforeend", html);
                        index++;
                    }
                });
            }
        }

        // =========================
        // INIT
        // =========================
        window.onload = async () => {

            const proveedores = await cargarProveedores();

            for (let i = 0; i < filaIndex; i++) {

                let prov = document.getElementById(`prov_${i}`);
                let selected = prov.dataset.selected;

                prov.innerHTML = proveedores.map(p =>
                    `<option value="${p.id}">${p.nombre}</option>`
                ).join("");

                prov.value = selected;

                await cargarCodigos(prov, i);

                let codigo = document.getElementById(`codigo_${i}`);
                if (codigo.value) {
                    await cargarInfoZapato(codigo, i);
                }
            }
        };

    </script>
}