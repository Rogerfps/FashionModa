@model PedidoCliente

@{
    ViewData["Title"] = "Nuevo Pedido";
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoCreate.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📦</span> Nuevo Pedido
    </h1>
    <a asp-action="Index" class="back-link">
        <span>←</span> Volver
    </a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- CLIENTE -->
        <fieldset>
            <legend>👤 Cliente</legend>

            <div class="row">
                <div class="col-md-6 position-relative">
                    <label class="form-label">Buscar Cliente (solo cédula)</label>

                    <input type="text"
                           id="clienteBuscar"
                           class="form-control"
                           placeholder="Digite la cédula..."
                           autocomplete="off" />

                    <input asp-for="ClienteCedula" type="hidden" id="clienteCedulaHidden" />

                    <div id="listaClientes" class="list-group"></div>
                </div>
            </div>

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input id="nombre" readonly class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dirección</label>
                    <input id="direccion" readonly class="form-control" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-3">
                    <label class="form-label">Transporte</label>
                    <input id="transporte" readonly class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Correo</label>
                    <input id="correo" readonly class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <input id="telefono" readonly class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Empresa (Cliente)</label>
                    <input id="empresaCliente" readonly class="form-control" />
                </div>
            </div>
        </fieldset>

        <!-- EMPRESA -->
        <div class="row">
            <div class="col-md-6">
                <label asp-for="Empresa" class="form-label">Empresa</label>

                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" asp-for="Empresa" value="Fashion Shoes S.A" />
                        <span>Fashion Shoes S.A</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio" asp-for="Empresa" value="LSG MODA S.A" />
                        <span>LSG MODA S.A</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio" asp-for="Empresa" value="Cocalza Plus S.A" />
                        <span>Cocalza Plus S.A</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio" asp-for="Empresa" value="Maxi Plus 23" />
                        <span>Maxi Plus 23</span>
                    </label>
                </div>

                <span asp-validation-for="Empresa" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Semana</label>
                <input asp-for="Semana" class="form-control" />
            </div>
        </div>

        <!-- DETALLE -->
        <div class="section-title">
            <span>🛒</span> Detalle del Pedido
        </div>

        <div class="table-wrapper">
            <table class="productos-table" id="tablaDetalle">
                <thead>
                    <tr>
                        <th>Proveedor (Cédula)</th>
                        <th>Código</th>
                        <th>Color</th>
                        <th>Talla</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Detalle</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <button type="button" onclick="agregarFila()" class="btn-add-row">
            ➕ Agregar Producto
        </button>

        <!-- OBSERVACIONES -->
        <div class="mt-4">
            <label class="form-label">Observaciones</label>
            <textarea asp-for="Observaciones" class="form-control"></textarea>
        </div>

        <!-- BOTONES -->
        <div class="action-buttons">
            <button type="submit" class="btn-save">💾 Guardar Pedido</button>
            <a asp-action="Index" class="btn-cancel">← Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let index = 0;
        let proveedoresCache = [];

        // =========================
        // 🔥 CLIENTE (CEDULA + NOMBRE)
        // =========================
        let timeoutCliente = null;

        const inputCliente = document.getElementById("clienteBuscar");
        const listaClientes = document.getElementById("listaClientes");
        const hiddenCliente = document.getElementById("clienteCedulaHidden");

        inputCliente.addEventListener("keyup", function () {
            clearTimeout(timeoutCliente);

            let term = this.value.trim();

            timeoutCliente = setTimeout(() => {

                if (term.length < 1) {
                    listaClientes.innerHTML = "";
                    return;
                }

                fetch(`/PedidoCliente/BuscarClientes?term=${encodeURIComponent(term)}`)
                    .then(r => r.json())
                    .then(data => {

                        listaClientes.innerHTML = "";

                        data.forEach(c => {
                            let item = document.createElement("a");
                            item.className = "list-group-item list-group-item-action";

                            // 🔥 MOSTRAR CEDULA + NOMBRE
                            item.innerHTML = `<strong>${c.cedula}</strong> - ${c.nombre}`;

                            item.onclick = () => {

                                // visible
                                inputCliente.value = `${c.cedula} - ${c.nombre}`;

                                // real
                                hiddenCliente.value = c.cedula;

                                // datos
                                document.getElementById("nombre").value = c.nombre || "";
                                document.getElementById("direccion").value = c.direccion || "";
                                document.getElementById("transporte").value = c.transporte || "";
                                document.getElementById("correo").value = c.correo || "";
                                document.getElementById("telefono").value = c.telefonos || "";
                                document.getElementById("empresaCliente").value = c.empresa || "";

                                // 🚫 NO tocar Empresa del pedido

                                listaClientes.innerHTML = "";
                            };

                            listaClientes.appendChild(item);
                        });
                    })
                    .catch(err => console.error("Error buscando cliente:", err));

            }, 300);
        });

        // cerrar lista
        document.addEventListener("click", function (e) {
            if (!inputCliente.contains(e.target) && !listaClientes.contains(e.target)) {
                listaClientes.innerHTML = "";
            }
        });


        // =========================
        // PROVEEDORES (CACHE)
        // =========================
        async function cargarProveedores() {
            if (proveedoresCache.length > 0) return proveedoresCache;

            try {
                const r = await fetch("/PedidoCliente/ObtenerProveedores");
                proveedoresCache = await r.json();
                return proveedoresCache;
            } catch (err) {
                console.error("Error cargando proveedores:", err);
                return [];
            }
        }


        // =========================
        // AGREGAR FILA
        // =========================
        async function agregarFila() {

            const row = `
            <tr>
                <td>
                    <input type="number"
                           class="form-control"
                           placeholder="Cédula proveedor"
                           name="Detalles[${index}].ProveedorCedula"
                           onblur="validarProveedor(this, ${index})" />
                </td>

                <td>
                    <select class="form-control"
                            name="Detalles[${index}].CodigoProducto"
                            id="codigo_${index}"
                            onchange="cargarColores(this, ${index})">
                        <option value="">Seleccione</option>
                    </select>
                </td>

                <td>
                    <select class="form-control"
                            name="Detalles[${index}].Color"
                            id="color_${index}">
                        <option value="">Seleccione</option>
                    </select>
                </td>

                <td>
                    <input class="form-control"
                           name="Detalles[${index}].Talla"
                           placeholder="Ej: 38" />
                </td>

                <td>
                    <input type="number"
                           class="form-control"
                           name="Detalles[${index}].Cantidad"
                           value="1"
                           min="1" />
                </td>

                <td>
                    <input type="number"
                           step="0.01"
                           class="form-control"
                           name="Detalles[${index}].PrecioUnitario"
                           placeholder="0.00" />
                </td>

                <td>
                    <input type="text"
                           class="form-control"
                           name="Detalles[${index}].Detalle"
                           placeholder="Detalle" />
                </td>

                <td>
                    <button type="button"
                            class="btn-remove-row"
                            onclick="this.closest('tr').remove()">
                        ✕
                    </button>
                </td>
            </tr>`;

            document.querySelector("#tablaDetalle tbody")
                .insertAdjacentHTML("beforeend", row);

            index++;
        }


        // =========================
        // VALIDAR PROVEEDOR
        // =========================
        function validarProveedor(input, i) {

            const proveedorCedula = input.value.trim();

            const comboCodigo = document.getElementById(`codigo_${i}`);
            const comboColor = document.getElementById(`color_${i}`);

            comboCodigo.innerHTML = `<option value="">Seleccione</option>`;
            comboColor.innerHTML = `<option value="">Seleccione</option>`;

            if (!proveedorCedula) return;

            fetch(`/PedidoCliente/ObtenerCodigosPorProveedor?proveedorCedula=${proveedorCedula}`)
                .then(r => {
                    if (!r.ok) throw "Proveedor no encontrado";
                    return r.json();
                })
                .then(data => {

                    if (!data || data.length === 0) {
                        alert("Proveedor no existe o no tiene productos");
                        input.value = "";
                        return;
                    }

                    data.forEach(codigo => {
                        comboCodigo.innerHTML += `<option value="${codigo}">${codigo}</option>`;
                    });

                })
                .catch(err => {
                    console.error(err);
                    alert("Proveedor inválido");
                    input.value = "";
                });
        }


        // =========================
        // COLORES
        // =========================
        function cargarColores(select, i) {

            const codigo = select.value;

            if (!codigo) return;

            const proveedorCedula =
                document.querySelector(`input[name='Detalles[${i}].ProveedorCedula']`)?.value;

            if (!proveedorCedula) {
                alert("Primero ingrese la cédula del proveedor");
                return;
            }

            const comboColor = document.getElementById(`color_${i}`);
            comboColor.innerHTML = `<option value="">Seleccione</option>`;

            fetch(`/PedidoCliente/ObtenerColoresPorCodigo?codigo=${codigo}&proveedorCedula=${proveedorCedula}`)
                .then(r => r.json())
                .then(data => {

                    if (!data || data.length === 0) {
                        alert("No hay colores disponibles");
                        return;
                    }

                    data.forEach(color => {
                        comboColor.innerHTML += `<option value="${color}">${color}</option>`;
                    });

                })
                .catch(err => {
                    console.error("Error cargando colores:", err);
                    alert("Error al cargar colores");
                });
        }
    </script>
}