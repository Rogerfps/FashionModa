@model PedidoCliente

@{
    ViewData["Title"] = "Nuevo Pedido";
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoCreate.css" />

<div class="page-header">
    <h1 class="page-title">📦 Nuevo Pedido</h1>
    <a asp-action="Index" class="back-link">← Volver</a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" onsubmit="prepararDetalles()">
        @Html.AntiForgeryToken()

        <!-- CLIENTE -->
        <fieldset>
            <legend>👤 Cliente</legend>

            <input type="text" id="clienteBuscar" class="form-control" placeholder="Buscar cliente..." />
            <input asp-for="ClienteCedula" type="hidden" id="clienteCedulaHidden" />

            <div id="listaClientes" class="list-group"></div>
            <div asp-validation-summary="All" class="text-danger mt-2"></div>
        </fieldset>

        <!-- EMPRESA -->
        <div class="mt-3">
            <label>Empresa</label>

            <div>
                <label>
                    <input type="radio"
                           asp-for="Empresa"
                           value="Cocalza Plus S.A" />
                    Cocalza Plus S.A
                </label>

                <label>
                    <input type="radio"
                           asp-for="Empresa"
                           value="Fashion Shoes S.A" />
                    Fashion Shoes S.A
                </label>

                <label>
                    <input type="radio"
                           asp-for="Empresa"
                           value="LSG Moda S.A" />
                    LSG Moda S.A
                </label>

                <label>
                    <input type="radio"
                           asp-for="Empresa"
                           value="Maxi Plus 23 S.A" />
                    Maxi Plus 23 S.A
                </label>

                <label>
                    <input type="radio"
                           asp-for="Empresa"
                           value="KYROZ" />
                    KYROZ
                </label>
            </div>
        </div>

        <!-- VENDEDOR -->
        <div class="mt-3">
            <label asp-for="Vendedor">Vendedor</label>

            <select asp-for="Vendedor"
                    id="vendedorSelect"
                    class="form-control"
                    required>

                <option value="">
                    Seleccione un vendedor
                </option>

                @if (ViewBag.Vendedores != null)
                {
                    foreach (var vendedor in ViewBag.Vendedores)
                    {
                        <option value="@vendedor">
                            @vendedor
                        </option>
                    }
                }

            </select>

            <span asp-validation-for="Vendedor"
                  class="text-danger">
            </span>
        </div>

        <div class="mt-3">
            <label>Semana</label>
            <input asp-for="Semana" type="number" min="1" class="form-control" required />
        </div>

        <!-- DETALLE -->
        <h4 class="mt-4">🛒 Detalle del Pedido</h4>

        <table class="table">
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th>Código</th>
                    <th>Color</th>
                    <th>Detalle</th>
                    <th>Tallas</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tablaDetalle"></tbody>
        </table>

        <button type="button" onclick="agregarFila()" class="btn btn-primary">
            ➕ Agregar Producto
        </button>

        <!-- OBSERVACIONES -->
        <div class="mt-4">
            <label>Observaciones</label>
            <textarea asp-for="Observaciones" class="form-control"></textarea>
        </div>

        <div id="detallesHidden"></div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">💾 Guardar</button>
        </div>

    </form>
</div>

@section Scripts {

    <script>

        let filaIndex = 0;

        // =========================
        // CLIENTES
        // =========================
        document.getElementById("clienteBuscar").addEventListener("keyup", function () {

            let term = this.value;

            fetch(`/PedidoCliente/BuscarClientes?term=${term}`)
                .then(r => r.json())
                .then(data => {

                    let lista = document.getElementById("listaClientes");
                    lista.innerHTML = "";

                    data.forEach(c => {

                        let item = document.createElement("a");
                        item.className = "list-group-item list-group-item-action";
                        item.innerHTML = `${c.cedula} - ${c.nombre}`;

                        item.onclick = () => {
                            document.getElementById("clienteCedulaHidden").value = c.cedula;
                            document.getElementById("clienteBuscar").value = c.nombre;
                            lista.innerHTML = "";
                        };

                        lista.appendChild(item);
                    });
                });
        });

        // =========================
        // AGREGAR FILA
        // =========================
        function agregarFila() {

            const row = `
            <tr>

                <td>
                    <input type="text" id="provBuscar_${filaIndex}" class="form-control" placeholder="Buscar proveedor..." />
                    <input type="hidden" id="prov_${filaIndex}" />
                    <div id="listaProv_${filaIndex}" class="list-group"></div>
                </td>

                <td>
                    <input type="text" id="codigo_${filaIndex}" class="form-control" placeholder="Buscar código..." />
                    <div id="listaCodigos_${filaIndex}" class="list-group"></div>
                </td>

                <td><select class="form-control" id="color_${filaIndex}"></select></td>
                <td><select class="form-control" id="detalle_${filaIndex}"></select></td>
                <td><div id="tallas_${filaIndex}"></div></td>

                <td>
                    <button type="button" class="btn btn-danger"
                            onclick="this.closest('tr').remove()">✕</button>
                </td>

            </tr>`;

            document.getElementById("tablaDetalle")
                .insertAdjacentHTML("beforeend", row);

            activarBusquedaProveedor(filaIndex);

            filaIndex++;
        }

        // =========================
        // PROVEEDOR (FIX SEGURIDAD)
        // =========================
        function activarBusquedaProveedor(i) {

            const input = document.getElementById(`provBuscar_${i}`);
            const lista = document.getElementById(`listaProv_${i}`);

            input.onkeyup = null;

            input.addEventListener("keyup", function () {

                let term = this.value;

                fetch(`/PedidoCliente/BuscarProveedores?term=${term}`)
                    .then(r => r.json())
                    .then(data => {

                        lista.innerHTML = "";

                        data.forEach(p => {

                            let item = document.createElement("a");
                            item.className = "list-group-item list-group-item-action";

                            // 🔥 CLAVE: NO MOSTRAR NOMBRE SI NO VIENE
                            item.innerHTML = p.nombre
                                ? `${p.codigo} - ${p.nombre}`
                                : `${p.codigo}`;

                            item.onclick = () => {

                                input.value = p.nombre
                                    ? `${p.codigo} - ${p.nombre}`
                                    : `${p.codigo}`;

                                document.getElementById(`prov_${i}`).value = p.id;

                                lista.innerHTML = "";

                                document.getElementById(`codigo_${i}`).value = "";

                                activarBusquedaCodigo(i);
                            };

                            lista.appendChild(item);
                        });
                    });
            });
        }

        // =========================
        // CODIGOS
        // =========================
        function activarBusquedaCodigo(i) {

            const input = document.getElementById(`codigo_${i}`);
            const lista = document.getElementById(`listaCodigos_${i}`);

            input.onkeyup = null;

            input.addEventListener("keyup", function () {

                const proveedorId = document.getElementById(`prov_${i}`).value;

                if (!proveedorId) {
                    lista.innerHTML = "<div class='list-group-item'>Seleccione proveedor primero</div>";
                    return;
                }

                let term = this.value;

                fetch(`/PedidoCliente/BuscarCodigos?term=${term}&proveedorId=${proveedorId}`)
                    .then(r => r.json())
                    .then(data => {

                        lista.innerHTML = "";

                        data.forEach(c => {

                            let item = document.createElement("a");
                            item.className = "list-group-item list-group-item-action";
                            item.innerText = c;

                            item.onclick = () => {

                                input.value = c;
                                lista.innerHTML = "";

                                cargarInfoZapato(input, i);
                            };

                            lista.appendChild(item);
                        });
                    });
            });
        }

        // =========================
        // INFO ZAPATO
        // =========================
        function cargarInfoZapato(select, i) {

            const codigo = select.value;
            const proveedorId = document.getElementById(`prov_${i}`).value;

            fetch(`/PedidoCliente/ObtenerInfoZapato?codigo=${codigo}&proveedorId=${proveedorId}`)
                .then(r => r.json())
                .then(data => {

                    if (!data) return;

                    let color = document.getElementById(`color_${i}`);
                    let detalle = document.getElementById(`detalle_${i}`);
                    let cont = document.getElementById(`tallas_${i}`);

                    color.innerHTML = data.colores.map(c => `<option>${c}</option>`).join("");
                    detalle.innerHTML = data.detalles.map(d => `<option>${d}</option>`).join("");

                    cont.innerHTML = "";

                    data.tallas.forEach(t => {

                        cont.innerHTML += `
                        <div class="d-flex mb-1 align-items-center gap-2">

                            <span style="width:40px">${t.numero}</span>

                            <input type="text"
                                   class="form-control form-control-sm"
                                   value="₡${t.precio}"
                                   readonly
                                   style="max-width:100px;" />

                            <input type="number"
                                   min="0"
                                   class="form-control form-control-sm"
                                   placeholder="Cant."
                                   style="max-width:80px;"
                                   data-talla="${t.numero}"
                                   data-precio="${t.precio}" />

                        </div>`;
                    });
                });
        }

        // =========================
        // GENERAR DETALLES
        // =========================
        function prepararDetalles() {

            const contenedor = document.getElementById("detallesHidden");
            contenedor.innerHTML = "";

            let index = 0;

            for (let i = 0; i < filaIndex; i++) {

                const prov = document.getElementById(`prov_${i}`);
                const codigo = document.getElementById(`codigo_${i}`);
                const color = document.getElementById(`color_${i}`);
                const detalle = document.getElementById(`detalle_${i}`);
                const tallasDiv = document.getElementById(`tallas_${i}`);

                if (!prov || !codigo || !tallasDiv) continue;
                if (!prov.value || !codigo.value) continue;

                const inputs = tallasDiv.querySelectorAll("input[type='number']");

                inputs.forEach(input => {

                    const cantidad = parseInt(input.value || 0);

                    if (cantidad > 0) {

                        const html = `
                            <input type="hidden" name="Detalles[${index}].ProveedorCatalogoId" value="${prov.value}" />
                            <input type="hidden" name="Detalles[${index}].CodigoProducto" value="${codigo.value}" />
                            <input type="hidden" name="Detalles[${index}].Color" value="${color.value}" />
                            <input type="hidden" name="Detalles[${index}].Detalle" value="${detalle.value}" />
                            <input type="hidden" name="Detalles[${index}].Talla" value="${input.dataset.talla}" />
                            <input type="hidden" name="Detalles[${index}].Cantidad" value="${cantidad}" />
                            <input type="hidden" name="Detalles[${index}].PrecioUnitario" value="${input.dataset.precio}" />
                        `;

                        contenedor.insertAdjacentHTML("beforeend", html);
                        index++;
                    }
                });
            }

            console.log("Detalles generados:", index);
        }

        // =====================================================
        // CAMBIAR VENDEDORES SEGÚN EMPRESA
        // =====================================================

        document.querySelectorAll('input[name="Empresa"]')
            .forEach(radio => {

                radio.addEventListener("change", function() {

                    const empresa = this.value;

                    const vendedorSelect =
                        document.getElementById("vendedorSelect");

                    // Limpiar vendedores actuales
                    vendedorSelect.innerHTML = `
                        <option value="">
                            Cargando vendedores...
                        </option>
                    `;

                    fetch(`/PedidoCliente/ObtenerVendedores?empresa=${encodeURIComponent(empresa)}`)
                        .then(response => {

                            if (!response.ok) {
                                throw new Error("Error al obtener vendedores");
                            }

                            return response.json();
                        })
                        .then(vendedores => {

                            vendedorSelect.innerHTML = `
                                <option value="">
                                    Seleccione un vendedor
                                </option>
                            `;

                            vendedores.forEach(vendedor => {

                                const option =
                                    document.createElement("option");

                                option.value = vendedor;
                                option.textContent = vendedor;

                                vendedorSelect.appendChild(option);
                            });

                        })
                        .catch(error => {

                            console.error(error);

                            vendedorSelect.innerHTML = `
                                <option value="">
                                    Error al cargar vendedores
                                </option>
                            `;
                        });
                });
            });

    </script>
}