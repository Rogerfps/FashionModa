@using FashionM.Enums
@model PedidoCliente

@{
    ViewData["Title"] = "Detalle del Pedido";
    var totalZapatos = Model.Detalles.Sum(d => d.Cantidad);
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoDetails.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📋</span> Pedido #@Model.Id
    </h1>
    <a asp-action="Index" class="back-link">
        <span>←</span> Volver
    </a>
</div>

<!-- Información General -->
<div class="detail-card">
    <div class="section-title">
        <span>👤</span> Información del Pedido
    </div>

    <div class="info-grid">
        <!-- Cliente -->
        <div class="info-box">
            <div class="info-box-title">
                <span>👥</span> Cliente
            </div>
            <div class="info-row">
                <span class="info-label">Nombre</span>
                <span class="info-value">@Model.Cliente.Nombre @Model.Cliente.Apellidos</span>
            </div>
            <div class="info-row">
                <span class="info-label">Cédula</span>
                <span class="info-value">@Model.Cliente.Cedula</span>
            </div>
            <div class="info-row">
                <span class="info-label">Código</span>
                <span class="info-value">@Model.Cliente.Codigo</span>
            </div>
            <div class="info-row">
                <span class="info-label">Dirección</span>
                <span class="info-value">@Model.Cliente.Direccion</span>
            </div>
            <div class="info-row">
                <span class="info-label">Correo</span>
                <span class="info-value">@Model.Cliente.Correo</span>
            </div>
            <div class="info-row">
                <span class="info-label">Teléfono</span>
                <span class="info-value">@Model.Cliente.Telefonos</span>
            </div>
            <div class="info-row">
                <span class="info-label">Transporte</span>
                <span class="info-value">@Model.Cliente.Transporte</span>
            </div>
            <div class="info-row">
                <span class="info-label">Empresa</span>
                <span class="info-value">@Model.Cliente.Empresa</span>
            </div>
        </div>

        <!-- Pedido -->
        <div class="info-box">
            <div class="info-box-title">
                <span>📦</span> Detalles del Pedido
            </div>
            <div class="info-row">
                <span class="info-label">Fecha Pedido</span>
                <span class="info-value">@Model.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Fecha Entrega</span>
                <span class="info-value">@Model.FechaEntrega.ToLocalTime().ToString("dd/MM/yyyy")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Semana</span>
                <span class="info-value">@Model.Semana</span>
            </div>
            <div class="info-row">
                <span class="info-label">Agente</span>
                <span class="info-value">@Model.Cliente.Agente</span>
            </div>
            <div class="info-row">
                <span class="info-label">Observaciones</span>
                <span class="info-value">@Model.Observaciones</span>
            </div>
        </div>
    </div>
</div>

<!-- Detalle del Pedido -->
<div class="detail-card">
    <div class="section-title">
        <span>🛒</span> Productos del Pedido
    </div>

    <div class="table-wrapper">
        <table class="detalle-table">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Proveedor</th>
                    <th>Código</th>
                    <th>Color</th>
                    <th>Talla</th>
                    <th>Cantidad</th>
                    <th>Detalle</th>
                    <th>Precio Unit.</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>
                            @{
                                var zapato = d.Proveedor?.Zapatos?
                                .FirstOrDefault(z => z.Codigo == d.CodigoProducto && z.Color == d.Color);

                                var foto = zapato?.Imagenes?.FirstOrDefault()?.Url;
                            }

                            @if (!string.IsNullOrEmpty(foto))
                            {
                                <img src="@foto" class="producto-img" />
                            }
                            else
                            {
                                <div class="no-image">📷</div>
                            }
                        </td>
                        <td class="fw-semibold">@(d.Proveedor != null ? d.Proveedor.Nombre : "—")</td>
                        <td>@d.CodigoProducto</td>
                        <td>@d.Color</td>
                        <td>@d.Talla</td>
                        <td class="fw-bold">@d.Cantidad</td>
                        <td>@d.Detalle</td>
                        <td>₡ @d.PrecioUnitario.ToString("N2")</td>
                        <td class="fw-bold" style="color: var(--deep-blue);">₡ @d.SubTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Total Zapatos -->
    <div class="total-zapatos">
        <span class="total-zapatos-label">Total de zapatos</span>
        <span class="total-zapatos-value">@totalZapatos unidades</span>
    </div>
</div>

<!-- Totales y Estados -->
<div class="detail-card">
    <div class="section-title">
        <span>💰</span> Totales y Estados
    </div>

    <div class="totales-grid">
        <!-- Total -->
        <div class="total-box">
            <div class="total-label">Total del Pedido</div>
            <div class="total-monto">₡ @Model.Total.ToString("N2")</div>
        </div>

        <!-- Estados -->
        <div class="estados-box">
            <div class="estado-item">
                <span class="info-label">Crédito</span>
                @switch (Model.EstadoCredito)
                {
                    case EstadoCredito.Aprobado:
                        <span class="status-badge success">Aprobado</span>
                        break;
                    case EstadoCredito.Rechazado:
                        <span class="status-badge danger">Rechazado</span>
                        break;
                    case EstadoCredito.Retenido:
                        <span class="status-badge warning">Retenido</span>
                        break;
                    default:
                        <span class="status-badge secondary">Pendiente</span>
                        break;
                }
            </div>

            <div class="estado-item">
                <span class="info-label">Secretaría</span>
                @if (Model.AprobadoSecretaria)
                {
                    <span class="status-badge success">Aprobado</span>
                }
                else
                {
                    <span class="status-badge secondary">Pendiente</span>
                }
            </div>

            <div class="estado-item">
                <span class="info-label">Bodega</span>
                @if (Model.FirmaBodega)
                {
                    <span class="status-badge success">Despachado</span>
                }
                else
                {
                    <span class="status-badge secondary">Pendiente</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Acciones -->
<div class="action-buttons">
    <a asp-action="Index" class="btn-action btn-secondary">
        ← Volver
    </a>

    @if (!Model.AprobadoSecretaria)
    {
        <form asp-action="AprobarSecretaria" asp-route-id="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn-action btn-info">
                ✅ Aprobar Secretaría
            </button>
        </form>
    }

    @if (User.IsInRole("Admin") &&
         (Model.EstadoCredito == EstadoCredito.Pendiente ||
          Model.EstadoCredito == EstadoCredito.Retenido))
    {
        <form asp-action="AprobarCredito" asp-route-id="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn-action btn-success">
                ✅ Aprobar Crédito
            </button>
        </form>

        <form asp-action="RechazarCredito" asp-route-id="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn-action btn-danger">
                ❌ Rechazar Crédito
            </button>
        </form>

        <form asp-action="RetenerCredito" asp-route-id="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn-action btn-warning">
                ⚠️ Retener Crédito
            </button>
        </form>
    }

    @if (Model.EstadoCredito == EstadoCredito.Aprobado && !Model.FirmaBodega)
    {
        <form asp-action="FirmarBodega" asp-route-id="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn-action btn-primary">
                📦 Aprobar Bodega
            </button>
        </form>
    }
</div>