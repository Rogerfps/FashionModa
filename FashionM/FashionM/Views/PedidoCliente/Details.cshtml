@model PedidoCliente

@{
    ViewData["Title"] = "Detalle Pedido";
}

<link rel="stylesheet" href="~/css/PedidoCliente/PedidoDetails.css" />

<div class="container mt-4">
    <!-- HEADER -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📦</span> Pedido #@Model.Id
        </h1>
        <a asp-action="Index" class="btn-back">
            ← Volver
        </a>
    </div>

    <!-- CLIENTE -->
    <div class="info-card">
        <div class="section-title">
            <span>👤</span> Cliente
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Código Cliente</span>
                <span class="info-value">@Model.Cliente.Codigo</span>
            </div>
            <div class="info-item">
                <span class="info-label">Nombre</span>
                <span class="info-value">@Model.Cliente.Nombre @Model.Cliente.Apellidos</span>
            </div>
            <div class="info-item">
                <span class="info-label">Cédula</span>
                <span class="info-value">@Model.Cliente.Cedula</span>
            </div>
            <div class="info-item">
                <span class="info-label">Comercio</span>
                <span class="info-value">@Model.Cliente.Comercio</span>
            </div>
            <div class="info-item">
                <span class="info-label">Transporte</span>
                <span class="info-value">@Model.Cliente.Transporte</span>
            </div>
            <div class="info-item">
                <span class="info-label">Teléfono</span>
                <span class="info-value">@Model.Cliente.Telefonos</span>
            </div>
            <div class="info-item">
                <span class="info-label">Correo</span>
                <span class="info-value">@Model.Cliente.Correo</span>
            </div>
            <div class="info-item">
                <span class="info-label">Zona</span>
                <span class="info-value">@Model.Cliente.Zona</span>
            </div>
            <div class="info-item full-width">
                <span class="info-label">Dirección</span>
                <span class="info-value">@Model.Cliente.Direccion</span>
            </div>
            <div class="info-item">
                <span class="info-label">Límite de Crédito</span>
                <span class="info-value credit">₡ @Model.Cliente.LimiteCredito.ToString("N2")</span>
            </div>
        </div>
    </div>

    <!-- INFORMACIÓN DEL PEDIDO -->
    <div class="info-card">
        <div class="section-title">
            <span>📋</span> Información del Pedido
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Fecha Pedido</span>
                <span class="info-value">@Model.FechaPedido.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Fecha Entrega</span>
                <span class="info-value">@Model.FechaEntrega.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Empresa</span>
                <span class="info-value">@Model.Empresa</span>
            </div>
            <div class="info-item">
                <span class="info-label">Semana</span>
                <span class="info-value">@Model.Semana</span>
            </div>
            <div class="info-item full-width">
                <span class="info-label">Observaciones</span>
                <span class="info-value">@Model.Observaciones</span>
            </div>
            <div>
                <strong>Agente:</strong> @Model.Agente
            </div>
        </div>
    </div>

    <!-- ESTADO -->
    <div class="info-card">
        <div class="section-title">
            <span>📊</span> Estado del Pedido
        </div>

        <div class="status-grid">

            <!-- SECRETARIA -->
            <div class="status-card @(Model.AprobadoSecretaria ? "active" : "")"
                 onclick="toggleSecretaria(@Model.Id)">

                <div class="status-icon">🧾</div>
                <div class="status-info">
                    <div class="status-title">Secretaría</div>
                    <div class="status-desc">
                        @(Model.AprobadoSecretaria ? "Aprobado" : "Pendiente")
                    </div>
                </div>
            </div>

            <!-- CREDITO -->
            <div class="status-card credit @(Model.EstadoCredito.ToString())">

                <div class="status-icon">💳</div>
                <div class="status-info">
                    <div class="status-title">Crédito</div>
                    <div class="status-desc">@Model.EstadoCredito</div>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <select class="status-select"
                            onchange="cambiarCredito(@Model.Id, this.value)">
                        <option value="Pendiente">Pendiente</option>
                        <option value="Aprobado">Aprobado</option>
                        <option value="Rechazado">Rechazado</option>
                    </select>
                }
            </div>

            <!-- BODEGA -->
            <div class="status-card @(Model.FirmaBodega ? "active" : "")"
                 onclick="toggleBodega(@Model.Id)">

                <div class="status-icon">📦</div>
                <div class="status-info">
                    <div class="status-title">Bodega</div>
                    <div class="status-desc">
                        @(Model.FirmaBodega ? "Procesado" : "Pendiente")
                    </div>
                </div>
            </div>

            <!-- ENTREGA -->
            <div class="status-card delivery @(Model.EstadoEntrega ? "active" : "")"
                 onclick="toggleEntrega(@Model.Id)">

                <div class="status-icon">🚚</div>
                <div class="status-info">
                    <div class="status-title">Entrega</div>
                    <div class="status-desc">
                        @(Model.EstadoEntrega ? "Entregado" : "Pendiente")
                    </div>
                </div>
            </div>

        </div>
    </div>

    

    <!-- PRODUCTOS -->
    <div class="info-card">
        <div class="section-title">
            <span>🛒</span> Productos
        </div>

        @if (Model.Detalles != null && Model.Detalles.Any())
        {
            <div class="table-responsive">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Código</th>
                            <th>Color</th>
                            <th>Detalle</th>
                            <th>Talla</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                            <th>Stock</th>
                            <th>Entregado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Detalles)
                        {
                            <tr class="@(d.Entregado ? "entregado-row" : "")">
                                <td>@(d.ProveedorCatalogo?.Nombre ?? "-")</td>
                                <td>@d.CodigoProducto</td>
                                <td>@d.Color</td>
                                <td>@d.Detalle</td>
                                <td>@d.Talla</td>
                                <td>@d.Cantidad</td>
                                <td>₡ @d.PrecioUnitario.ToString("N2")</td>
                                <td class="fw-bold" style="color: var(--deep-blue);">
                                    ₡ @((d.Cantidad * d.PrecioUnitario).ToString("N2"))
                                </td>
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="checkbox-stock"
                                    @(d.EsStock ? "checked" : "")
                                           onchange="toggleStockDetalle(@d.Id, this.checked)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="checkbox-delivery"
                                    @(d.Entregado ? "checked" : "")
                                           onchange="toggleEntregaDetalle(@d.Id, this.checked)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">🛒</div>
                <p>Este pedido no tiene productos registrados</p>
            </div>
        }
    </div>

    <!-- TOTAL -->
    <div class="total-card">
        <div class="total-label">Total del Pedido</div>
        <div class="total-value">₡ @Model.Total.ToString("N2")</div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleEntregaDetalle(detalleId, estado) {
            fetch('/PedidoCliente/ToggleEntregaDetalle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: detalleId,
                    entregado: estado
                })
            })
            .then(() => location.reload()) // opcional
            .catch(error => console.error('Error:', error));
        }

        function toggleStockDetalle(detalleId, estado) {
            fetch('/PedidoCliente/ToggleStockDetalle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: detalleId,
                    stock: estado
                })
            })
            .then(() => location.reload())
            .catch(error => console.error('Error:', error));
        }

                function toggleSecretaria(id) {
            fetch(`/PedidoCliente/ToggleSecretaria?id=${id}`, { method: 'POST' })
                .then(() => location.reload());
        }

        function cambiarCredito(id, estado) {
            fetch(`/PedidoCliente/CambiarCredito?id=${id}&estado=${estado}`, { method: 'POST' })
                .then(() => location.reload());
        }

        function toggleBodega(id) {
            fetch(`/PedidoCliente/ToggleBodega?id=${id}`, { method: 'POST' })
                .then(() => location.reload());
        }

        function toggleEntrega(id) {
            fetch(`/PedidoCliente/ToggleEntrega?id=${id}`, { method: 'POST' })
                .then(() => location.reload());
        }
    </script>
}