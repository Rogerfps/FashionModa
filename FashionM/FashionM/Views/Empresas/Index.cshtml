@model IEnumerable<Empresa>

@{
    ViewData["Title"] = "Empresas";
}

<style>
    :root {
        --deep-blue: #0B2447;
        --ocean-blue: #19376D;
        --electric-blue: #576CBC;
        --light-bg: #F5F9FF;
        --pure-white: #FFFFFF;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --text-gray: #64748b;
        --border-light: #e2e8f0;
    }

    body {
        background: var(--light-bg);
        font-family: 'Inter', sans-serif;
    }

    /* Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--deep-blue) 0%, var(--electric-blue) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-neo {
        background: var(--deep-blue);
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        font-weight: 500;
        border: none;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .btn-neo:hover {
        background: var(--electric-blue);
        transform: translateY(-2px);
        color: white;
    }

    /* Tabla */
    .table-wrapper {
        background: var(--pure-white);
        border-radius: 24px;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -8px rgba(0,0,0,0.05);
        border: 1px solid var(--border-light);
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .modern-table th {
        background: var(--deep-blue);
        color: white;
        font-weight: 500;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        padding: 0.8rem 0.5rem;
        white-space: nowrap;
    }

    .modern-table th:first-child {
        border-radius: 12px 0 0 12px;
    }

    .modern-table th:last-child {
        border-radius: 0 12px 12px 0;
    }

    .modern-table td {
        padding: 1rem 0.5rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .modern-table tbody tr:hover {
        background: rgba(87, 108, 188, 0.02);
    }

    /* Badges */
    .empresa-badge {
        background: #E9EEF5;
        color: var(--deep-blue);
        padding: 0.2rem 0.8rem;
        border-radius: 30px;
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-block;
    }

    .telefono-badge {
        background: #f1f5f9;
        color: var(--text-gray);
        padding: 0.2rem 0.8rem;
        border-radius: 30px;
        font-size: 0.8rem;
        display: inline-block;
    }

    /* Botones acción */
    .action-group {
        display: flex;
        gap: 0.3rem;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
    }

    .btn-edit {
        background: #fef3c7;
        color: var(--warning);
    }
    .btn-edit:hover {
        background: var(--warning);
        color: white;
    }

    .btn-delete {
        background: #fee2e2;
        color: var(--danger);
    }
    .btn-delete:hover {
        background: var(--danger);
        color: white;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 3rem;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.3;
    }

    .empty-text {
        color: var(--text-gray);
        font-size: 1rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }
        
        .page-title {
            font-size: 1.5rem;
        }
        
        .action-group {
            flex-direction: column;
        }
        
        .btn-action {
            width: 100%;
            justify-content: center;
        }
        
        .modern-table {
            font-size: 0.8rem;
        }
    }
</style>

<div class="container mt-4">
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">
            <span>🏢</span> Empresas
        </h1>
        <a asp-action="Create" class="btn-neo">
            <span>➕</span> Nueva Empresa
        </a>
    </div>

    <!-- Tabla -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cédula Jurídica</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <div class="empty-icon">🏢</div>
                                <div class="empty-text">No hay empresas registradas</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <span class="empresa-badge">@item.Nombre</span>
                            </td>

                            <td>@item.CedulaJuridica</td>

                            <td>
                                <span class="telefono-badge">
                                    📞 @item.Telefono
                                </span>
                            </td>

                            <td>
                                <div class="action-group">

                                    <!-- 👁 VER DETALLE -->
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-action btn-view"
                                       title="Ver detalle">
                                        👁 Ver
                                    </a>

                                    <!-- ✏️ EDITAR -->
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-action btn-edit"
                                       title="Editar empresa">
                                        ✏️ Editar
                                    </a>

                                    <!-- 🗑 ELIMINAR -->
                                    <form asp-action="Delete" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit"
                                                class="btn-action btn-delete"
                                                title="Eliminar empresa"
                                                onclick="return confirm('¿Seguro que deseas eliminar esta empresa?');">
                                            🗑 Eliminar
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>