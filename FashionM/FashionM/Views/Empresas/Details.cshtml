@model Empresa

@{
    ViewData["Title"] = "Detalle Empresa";
}

<link rel="stylesheet" href="~/css/Empresa/EmpresaDetails.css" />

<div class="container mt-4">
    <!-- HEADER -->
    <div class="page-header">
        <h1 class="page-title">
            <span>🏢</span> @Model.Nombre
        </h1>
        <a asp-action="Index" class="btn-back">
            ← Volver
        </a>
    </div>

    <!-- INFO PRINCIPAL -->
    <div class="card-modern">
        <div class="section-title">
            <span>📋</span> Información General
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="label">Cédula Jurídica</span>
                <span class="value">@Model.CedulaJuridica</span>
            </div>

            <div class="info-item">
                <span class="label">Teléfono</span>
                <span class="value">@Model.Telefono</span>
            </div>

            <div class="info-item full">
                <span class="label">Dirección</span>
                <span class="value">@Model.Direccion</span>
            </div>
        </div>
    </div>

    <!-- CUENTAS BANCARIAS -->
    <div class="card-modern">
        <div class="section-title">
            <span>🏦</span> Cuentas Bancarias
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="label">BAC</span>
                <span class="value">
                    @if (!string.IsNullOrEmpty(Model.CuentaBAC))
                    {
                        @Model.CuentaBAC
                    }
                    else
                    {
                        <span class="empty-value">—</span>
                    }
                </span>
            </div>

            <div class="info-item">
                <span class="label">BCR</span>
                <span class="value">
                    @if (!string.IsNullOrEmpty(Model.CuentaBCR))
                    {
                        @Model.CuentaBCR
                    }
                    else
                    {
                        <span class="empty-value">—</span>
                    }
                </span>
            </div>

            <div class="info-item">
                <span class="label">BN</span>
                <span class="value">
                    @if (!string.IsNullOrEmpty(Model.CuentaBN))
                    {
                        @Model.CuentaBN
                    }
                    else
                    {
                        <span class="empty-value">—</span>
                    }
                </span>
            </div>

            <div class="info-item">
                <span class="label">SINPE Móvil</span>
                <span class="value">
                    @if (!string.IsNullOrEmpty(Model.SimpeMovil))
                    {
                        @Model.SimpeMovil
                    }
                    else
                    {
                        <span class="empty-value">—</span>
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="action-bar">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">
            ✏️ Editar Empresa
        </a>

        <form asp-action="Delete" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn-delete"
                    onclick="return confirm('¿Estás seguro de eliminar esta empresa? Esta acción no se puede deshacer.');">
                🗑 Eliminar Empresa
            </button>
        </form>
    </div>
</div>