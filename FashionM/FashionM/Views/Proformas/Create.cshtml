@model Proforma

@{
    ViewData["Title"] = "Nueva Proforma";
}

<link rel="stylesheet" href="~/css/Proforma/ProformaCreate.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📄</span> Nueva Proforma
    </h1>
    <a asp-action="Index" class="back-link">
        <span>←</span> Volver
    </a>
</div>

<!-- Formulario -->
<div class="form-card">
    <form asp-action="Create">
        <div class="section-title">
            <span>📋</span> Información de la Proforma
        </div>

        <div class="form-grid">
            <!-- Empresa -->
            <div class="form-group">
                <label asp-for="EmpresaId" class="form-label"></label>
                <select asp-for="EmpresaId" class="form-select" asp-items="ViewBag.Empresas">
                    <option value="">Seleccione una empresa</option>
                </select>
                <span asp-validation-for="EmpresaId" class="validation-error"></span>
            </div>

            <!-- Cliente -->
            <div class="form-group position-relative">
                <label class="form-label">Cliente</label>

                <!-- Input de búsqueda -->
                <input type="text" id="clienteBuscar" class="form-control"
                       placeholder="Buscar por cédula, nombre o comercio..."
                       autocomplete="off" />

                <!-- Valor real que se guarda -->
                <input type="hidden" asp-for="ClienteCedula" id="ClienteCedula" />

                <!-- Lista dinámica -->
                <div id="listaClientes" class="list-group"></div>

                <span asp-validation-for="ClienteCedula" class="validation-error"></span>
            </div>

            <!-- Facturado por -->
            <div class="form-group">
                    <label asp-for="FacturadoPor" class="form-label"></label>

                    <div class="radio-group">
                        <label class="radio-option">
                            <input type="radio" asp-for="FacturadoPor" value="A.s" />
                            <span>A.s</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio" asp-for="FacturadoPor" value="K.s" />
                            <span>K.s</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio" asp-for="FacturadoPor" value="Y.s" />
                            <span>Y.s</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio" asp-for="FacturadoPor" value="N.s" />
                            <span>N.s</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio" asp-for="FacturadoPor" value="R.fps" />
                            <span>R.fps</span>
                        </label>
                    </div>

                    <span asp-validation-for="FacturadoPor" class="validation-error"></span>
                </div>

            <!-- Número de cajas -->
            <div class="form-group">
                <label asp-for="NumeroCajas" class="form-label"></label>
                <input asp-for="NumeroCajas" class="form-control" type="number" min="0" placeholder="0" />
                <span asp-validation-for="NumeroCajas" class="validation-error"></span>
            </div>
        </div>

        <!-- Detalle -->
        <div class="form-group mb-4">
            <label asp-for="Detalle" class="form-label"></label>
            <textarea asp-for="Detalle" class="form-control" rows="3" placeholder="Ingrese una nota o detalle adicional..."></textarea>
            <span asp-validation-for="Detalle" class="validation-error"></span>
        </div>

        <!-- Fecha -->
        <div class="form-group mb-4">
            <label class="form-label">Fecha</label>
            <input type="text" class="form-control"
                   value="@DateTime.Now.ToString("dd/MM/yyyy")"
                   disabled readonly />
        </div>
        

        <!-- Botones -->
        <div class="action-buttons">
            <a asp-action="Index" class="btn-back">
                ← Cancelar
            </a>
            <button type="submit" class="btn-save">
                💾 Guardar y agregar productos
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

<script>
let timeout = null;

const input = document.getElementById("clienteBuscar");
const lista = document.getElementById("listaClientes");
const hidden = document.getElementById("ClienteCedula");

// 🔥 Limpia cédula si el usuario escribe manualmente
input.addEventListener("input", function () {
    hidden.value = "";
});

input.addEventListener("keyup", function () {
    clearTimeout(timeout);

    let term = this.value;

    timeout = setTimeout(() => {

        if (term.length < 1) {
            lista.innerHTML = "";
            return;
        }

        fetch(`/Proformas/BuscarClientes?term=${term}`)
            .then(res => res.json())
            .then(data => {
                lista.innerHTML = "";

                if (data.length === 0) {
                    lista.innerHTML = `<div class="list-group-item">Sin resultados</div>`;
                    return;
                }

                data.forEach(cliente => {
                    let item = document.createElement("a");
                    item.className = "list-group-item list-group-item-action";

                    item.innerHTML = `
                        <strong>${cliente.nombre}</strong><br>
                        <small>${cliente.cedula} - ${cliente.comercio ?? ''}</small>
                    `;

                    item.onclick = () => {
                        input.value = `${cliente.nombre} - ${cliente.cedula}`;
                        hidden.value = cliente.cedula;
                        lista.innerHTML = "";
                    };

                    lista.appendChild(item);
                });
            });

    }, 300);
});
</script>
}