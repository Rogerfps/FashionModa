
@model Proforma

@{
    ViewData["Title"] = "Nueva Proforma";
}

<link rel="stylesheet" href="~/css/Proforma/ProformaCreate.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📄</span> Nueva Proforma
    </h1>

    <a asp-action="Index" class="back-link">
        <span>←</span> Volver
    </a>
</div>

<!-- Formulario -->
<div class="form-card">
    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-error mb-3"></div>

        <div class="section-title">
            <span>📋</span> Información de la Proforma
        </div>

        <div class="form-grid">

            <!-- Empresa -->
            <div class="form-group">
                <label asp-for="EmpresaId" class="form-label"></label>

                <select asp-for="EmpresaId"
                        class="form-select"
                        asp-items="ViewBag.Empresas"
                        id="EmpresaId">

                    <option value="">Seleccione una empresa</option>
                </select>

                <span asp-validation-for="EmpresaId"
                      class="validation-error"></span>
            </div>

            <!-- Agente de Venta -->
            <div class="form-group">
                <label asp-for="AgenteVenta" class="form-label">
                    Agente de Venta
                </label>

                <select asp-for="AgenteVenta"
                        class="form-select"
                        id="agenteSelect">

                    <option value="">Seleccione un agente</option>
                </select>

                <span asp-validation-for="AgenteVenta"
                      class="validation-error"></span>
            </div>

            <!-- Cliente -->
            <div class="form-group position-relative">
                <label class="form-label" for="clienteBuscar">
                    Cliente
                </label>

                <input type="text"
                       id="clienteBuscar"
                       class="form-control"
                       placeholder="Buscar por cédula, nombre, comercio o alias..."
                       autocomplete="off" />

                <!-- Cédula del cliente seleccionado -->
                <input type="hidden"
                       asp-for="ClienteCedula"
                       id="ClienteCedula" />

                <!-- Resultados de búsqueda -->
                <div id="listaClientes"
                     class="list-group"
                     style="position:absolute; z-index:1050; width:100%; max-height:300px; overflow-y:auto;">
                </div>

                <span asp-validation-for="ClienteCedula"
                      class="validation-error"></span>

                <small class="text-muted">
                    Puedes buscar un alias compartido por varias tiendas.
                    Selecciona el comercio correcto.
                </small>
            </div>

            <!-- Facturado por -->
            <div class="form-group">
                <label asp-for="FacturadoPor" class="form-label">
                    Facturado por
                </label>

                <div class="radio-group">

                    <label class="radio-option">
                        <input type="radio"
                               asp-for="FacturadoPor"
                               value="A.s" />
                        <span>A.s</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio"
                               asp-for="FacturadoPor"
                               value="K.s" />
                        <span>K.s</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio"
                               asp-for="FacturadoPor"
                               value="Y.s" />
                        <span>Y.s</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio"
                               asp-for="FacturadoPor"
                               value="N.s" />
                        <span>N.s</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio"
                               asp-for="FacturadoPor"
                               value="R.fps" />
                        <span>R.fps</span>
                    </label>

                </div>

                <span asp-validation-for="FacturadoPor"
                      class="validation-error"></span>
            </div>

            <!-- Número de cajas -->
            <div class="form-group">
                <label asp-for="NumeroCajas" class="form-label"></label>

                <input asp-for="NumeroCajas"
                       class="form-control"
                       type="number"
                       min="0"
                       placeholder="0" />

                <span asp-validation-for="NumeroCajas"
                      class="validation-error"></span>
            </div>

        </div>

        <!-- Detalle -->
        <div class="form-group mb-4">
            <label asp-for="Detalle" class="form-label"></label>

            <textarea asp-for="Detalle"
                      class="form-control"
                      rows="3"
                      placeholder="Ingrese una nota o detalle adicional..."></textarea>

            <span asp-validation-for="Detalle"
                  class="validation-error"></span>
        </div>

        <!-- Fecha -->
        <div class="form-group mb-4">
            <label class="form-label">Fecha</label>

            <input type="text"
                   class="form-control"
                   value="@DateTime.Now.ToString("dd/MM/yyyy")"
                   disabled
                   readonly />
        </div>

        <!-- Botones -->
        <div class="action-buttons">

            <a asp-action="Index" class="btn-back">
                ← Cancelar
            </a>

            <button type="submit" class="btn-save">
                💾 Guardar y agregar productos
            </button>

        </div>

    </form>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // =========================================
        // BÚSQUEDA DE CLIENTES POR NOMBRE, CÉDULA,
        // COMERCIO O ALIAS
        // =========================================

        let timeoutBusqueda = null;

        const inputCliente = document.getElementById("clienteBuscar");
        const listaClientes = document.getElementById("listaClientes");
        const cedulaCliente = document.getElementById("ClienteCedula");

        inputCliente.addEventListener("input", function () {
            // Si cambia el texto, hay que volver a seleccionar al cliente.
            cedulaCliente.value = "";

            clearTimeout(timeoutBusqueda);

            const termino = this.value.trim();

            if (termino.length === 0) {
                listaClientes.innerHTML = "";
                return;
            }

            timeoutBusqueda = setTimeout(async () => {
                listaClientes.innerHTML = `
                    <div class="list-group-item">
                        Buscando clientes...
                    </div>`;

                try {
                    const respuesta = await fetch(
                        `/Proformas/BuscarClientes?term=${encodeURIComponent(termino)}`
                    );

                    if (!respuesta.ok) {
                        throw new Error("No se pudo consultar la lista de clientes.");
                    }

                    const clientes = await respuesta.json();

                    listaClientes.innerHTML = "";

                    if (!clientes || clientes.length === 0) {
                        listaClientes.innerHTML = `
                            <div class="list-group-item">
                                No se encontraron clientes.
                            </div>`;
                        return;
                    }

                    clientes.forEach(cliente => {
                        const opcion = document.createElement("button");

                        opcion.type = "button";
                        opcion.className =
                            "list-group-item list-group-item-action text-start";

                        const nombre = document.createElement("strong");
                        nombre.textContent = cliente.nombre || "Sin nombre";

                        const informacion = document.createElement("small");
                        informacion.className = "d-block text-muted";

                        informacion.textContent =
                            `Cédula: ${cliente.cedula}` +
                            ` | Comercio: ${cliente.comercio || "Sin comercio"}`;

                        opcion.appendChild(nombre);
                        opcion.appendChild(informacion);

                        if (cliente.alias) {
                            const alias = document.createElement("small");
                            alias.className = "d-block";

                            alias.textContent = `Alias: ${cliente.alias}`;

                            opcion.appendChild(alias);
                        }

                        opcion.addEventListener("click", function () {
                            inputCliente.value =
                                `${cliente.nombre} - ${cliente.cedula}` +
                                (cliente.alias ? ` (${cliente.alias})` : "");

                            cedulaCliente.value = cliente.cedula;

                            listaClientes.innerHTML = "";
                        });

                        listaClientes.appendChild(opcion);
                    });

                } catch (error) {
                    console.error("Error al buscar clientes:", error);

                    listaClientes.innerHTML = `
                        <div class="list-group-item text-danger">
                            Ocurrió un error al buscar clientes.
                        </div>`;
                }
            }, 300);
        });

        // Cerrar los resultados al hacer clic fuera de la búsqueda.
        document.addEventListener("click", function (evento) {
            if (!inputCliente.contains(evento.target) &&
                !listaClientes.contains(evento.target)) {
                listaClientes.innerHTML = "";
            }
        });

        // =========================================
        // CARGAR AGENTES SEGÚN EMPRESA
        // =========================================

        const empresaSelect = document.getElementById("EmpresaId");
        const agenteSelect = document.getElementById("agenteSelect");

        async function cargarAgentes(empresaId) {
            agenteSelect.innerHTML =
                '<option value="">Cargando agentes...</option>';

            if (!empresaId) {
                agenteSelect.innerHTML =
                    '<option value="">Seleccione un agente</option>';
                return;
            }

            try {
                const respuesta = await fetch(
                    `/Proformas/ObtenerAgentes?empresaId=${encodeURIComponent(empresaId)}`
                );

                if (!respuesta.ok) {
                    throw new Error("No se pudieron cargar los agentes.");
                }

                const agentes = await respuesta.json();

                agenteSelect.innerHTML =
                    '<option value="">Seleccione un agente</option>';

                agentes.forEach(agente => {
                    const opcion = document.createElement("option");

                    opcion.value = agente;
                    opcion.textContent = agente;

                    agenteSelect.appendChild(opcion);
                });

            } catch (error) {
                console.error("Error al cargar agentes:", error);

                agenteSelect.innerHTML =
                    '<option value="">Error cargando agentes</option>';
            }
        }

        empresaSelect.addEventListener("change", function () {
            cargarAgentes(this.value);
        });

        // Si ya hay una empresa seleccionada al abrir el formulario,
        // cargar también sus agentes.
        if (empresaSelect.value) {
            cargarAgentes(empresaSelect.value);
        }

        // =========================================
        // VALIDAR QUE SE HAYA SELECCIONADO UN CLIENTE
        // =========================================

        const formulario = document.querySelector('form[asp-action="Create"]');

        formulario.addEventListener("submit", function (evento) {
            if (!cedulaCliente.value) {
                evento.preventDefault();

                alert("Debes buscar y seleccionar un cliente antes de guardar la proforma.");

                inputCliente.focus();
            }
        });
    </script>
}