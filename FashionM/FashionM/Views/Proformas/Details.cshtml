@model Proforma

@{
    ViewData["Title"] = "Detalle Proforma";
}

<link rel="stylesheet" href="~/css/Proforma/ProformaDetails.css" />

<div class="proforma-container">

    <!-- HEADER -->
    <div class="header-section">
        <h1 class="header-title">
            <span>📄</span> Proforma #@Model.Id
        </h1>
        <a asp-action="Index" class="btn-back">
            ← Volver
        </a>
    </div>

    <!-- CABECERA CON FECHA Y PDF -->
    <div class="card">
        <div class="card-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="font-size: 1.2rem; font-weight: 600; color: var(--deep-blue);">
                    Proforma #@Model.Id
                </div>
                <div style="font-size: 0.85rem; color: var(--text-gray);">
                    @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <a asp-action="GenerarPDF" asp-route-id="@Model.Id" class="btn-pdf">
                📄 Descargar PDF
            </a>
        </div>
    </div>

    <!-- INFORMACIÓN: EMPRESA Y CLIENTE -->
    <div class="card">
        <div class="card-header">
            <h3>🏢 Empresa</h3>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Nombre</span>
                    <span class="info-value">@Model.Empresa?.Nombre</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Cédula Jurídica</span>
                    <span class="info-value">@Model.Empresa?.CedulaJuridica</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Teléfono</span>
                    <span class="info-value">@Model.Empresa?.Telefono</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Dirección</span>
                    <span class="info-value">@Model.Empresa?.Direccion</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>👤 Cliente</h3>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Código</span>
                    <span class="info-value">@Model.Cliente?.Codigo</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Nombre</span>
                    <span class="info-value">@Model.Cliente?.Nombre @Model.Cliente?.Apellidos</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Comercio</span>
                    <span class="info-value">@Model.Cliente?.Comercio</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Teléfono</span>
                    <span class="info-value">@Model.Cliente?.Telefonos</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Transporte</span>
                    <span class="info-value">@Model.Cliente?.Transporte</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Agente</span>
                    <span class="info-value">@Model.Cliente?.Agente</span>
                </div>
            </div>
        </div>
    </div>

    <!-- DETALLES DE LA PROFORMA -->
    <div class="card">
        <div class="card-header">
            <h3>📋 Detalles de la Proforma</h3>
        </div>
        <div class="card-body">
            <div class="data-row">
                <div class="data-col">
                    <div class="info-label">Facturado por</div>
                    <div class="info-value">@Model.FacturadoPor</div>
                </div>
                <div class="data-col">
                    <div class="info-label">Número de Cajas</div>
                    <div class="info-value">@Model.NumeroCajas</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Detalle))
            {
                <div class="detalle-box">
                    <strong style="display: block; margin-bottom: 0.5rem;">Detalle</strong>
                    @Model.Detalle
                </div>
            }
        </div>
    </div>

    <!-- TABLA DE PRODUCTOS -->
    <div class="card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <h3>🛒 Productos</h3>
            <a asp-action="AgregarProducto" asp-route-id="@Model.Id" class="btn-edit-products">
                ✏️ Editar productos
            </a>
        </div>
        <div class="card-body">
            @if (Model.Detalles != null && Model.Detalles.Any())
            {
                <div class="table-responsive">
                    <table class="product-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Color</th>
                                <th>Talla</th>
                                <th>Cantidad</th>
                                <th>Precio Unit.</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Detalles)
                            {
                                <tr>
                                    <td>@item.InventarioCodigo</td>
                                    <td>@item.Color</td>
                                    <td>@item.Talla</td>
                                    <td class="text-right">@item.Cantidad</td>
                                    <td class="text-right">₡ @item.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-right fw-bold">₡ @item.SubTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="total-section">
                    <div class="total-box">
                        <div class="total-label">Total General</div>
                        <div class="total-value">₡ @Model.Total.ToString("N2")</div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert-empty">
                    ⚠️ Esta proforma no tiene productos registrados aún.
                </div>
            }
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="action-bar">
        <a asp-action="Index" class="btn-back">
            ← Volver al listado
        </a>
    </div>

</div>