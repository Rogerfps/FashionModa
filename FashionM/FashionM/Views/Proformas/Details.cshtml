@model Proforma

@{
    ViewData["Title"] = "Detalle Proforma";

    var totalPares = Model.Detalles
        .Sum(d => Math.Max(0, d.Cantidad - d.CantidadDevuelta));
}

<link rel="stylesheet" href="~/css/Proforma/ProformaDetails.css" />

<div class="proforma-container">

    <!-- HEADER -->
    <div class="header-section">
        <h1 class="header-title">
            <span>📄</span> Proforma #@Model.Numero
        </h1>
        <a asp-action="Index" class="btn-back">
            ← Volver
        </a>
    </div>

    <!-- CABECERA CON FECHA Y PDF -->
    <div class="card">
        <div class="card-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="font-size: 1.2rem; font-weight: 600; color: var(--deep-blue);">
                    Proforma #@Model.Numero
                </div>
                <div style="font-size: 0.85rem; color: var(--text-gray);">
                    @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <a asp-action="GenerarPDF" asp-route-id="@Model.Id" class="btn-pdf">
                📄 Descargar PDF
            </a>
        </div>
    </div>

    <!-- INFORMACIÓN: EMPRESA Y CLIENTE -->
    <div class="card">
        <div class="card-header">
            <h3>🏢 Empresa</h3>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Nombre</span>
                    <span class="info-value">@Model.Empresa?.Nombre</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Cédula Jurídica</span>
                    <span class="info-value">@Model.Empresa?.CedulaJuridica</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Teléfono</span>
                    <span class="info-value">@Model.Empresa?.Telefono</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Dirección</span>
                    <span class="info-value">@Model.Empresa?.Direccion</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>👤 Cliente</h3>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Código</span>
                    <span class="info-value">@Model.Cliente?.Codigo</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Nombre</span>
                    <span class="info-value">@Model.Cliente?.Nombre @Model.Cliente?.Apellidos</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Comercio</span>
                    <span class="info-value">@Model.Cliente?.Comercio</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Teléfono</span>
                    <span class="info-value">@Model.Cliente?.Telefonos</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Transporte</span>
                    <span class="info-value">@Model.Cliente?.Transporte</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Agente</span>
                    <span class="info-value">@Model.Cliente?.Agente</span>
                </div>
            </div>
        </div>
    </div>

    <!-- DETALLES DE LA PROFORMA -->
    <div class="card">
        <div class="card-header">
            <h3>📋 Detalles de la Proforma</h3>
        </div>
        <div class="card-body">
            <div class="data-row">

                <div class="data-col">
                    <div class="info-label">Facturado por</div>
                    <div class="info-value">
                        @Model.FacturadoPor
                    </div>
                </div>

                <div class="data-col">
                    <div class="info-label">Agente de Venta</div>

                    <div class="info-value">

                        @if (!string.IsNullOrWhiteSpace(Model.AgenteVenta))
                        {
                            <span class="agent-badge">
                                👤 @Model.AgenteVenta
                            </span>
                        }
                        else
                        {
                            <span class="empty-value">—</span>
                        }

                    </div>
                </div>

                <div class="data-col">
                    <div class="info-label">Número de Cajas</div>

                    <div class="info-value">
                        @Model.NumeroCajas
                    </div>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Detalle))
            {
                <div class="detalle-box">
                    <strong style="display: block; margin-bottom: 0.5rem;">Detalle</strong>
                    @Model.Detalle
                </div>
            }
        </div>
    </div>

    <!-- TABLA DE PRODUCTOS -->
    <!-- TABLA DE PRODUCTOS -->
    <div class="card">

        <div class="card-header"
             style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">

            <h3>🛒 Productos</h3>

            <a asp-action="AgregarProducto"
               asp-route-id="@Model.Id"
               class="btn-edit-products">

                ✏️ Editar productos

            </a>

        </div>


        <div class="card-body">

            @if (Model.Detalles != null && Model.Detalles.Any())
            {
                <div class="table-responsive">

                    <table class="product-table">

                        <thead>

                            <tr>

                                <th>Código</th>

                                <th>Color</th>

                                <th>Talla</th>

                                <th>Cantidad</th>

                                <th>Devuelto</th>

                                <th>Actual</th>

                                <th>Precio Unit.</th>

                                <th>Descuento</th>

                                <th>Subtotal</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model.Detalles)
                            {
                                var cantidadActual =
                                    Math.Max(
                                        0,
                                        item.Cantidad -
                                        item.CantidadDevuelta
                                    );

                                <tr>

                                    <td>
                                        @item.CodigoProducto
                                    </td>

                                    <td>
                                        @item.Color
                                    </td>

                                    <td>
                                        @item.Talla
                                    </td>

                                    <!-- CANTIDAD ORIGINAL -->
                                    <td class="text-right">
                                        @item.Cantidad
                                    </td>

                                    <!-- DEVUELTO -->
                                    <td class="text-right">

                                        @if (item.CantidadDevuelta > 0)
                                        {
                                            <span>
                                                @item.CantidadDevuelta
                                            </span>
                                        }
                                        else
                                        {
                                            <span>0</span>
                                        }

                                    </td>

                                    <!-- CANTIDAD ACTUAL -->
                                    <td class="text-right">

                                        <strong>
                                            @cantidadActual
                                        </strong>

                                    </td>

                                    <!-- PRECIO -->
                                    <td class="text-right">

                                        ₡ @item.PrecioUnitario.ToString("N2")

                                    </td>

                                    <!-- DESCUENTO PRODUCTO -->
                                    <td class="text-right">

                                        @if (item.DescuentoPorcentaje > 0)
                                        {
                                            <span>
                                                @item.DescuentoPorcentaje.ToString("N2")%
                                            </span>

                                            <br />

                                            <small>
                                                -₡ @item.DescuentoMonto.ToString("N2")
                                            </small>
                                        }
                                        else
                                        {
                                            <span>
                                                —
                                            </span>
                                        }

                                    </td>

                                    <!-- SUBTOTAL -->
                                    <td class="text-right fw-bold">

                                        ₡ @item.SubTotal.ToString("N2")

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- ======================================== -->
                <!-- RESUMEN DE TOTALES -->
                <!-- ======================================== -->

                <div class="total-section">

                    <div class="total-box">

                        <!-- SUBTOTAL ANTES DEL DESCUENTO GENERAL -->

                        <div class="total-item">
                            <span>Total de pares:</span>
                            <strong>@totalPares</strong>
                        </div>

                        <div style="display:flex;
                            justify-content:space-between;
                            align-items:center;
                            gap:2rem;
                            margin-bottom:0.5rem;">

                            <span class="total-label">
                                Subtotal:
                            </span>

                            <span>
                                ₡ @((Model.Total + Model.DescuentoMonto).ToString("N2"))
                            </span>

                        </div>


                        <!-- DESCUENTO GENERAL -->
                        @if (Model.DescuentoPorcentaje > 0)
                        {
                            <div style="display:flex;
                                justify-content:space-between;
                                align-items:center;
                                gap:2rem;
                                margin-bottom:0.5rem;">

                                <span class="total-label">

                                    Descuento general
                                    (@Model.DescuentoPorcentaje.ToString("N2")%):

                                </span>

                                <span style="color:#c0392b;">

                                    -₡ @Model.DescuentoMonto.ToString("N2")

                                </span>

                            </div>
                        }


                        <!-- TOTAL FINAL -->

                        <div style="display:flex;
                            justify-content:space-between;
                            align-items:center;
                            gap:2rem;
                            margin-top:0.75rem;
                            padding-top:0.75rem;
                            border-top:1px solid #ddd;">

                            <div class="total-label">
                                Total General
                            </div>

                            <div class="total-value">

                                ₡ @Model.Total.ToString("N2")

                            </div>

                        </div>

                    </div>

                </div>

            }
            else
            {
                <div class="alert-empty">

                    ⚠️ Esta proforma no tiene productos registrados aún.

                </div>
            }

        </div>

    </div>

    <form asp-action="GenerarVenta"
          asp-route-id="@Model.Id"
          method="post"
          style="display:inline;">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-success">

            💰 Generar Venta

        </button>

    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- ACCIONES -->
    <div class="action-bar">
        <a asp-action="Index" class="btn-back">
            ← Volver al listado
        </a>
    </div>

</div>