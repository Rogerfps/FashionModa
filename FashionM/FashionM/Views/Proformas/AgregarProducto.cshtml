@model Proforma

@{
    ViewData["Title"] = "Agregar Productos";
}

<link rel="stylesheet"
      href="~/css/Proforma/ProformaAgregar.css" />

<div class="container mt-4">

    <!-- HEADER -->
    <div class="page-header">

        <h1 class="page-title">

            <span>🛒</span>

            Agregar Productos a Proforma #@Model.Id

        </h1>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="back-link">

            <span>←</span>

            Ver Detalle

        </a>

    </div>


    <!-- INFO -->
    <div class="info-card">

        <div class="info-grid">

            <div class="info-item">

                <div class="info-label">
                    Empresa
                </div>

                <div class="info-value">
                    @Model.Empresa?.Nombre
                </div>

            </div>


            <div class="info-item">

                <div class="info-label">
                    Cliente
                </div>

                <div class="info-value">
                    @Model.Cliente?.Nombre
                    @Model.Cliente?.Apellidos
                </div>

            </div>


            <div class="info-item">

                <div class="info-label">
                    Fecha
                </div>

                <div class="info-value">
                    @Model.Fecha.ToString("dd/MM/yyyy")
                </div>

            </div>

        </div>

    </div>


    <!-- FORM -->
    <div class="form-card">

        <div class="section-title">

            <span>➕</span>

            Agregar Nuevo Producto

        </div>


        <form asp-action="CrearZapato"
              method="post"
              id="formProforma">

            <input type="hidden"
                   name="proformaId"
                   value="@Model.Id" />


            <div class="row g-3">


                <!-- PRODUCTO -->
                <div class="col-md-4 position-relative">

                    <label class="form-label">
                        Producto
                    </label>

                    <input type="text"
                           id="productoBuscar"
                           class="form-control"
                           placeholder="Buscar código o marca..."
                           autocomplete="off" />

                    <input type="hidden"
                           name="codigo"
                           id="codigoProducto"
                           required />

                    <div id="listaProductos"
                         class="list-group">
                    </div>

                </div>


                <!-- COLOR -->
                <div class="col-md-3">

                    <label class="form-label">
                        Color
                    </label>

                    <select name="color"
                            id="colorSelect"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione
                        </option>

                    </select>

                </div>


                <!-- DETALLE -->
                <div class="col-md-3">

                    <label class="form-label">
                        Detalle
                    </label>

                    <select name="detalle"
                            id="detalleSelect"
                            class="form-select">

                        <option value="">
                            (Sin detalle)
                        </option>

                    </select>

                </div>


                <!-- DESCUENTO PRODUCTO -->
                <div class="col-md-2">

                    <label class="form-label">
                        Descuento %
                    </label>

                    <input type="number"
                           name="descuentoProducto"
                           id="descuentoProducto"
                           class="form-control"
                           value="0"
                           min="0"
                           max="100"
                           step="0.01"
                           placeholder="0" />

                </div>


                <!-- TABLA -->
                <div class="col-12">

                    <label class="form-label">
                        Tallas y Cantidades
                    </label>

                    <div id="tablaTallas"></div>

                </div>


                <!-- BTN -->
                <div class="col-12 d-flex justify-content-end">

                    <button type="submit"
                            class="btn-add">

                        ➕ Agregar Producto

                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- PRODUCTOS ACTUALES -->
    <div class="table-wrapper">

        <div class="section-title">

            <span>📋</span>

            Productos en la Proforma

        </div>


        <div class="table-responsive">

            <table class="productos-table">

                <thead>

                    <tr>

                        <th>Código</th>

                        <th>Color</th>

                        <th>Talla</th>

                        <th class="text-center">
                            Cantidad
                        </th>

                        <th class="text-center">
                            Devuelto
                        </th>

                        <th class="text-center">
                            Actual
                        </th>

                        <th class="text-right">
                            Precio
                        </th>

                        <th class="text-right">
                            Descuento
                        </th>

                        <th class="text-right">
                            Subtotal
                        </th>

                        <th class="text-center">
                            Devolver
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model.Detalles)
                    {
                        var cantidadActual =
                            Math.Max(
                                0,
                                item.Cantidad -
                                item.CantidadDevuelta
                            );

                        <tr>

                            <td>
                                @item.InventarioCodigo
                            </td>

                            <td>
                                @item.Color
                            </td>

                            <td>
                                @item.Talla
                            </td>

                            <td class="text-center">
                                @item.Cantidad
                            </td>

                            <td class="text-center">

                                @if (item.CantidadDevuelta > 0)
                                {
                                    <span>
                                        @item.CantidadDevuelta
                                    </span>
                                }
                                else
                                {
                                    <span>0</span>
                                }

                            </td>

                            <td class="text-center">

                                <strong>
                                    @cantidadActual
                                </strong>

                            </td>

                            <td class="text-right">

                                ₡ @item.PrecioUnitario.ToString("N2")

                            </td>

                            <td class="text-right">

                                @if (item.DescuentoPorcentaje > 0)
                                {
                                    <span>
                                        @item.DescuentoPorcentaje.ToString("N2")%
                                    </span>

                                    <br />

                                    <small>
                                        -₡ @item.DescuentoMonto.ToString("N2")
                                    </small>
                                }
                                else
                                {
                                    <span>0%</span>
                                }

                            </td>

                            <td class="text-right fw-bold">

                                ₡ @item.SubTotal.ToString("N2")

                            </td>

                            <td class="text-center">

                                @if (cantidadActual > 0)
                                {
                                    <form asp-action="DevolverProducto"
                                          method="post"
                                          class="d-flex justify-content-center align-items-center gap-1">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="detalleId"
                                               value="@item.Id" />

                                        <input type="number"
                                               name="cantidadDevuelta"
                                               value="1"
                                               min="1"
                                               max="@cantidadActual"
                                               class="form-control form-control-sm"
                                               style="width: 70px;" />

                                        <button type="submit"
                                                class="btn btn-sm btn-warning"
                                                title="Devolver producto"
                                                onclick="return confirm('¿Está seguro de devolver esta cantidad al inventario?');">
                                            ↩️
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Devuelto
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- RESUMEN -->
        <div class="total-footer">

            <div class="d-flex justify-content-between align-items-center mb-2">

                <span>
                    Subtotal:
                </span>

                <span>
                    ₡ @{
                    var subtotalAntesDescuentoGeneral =
                        Model.Total + Model.DescuentoMonto;
                }
                @subtotalAntesDescuentoGeneral.ToString("N2")
            </span>

        </div>


        <!-- DESCUENTO GENERAL -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <form asp-action="AplicarDescuentoGeneral"
                  method="post"
                  class="d-flex align-items-center gap-2">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="proformaId"
                       value="@Model.Id" />

                <span>
                    Descuento general:
                </span>

                <input type="number"
                       name="descuentoPorcentaje"
                       value="@Model.DescuentoPorcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                       min="0"
                       max="100"
                       step="0.01"
                       class="form-control"
                       style="width:100px;" />

                <span>%</span>

                <button type="submit"
                        class="btn btn-sm btn-primary">

                    Aplicar

                </button>

            </form>


            <span>
                -₡ @Model.DescuentoMonto.ToString("N2")
            </span>

        </div>


        <!-- TOTAL -->
        <div class="d-flex justify-content-between align-items-center">

            <strong>
                Total:
            </strong>

            <strong>
                ₡ @Model.Total.ToString("N2")
            </strong>

        </div>

    </div>

</div>

</div>


@section Scripts {

    <script>

        let timeout = null;

        const input =
            document.getElementById(
                "productoBuscar"
            );

        const lista =
            document.getElementById(
                "listaProductos"
            );

        const hidden =
            document.getElementById(
                "codigoProducto"
            );

        const color =
            document.getElementById(
                "colorSelect"
            );

        const detalle =
            document.getElementById(
                "detalleSelect"
            );

        let variantes = [];


        // ========================================
        // BUSCAR PRODUCTO
        // ========================================

        input.addEventListener(
            "keyup",
            function() {
                clearTimeout(timeout);

                let term = this.value;

                timeout = setTimeout(() => {
                    if (term.length < 1) {
                        lista.innerHTML = "";
                        return;
                    }

                    fetch(`/Proformas/BuscarProductos?term=${encodeURIComponent(term)}&proformaId=@Model.Id`)
                        .then(r => r.json())
                        .then(data => {
                            lista.innerHTML = "";

                            data.forEach(p => {
                                let item =
                                    document.createElement("a");

                                item.className =
                                    "list-group-item list-group-item-action";

                                item.innerHTML =
                                    `<strong>${p.codigo}</strong> - ${p.marca}`;

                                item.onclick = () => {
                                    input.value = p.codigo;

                                    hidden.value = p.codigo;

                                    lista.innerHTML = "";

                                    cargarVariantes(p.codigo);
                                };

                                lista.appendChild(item);
                            });
                        });

                }, 300);
            });


        // ========================================
        // CARGAR VARIANTES
        // ========================================

        function cargarVariantes(codigo) {
            fetch(`/Proformas/ObtenerVariantes?codigo=${encodeURIComponent(codigo)}&proformaId=@Model.Id`)
                .then(r => r.json())
                .then(data => {
                    variantes = data;

                    llenarSelect(
                        color,
                        [...new Set(data.map(x => x.color))],
                        "Seleccione"
                    );

                    detalle.innerHTML =
                        `<option value="">(Sin detalle)</option>`;

                    document.getElementById(
                        "tablaTallas"
                    ).innerHTML = "";
                });
        }


        // ========================================
        // COLOR CHANGE
        // ========================================

        color.addEventListener(
            "change",
            () => {
                let c = color.value;

                let filtradasColor =
                    variantes.filter(v =>
                        v.color === c
                    );

                let detalles =
                    filtradasColor.map(v =>
                        v.detalle || ""
                    );

                let unicos =
                    [...new Set(detalles)];

                llenarSelect(
                    detalle,
                    unicos,
                    "(Sin detalle)"
                );

                if (unicos.length === 1) {
                    detalle.value = unicos[0];

                    detalle.dispatchEvent(
                        new Event("change")
                    );
                }

                if (unicos.length === 0) {
                    renderTallas(
                        filtradasColor
                    );
                }
            });


        // ========================================
        // DETALLE CHANGE
        // ========================================

        detalle.addEventListener(
            "change",
            () => {
                let c = color.value;

                let d = detalle.value;

                let filtradas =
                    variantes.filter(v =>
                        v.color === c &&
                        (v.detalle || "").trim()
                        === (d || "").trim()
                    );

                renderTallas(filtradas);
            });


        // ========================================
        // RENDER TALLAS
        // ========================================

        function renderTallas(data) {
            let html = `
                        <table class="productos-table">

                            <thead>

                                <tr>

                                    <th>Talla</th>

                                    <th>Stock</th>

                                    <th>Precio</th>

                                    <th>Cantidad</th>

                                </tr>

                            </thead>

                            <tbody>
                    `;

            data.forEach((v, i) => {
                let precio =
                    Number(v.precio || 0);

                html += `
                            <tr>

                                <td>
                                    ${v.talla}
                                </td>

                                <td>
                                    ${v.stock ?? '-'}
                                </td>

                                <td>
                                    ₡ ${precio.toFixed(2)}
                                </td>

                                <td>

                                    <input type="hidden"
                                           name="tallas[${i}]"
                                           value="${v.talla}" />

                                    <input type="hidden"
                                           name="preciosCosto[${i}]"
                                           value="${precio}" />

                                    <input type="hidden"
                                           name="preciosVenta[${i}]"
                                           value="${precio}" />

                                    <input type="number"
                                           name="cantidades[${i}]"
                                           min="0"
                                           max="${v.stock ?? ''}"
                                           class="form-control" />

                                </td>

                            </tr>
                        `;
            });

            html += `
                            </tbody>

                        </table>
                    `;

            document.getElementById(
                "tablaTallas"
            ).innerHTML = html;
        }


        // ========================================
        // SUBMIT
        // ========================================

        document.getElementById(
            "formProforma"
        ).addEventListener(
            "submit",
            function(e) {
                let inputsCantidad =
                    document.querySelectorAll(
                        "input[name^='cantidades']"
                    );

                let inputsTalla =
                    document.querySelectorAll(
                        "input[name^='tallas']"
                    );

                let inputsCosto =
                    document.querySelectorAll(
                        "input[name^='preciosCosto']"
                    );

                let inputsVenta =
                    document.querySelectorAll(
                        "input[name^='preciosVenta']"
                    );

                let nuevasTallas = [];

                let nuevasCantidades = [];

                let nuevosCostos = [];

                let nuevosVentas = [];


                inputsCantidad.forEach(
                    (input, index) => {
                        let cantidad =
                            parseInt(input.value);

                        if (!isNaN(cantidad)
                            && cantidad > 0) {
                            nuevasTallas.push(
                                inputsTalla[index].value
                            );

                            nuevasCantidades.push(
                                cantidad
                            );

                            nuevosCostos.push(
                                Number(
                                    inputsCosto[index].value
                                )
                            );

                            nuevosVentas.push(
                                Number(
                                    inputsVenta[index].value
                                )
                            );
                        }
                    });


                if (nuevasCantidades.length === 0) {
                    e.preventDefault();

                    alert(
                        "Debe ingresar al menos una cantidad mayor a 0"
                    );

                    return;
                }


                // ========================================
                // VALIDAR DESCUENTO PRODUCTO
                // ========================================

                const descuento =
                    parseFloat(
                        document.getElementById(
                            "descuentoProducto"
                        ).value
                    ) || 0;

                if (descuento < 0 || descuento > 100) {
                    e.preventDefault();

                    alert(
                        "El descuento debe estar entre 0% y 100%."
                    );

                    return;
                }


                // LIMPIAR INPUTS VIEJOS

                inputsCantidad.forEach(i => i.remove());

                inputsTalla.forEach(i => i.remove());

                inputsCosto.forEach(i => i.remove());

                inputsVenta.forEach(i => i.remove());


                // CREAR NUEVOS

                nuevasTallas.forEach((t, i) => {
                    this.insertAdjacentHTML(
                        "beforeend",
                        `
                                    <input type="hidden"
                                           name="tallas[${i}]"
                                           value="${t}" />

                                    <input type="hidden"
                                           name="cantidades[${i}]"
                                           value="${nuevasCantidades[i]}" />

                                    <input type="hidden"
                                           name="preciosCosto[${i}]"
                                           value="${nuevosCostos[i]}" />

                                    <input type="hidden"
                                           name="preciosVenta[${i}]"
                                           value="${nuevosVentas[i]}" />
                                `
                    );
                });

            });


        // ========================================
        // LLENAR SELECT
        // ========================================

        function llenarSelect(
            select,
            items,
            textoDefault
        ) {
            select.innerHTML =
                `<option value="">${textoDefault}</option>`;

            items.forEach(i => {
                let o =
                    document.createElement(
                        "option"
                    );

                o.value = i;

                o.text =
                    i || "(Sin detalle)";

                select.appendChild(o);
            });
        }

    </script>

}
