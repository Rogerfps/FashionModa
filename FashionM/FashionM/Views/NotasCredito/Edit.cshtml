@model NotaCredito

@{
    ViewData["Title"] = "Editar Nota Crédito";
}

<div class="nc-container">

    <!-- HEADER -->
    <div class="nc-header">

        <div>

            <h1 class="nc-title">
                ✏️ Editar Nota Crédito #@Model.Id
            </h1>

            <p class="nc-subtitle">
                Venta #@Model.VentaId
            </p>

        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn-back">

            ← Volver

        </a>

    </div>

    <!-- ALERTAS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- FORM -->
    <form asp-action="Edit"
          method="post"
          id="editForm">

        <input type="hidden"
               name="id"
               value="@Model.Id" />

        <!-- MOTIVO -->
        <div class="form-card">

            <div class="section-title">
                📝 Motivo General
            </div>

            <textarea name="motivo"
                      class="form-control"
                      rows="3"
                      required>@Model.Motivo</textarea>

        </div>

        <!-- DESCUENTO GLOBAL -->
        <div class="form-card">

            <div class="section-title">
                💸 Descuento Global
            </div>

            <div class="discount-global">

                <input type="number"
                       step="0.01"
                       min="0"
                       max="100"
                       name="descuentoGlobal"
                       id="descuentoGlobal"
                       class="form-control"
                       value="@Model.DescuentoGlobal.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                <span class="discount-symbol">
                    %
                </span>

            </div>

        </div>

        <!-- PRODUCTOS -->
        <div class="form-card">

            <div class="section-title">
                📦 Ajustes de Productos
            </div>

            <div class="table-responsive">

                <table class="productos-table">

                    <thead>

                        <tr>

                            <th>Código</th>
                            <th>Color</th>
                            <th>Talla</th>
                            <th>Vendidos</th>
                            <th>Disponible</th>
                            <th>Precio Original</th>
                            <th>Precio Corregido</th>
                            <th>Devolver</th>
                            <th>Desc. Línea %</th>
                            <th>Eliminar</th>
                            <th>Observación</th>
                            <th>Subtotal</th>

                        </tr>

                    </thead>

                    <tbody>

                        @for (int i = 0; i < Model.Venta!.Detalles.Count; i++)
                        {
                            var item =
                                Model.Venta.Detalles.ElementAt(i);

                            var detalleNota =
                                Model.Detalles
                                    .FirstOrDefault(x =>
                                        x.VentaDetalleId == item.Id);

                            int disponible =
                                ViewData[$"Disponible_{item.Id}"] != null
                                    ? (int)ViewData[$"Disponible_{item.Id}"]!
                                    : item.Cantidad;

                            if (detalleNota != null)
                            {
                                disponible +=
                                    detalleNota.CantidadDevuelta;
                            }

                            <tr class="producto-row">

                                <td style="display:none;">

                                    <input type="hidden"
                                           name="detalleIds[@i]"
                                           value="@item.Id" />

                                </td>

                                <td>

                                    @item.InventarioCodigo

                                </td>

                                <td>

                                    @item.Color

                                </td>

                                <td>

                                    @item.Talla

                                </td>

                                <td class="cantidad-original">

                                    @item.Cantidad

                                </td>

                                <td class="cantidad-disponible">

                                    @disponible

                                </td>

                                <td class="precio-original">

                                    @item.PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)

                                </td>

                                <!-- PRECIO -->
                                <td>

                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           name="preciosCorregidos[@i]"
                                           class="form-control precio-corregido"
                                           value="@((detalleNota?.PrecioCorregido ?? item.PrecioUnitario).ToString(System.Globalization.CultureInfo.InvariantCulture))" />

                                </td>

                                <!-- DEVOLVER -->
                                <td>

                                    <input type="number"
                                           min="0"
                                           max="@disponible"
                                           name="cantidadesDevueltas[@i]"
                                           class="form-control cantidad-devuelta"
                                           value="@(detalleNota?.CantidadDevuelta ?? 0)" />

                                </td>

                                <!-- DESCUENTO -->
                                <td>

                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           name="descuentosLinea[@i]"
                                           class="form-control descuento-linea"
                                           value="@((detalleNota?.DescuentoLinea ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" />

                                </td>

                                <!-- ELIMINAR -->
                                <td class="text-center">

                                    <input type="checkbox"
                                           name="eliminarLineaIds"
                                           value="@item.Id"
                                           class="eliminar-linea"
                                    @(detalleNota?.Eliminado == true ? "checked" : "") />

                                </td>

                                <!-- OBS -->
                                <td>

                                    <input type="text"
                                           name="observaciones[@i]"
                                           class="form-control"
                                           value="@detalleNota?.Observaciones"
                                           placeholder="Observación..." />

                                </td>

                                <!-- SUBTOTAL -->
                                <td class="subtotal-linea">

                                    ₡ @(detalleNota?.SubTotal.ToString("N2") ?? "0.00")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <!-- RESUMEN -->
        <div class="summary-card">

            <div class="summary-row">

                <span>
                    Subtotal
                </span>

                <strong id="subtotalGeneral">

                    ₡ @Model.SubTotal.ToString("N2")

                </strong>

            </div>

            <div class="summary-row">

                <span>
                    Descuento Global
                </span>

                <strong id="descuentoTotal">

                    ₡ 0.00

                </strong>

            </div>

            <div class="summary-row total-final">

                <span>
                    Total Nota Crédito
                </span>

                <strong id="totalFinal">

                    ₡ @Model.TotalDevuelto.ToString("N2")

                </strong>

            </div>

        </div>

        <!-- BOTONES -->
        <div class="action-buttons">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn-cancel">

                Cancelar

            </a>

            <button type="submit"
                    class="btn-save">

                💾 Guardar Cambios

            </button>

        </div>

    </form>

</div>

<script>

    const rows =
        document.querySelectorAll(
            '.producto-row'
        );

    const descuentoGlobalInput =
        document.getElementById(
            'descuentoGlobal'
        );

    function formatMoney(value) {

        return value.toLocaleString(
            'es-CR',
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
    }

    function calcularTotales() {

        let subtotalGeneral = 0;

        rows.forEach(row => {

            const cantidadVendida =
                parseFloat(
                    row.querySelector(
                        '.cantidad-original'
                    )?.innerText
                ) || 0;

            const precioOriginal =
                parseFloat(
                    row.querySelector(
                        '.precio-original'
                    )?.innerText
                ) || 0;

            const precioCorregido =
                parseFloat(
                    row.querySelector(
                        '.precio-corregido'
                    )?.value
                ) || 0;

            const cantidadDevuelta =
                parseFloat(
                    row.querySelector(
                        '.cantidad-devuelta'
                    )?.value
                ) || 0;

            const descuentoLinea =
                parseFloat(
                    row.querySelector(
                        '.descuento-linea'
                    )?.value
                ) || 0;

            const eliminar =
                row.querySelector(
                    '.eliminar-linea'
                )?.checked || false;

            // ========================================
            // DETECTAR CAMBIO PRECIO
            // ========================================

            const precioModificado =
                precioCorregido !== precioOriginal;

            // ========================================
            // CANTIDAD AFECTADA
            // ========================================

            let cantidadAfectada = 0;

            // DEVOLUCIÓN
            if (cantidadDevuelta > 0)
            {
                cantidadAfectada =
                    cantidadDevuelta;
            }

            // DESCUENTO O CAMBIO PRECIO
            else if (
                descuentoLinea > 0 ||
                precioModificado
            )
            {
                cantidadAfectada =
                    cantidadVendida;
            }

            // ELIMINAR
            if (eliminar)
            {
                cantidadAfectada =
                    cantidadVendida;
            }

            // ========================================
            // SUBTOTAL
            // ========================================

            let subtotal =
                cantidadAfectada *
                precioCorregido;

            // ========================================
            // DESCUENTO LÍNEA
            // ========================================

            if (descuentoLinea > 0)
            {
                subtotal -=
                    subtotal *
                    (descuentoLinea / 100);
            }

            subtotalGeneral += subtotal;

            // ========================================
            // UI
            // ========================================

            const subtotalEl =
                row.querySelector(
                    '.subtotal-linea'
                );

            if (subtotalEl)
            {
                subtotalEl.innerText =
                    `₡ ${formatMoney(subtotal)}`;
            }
        });

        // ========================================
        // DESCUENTO GLOBAL
        // ========================================

        const descuentoGlobal =
            parseFloat(
                descuentoGlobalInput?.value
            ) || 0;

        const descuentoMonto =
            subtotalGeneral *
            (descuentoGlobal / 100);

        // ========================================
        // TOTAL FINAL
        // ========================================

        const totalFinal =
            subtotalGeneral +
            descuentoMonto;

        // ========================================
        // UI
        // ========================================

        const subtotalGeneralEl =
            document.getElementById(
                'subtotalGeneral'
            );

        const descuentoTotalEl =
            document.getElementById(
                'descuentoTotal'
            );

        const totalFinalEl =
            document.getElementById(
                'totalFinal'
            );

        if (subtotalGeneralEl)
        {
            subtotalGeneralEl.innerText =
                `₡ ${formatMoney(subtotalGeneral)}`;
        }

        if (descuentoTotalEl)
        {
            descuentoTotalEl.innerText =
                `₡ ${formatMoney(descuentoMonto)}`;
        }

        if (totalFinalEl)
        {
            totalFinalEl.innerText =
                `₡ ${formatMoney(totalFinal)}`;
        }
    }

    // ========================================
    // EVENTS
    // ========================================

    document.querySelectorAll('input')
        .forEach(input =>
        {
            input.addEventListener(
                'input',
                calcularTotales
            );

            input.addEventListener(
                'change',
                calcularTotales
            );
        });

    // ========================================
    // SUBMIT
    // ========================================

    const form =
        document.getElementById(
            'editForm'
        );

    if (form)
    {
        form.addEventListener(
            'submit',
            function ()
            {
                calcularTotales();
            });
    }

    // ========================================
    // INIT
    // ========================================

    calcularTotales();

</script>