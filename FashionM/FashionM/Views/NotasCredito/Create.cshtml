@model Venta

@{
    ViewData["Title"] = "Generar Nota Crédito";
}

<link rel="stylesheet" href="~/css/NotaCredito/NotaCreate.css" />

<div class="nc-container">
    <!-- HEADER -->
    <div class="nc-header">
        <div>
            <h1 class="nc-title">
                <span>↩️</span> Generar Nota Crédito
            </h1>
            <p class="nc-subtitle">
                Venta #@Model.Id
            </p>
        </div>
        <a asp-controller="Ventas" asp-action="Details" asp-route-id="@Model.Id" class="btn-back">
            ← Volver
        </a>
    </div>

    <!-- INFO -->
    <div class="info-card">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Cliente</span>
                <span class="info-value">@Model.Cliente?.Nombre @Model.Cliente?.Apellidos</span>
            </div>
            <div class="info-item">
                <span class="info-label">Empresa</span>
                <span class="info-value">@Model.Empresa?.Nombre</span>
            </div>
            <div class="info-item">
                <span class="info-label">Agente</span>
                <span class="info-value">@Model.AgenteVenta</span>
            </div>
            <div class="info-item">
                <span class="info-label">Total Venta</span>
                <span class="info-value total-original">₡ @Model.Total.ToString("N2")</span>
            </div>
        </div>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- FORM -->
    <form asp-action="Create" method="post">
        <input type="hidden" name="ventaId" value="@Model.Id" />

        <!-- MOTIVO GENERAL -->
        <div class="form-card">
            <div class="section-title">
                <span>📝</span> Motivo General
            </div>
            <textarea name="motivo" class="form-control" rows="3" required placeholder="Ingrese el motivo general de la nota crédito..."></textarea>
        </div>

        <!-- DESCUENTO GLOBAL -->
        <div class="form-card">
            <div class="section-title">
                <span>💸</span> Descuento Global
            </div>
            <div class="discount-global">
                <input type="number" step="0.01" min="0" max="100" name="descuentoGlobal" class="form-control" value="0" />
                <span class="discount-symbol">%</span>
            </div>
        </div>

        <!-- PRODUCTOS -->
        <div class="form-card">
            <div class="section-title">
                <span>📦</span> Ajustes de Productos
            </div>

            <div class="table-responsive">
                <table class="productos-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Color</th>
                            <th>Talla</th>
                            <th>Vendidos</th>
                            <th>Disponible</th>
                            <th>Precio Original</th>
                            <th>Precio Corregido</th>
                            <th>Devolver</th>
                            <th>Desc. Línea %</th>
                            <th>Eliminar</th>
                            <th>Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            var item = Model.Detalles.ElementAt(i);
                            int disponible = (int)(ViewData[$"Disponible_{item.Id}"] ?? 0);
                            bool agotado = disponible <= 0;

                            <tr>
                                <input type="hidden" name="detalleIds" value="@item.Id" />
                                <td>@item.InventarioCodigo</td>
                                <td>@item.Color</td>
                                <td>@item.Talla</td>
                                <td>@item.Cantidad</td>
                                <td>
                                    @if (agotado)
                                    {
                                        <span class="badge-danger">AGOTADO</span>
                                    }
                                    else
                                    {
                                        <span class="badge-success">@disponible</span>
                                    }
                                </td>
                                <td>₡ @item.PrecioUnitario.ToString("N2")</td>
                                <td>
                                    <input type="number" step="0.01" min="0" name="preciosCorregidos" class="form-control" value="@item.PrecioUnitario" readonly="@agotado" />
                                </td>
                                <td>
                                    <input type="number" min="0" max="@disponible" name="cantidadesDevueltas" class="form-control" value="0" readonly="@agotado" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="100" name="descuentosLinea" class="form-control" value="0" readonly="@agotado" />
                                </td>
                                <td class="text-center">
                                    @if (agotado)
                                    {
                                        <input type="checkbox" disabled />
                                        <input type="hidden" name="eliminarLineaIds" value="-1" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="eliminarLineaIds" value="@item.Id" />
                                    }
                                </td>
                                <td>
                                    <input type="text" name="observaciones" class="form-control" placeholder="Observación..." readonly="@agotado" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- INFO NOTE -->
        <div class="info-note">
            <strong>ℹ️ Importante:</strong> Los montos finales de la nota crédito serán calculados automáticamente por el sistema al guardar.
        </div>

        <!-- BOTONES -->
        <div class="action-buttons">
            <a asp-controller="Ventas" asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">
                Cancelar
            </a>
            <button type="submit" class="btn-save">
                💾 Generar Nota Crédito
            </button>
        </div>
    </form>
</div>