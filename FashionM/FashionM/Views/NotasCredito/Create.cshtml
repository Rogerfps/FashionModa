@model Venta

@{
    ViewData["Title"] = "Generar Nota Crédito";
}

<style>
    :root {
        --deep-blue: #0B2447;
        --ocean-blue: #19376D;
        --electric-blue: #576CBC;
        --light-bg: #F5F9FF;
        --pure-white: #FFFFFF;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --text-gray: #64748b;
        --border-light: #e2e8f0;
    }

    body {
        background: var(--light-bg);
        font-family: 'Inter', sans-serif;
    }

    .nc-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .nc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .nc-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--deep-blue) 0%, var(--electric-blue) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nc-subtitle {
        color: var(--text-gray);
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }

    .btn-back {
        background: #f1f5f9;
        color: var(--deep-blue);
        border: none;
        border-radius: 30px;
        padding: 0.6rem 1.5rem;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: var(--deep-blue);
            color: white;
            transform: translateY(-2px);
        }

    .info-card {
        background: var(--pure-white);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid var(--border-light);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .info-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--text-gray);
        letter-spacing: 0.3px;
    }

    .info-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--deep-blue);
    }

    .total-original {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--success);
    }

    .alert-error {
        background: #fee2e2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
        color: var(--danger);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-card {
        background: var(--pure-white);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid var(--border-light);
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--deep-blue);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #eef2f6;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-control {
        width: 100%;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.6rem 1rem;
        font-size: 0.85rem;
        transition: all 0.2s;
        background: #fafcff;
    }

        .form-control:focus {
            border-color: var(--electric-blue);
            outline: none;
            box-shadow: 0 0 0 3px rgba(87, 108, 188, 0.1);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
    }

    .discount-global {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        max-width: 200px;
    }

    .discount-symbol {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--deep-blue);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .productos-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
        min-width: 1200px;
    }

        .productos-table th {
            background: var(--deep-blue);
            color: white;
            font-weight: 500;
            font-size: 0.7rem;
            text-transform: uppercase;
            padding: 0.7rem 0.5rem;
            white-space: nowrap;
        }

            .productos-table th:first-child {
                border-radius: 12px 0 0 12px;
            }

            .productos-table th:last-child {
                border-radius: 0 12px 12px 0;
            }

        .productos-table td {
            padding: 0.6rem 0.5rem;
            border-bottom: 1px solid #edf2f7;
            vertical-align: middle;
        }

        .productos-table tbody tr:hover {
            background: rgba(87, 108, 188, 0.02);
        }

        .productos-table input[type="number"],
        .productos-table input[type="text"] {
            width: 100%;
            min-width: 80px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 0.4rem 0.5rem;
            font-size: 0.75rem;
        }

        .productos-table input:focus {
            border-color: var(--electric-blue);
            outline: none;
        }

        .productos-table input:read-only {
            background: #f1f5f9;
        }

    .badge-success {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
        padding: 0.2rem 0.5rem;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-danger {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
        padding: 0.2rem 0.5rem;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .text-center {
        text-align: center;
    }

    input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: var(--danger);
    }

        input[type="checkbox"]:disabled {
            cursor: not-allowed;
            opacity: 0.5;
        }

    .info-note {
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
        color: var(--warning);
        font-size: 0.8rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    .btn-cancel {
        background: #f1f5f9;
        color: var(--deep-blue);
        border: none;
        border-radius: 30px;
        padding: 0.7rem 2rem;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            background: var(--deep-blue);
            color: white;
            transform: translateY(-2px);
        }

    .btn-save {
        background: linear-gradient(135deg, var(--deep-blue) 0%, var(--electric-blue) 100%);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 0.7rem 2rem;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -8px rgba(11, 36, 71, 0.3);
        }

    @@media (max-width: 1024px) {
        .info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .nc-container {
            padding: 1rem;
        }
        
        .nc-title {
            font-size: 1.5rem;
        }
        
        .nc-header {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .info-grid {
            grid-template-columns: 1fr;
        }
        
        .action-buttons {
            flex-direction: column;
        }
        
        .btn-cancel, .btn-save {
            width: 100%;
            justify-content: center;
        }
        
        .discount-global {
            max-width: 100%;
        }
    }
</style>

<div class="nc-container">
    <!-- HEADER -->
    <div class="nc-header">
        <div>
            <h1 class="nc-title">
                <span>↩️</span> Generar Nota Crédito
            </h1>
            <p class="nc-subtitle">
                Venta #@Model.Id
            </p>
        </div>
        <a asp-controller="Ventas" asp-action="Details" asp-route-id="@Model.Id" class="btn-back">
            ← Volver
        </a>
    </div>

    <!-- INFO -->
    <div class="info-card">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Cliente</span>
                <span class="info-value">@Model.Cliente?.Nombre @Model.Cliente?.Apellidos</span>
            </div>
            <div class="info-item">
                <span class="info-label">Empresa</span>
                <span class="info-value">@Model.Empresa?.Nombre</span>
            </div>
            <div class="info-item">
                <span class="info-label">Agente</span>
                <span class="info-value">@Model.AgenteVenta</span>
            </div>
            <div class="info-item">
                <span class="info-label">Total Venta</span>
                <span class="info-value total-original">₡ @Model.Total.ToString("N2")</span>
            </div>
        </div>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- FORM -->
    <form asp-action="Create" method="post">
        <input type="hidden" name="ventaId" value="@Model.Id" />

        <!-- MOTIVO GENERAL -->
        <div class="form-card">
            <div class="section-title">
                <span>📝</span> Motivo General
            </div>
            <textarea name="motivo" class="form-control" rows="3" required placeholder="Ingrese el motivo general de la nota crédito..."></textarea>
        </div>

        <!-- DESCUENTO GLOBAL -->
        <div class="form-card">
            <div class="section-title">
                <span>💸</span> Descuento Global
            </div>
            <div class="discount-global">
                <input type="number" step="0.01" min="0" max="100" name="descuentoGlobal" class="form-control" value="0" />
                <span class="discount-symbol">%</span>
            </div>
        </div>

        <!-- PRODUCTOS -->
        <div class="form-card">
            <div class="section-title">
                <span>📦</span> Ajustes de Productos
            </div>

            <div class="table-responsive">
                <table class="productos-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Color</th>
                            <th>Talla</th>
                            <th>Vendidos</th>
                            <th>Disponible</th>
                            <th>Precio Original</th>
                            <th>Precio Corregido</th>
                            <th>Devolver</th>
                            <th>Desc. Línea %</th>
                            <th>Eliminar</th>
                            <th>Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            var item = Model.Detalles.ElementAt(i);
                            int disponible = (int)(ViewData[$"Disponible_{item.Id}"] ?? 0);
                            bool agotado = disponible <= 0;

                            <tr>
                                <input type="hidden" name="detalleIds" value="@item.Id" />
                                <td>@item.InventarioCodigo</td>
                                <td>@item.Color</td>
                                <td>@item.Talla</td>
                                <td>@item.Cantidad</td>
                                <td>
                                    @if (agotado)
                                    {
                                        <span class="badge-danger">AGOTADO</span>
                                    }
                                    else
                                    {
                                        <span class="badge-success">@disponible</span>
                                    }
                                </td>
                                <td>₡ @item.PrecioUnitario.ToString("N2")</td>
                                <td>
                                    <input type="number" step="0.01" min="0" name="preciosCorregidos" class="form-control" value="@item.PrecioUnitario" readonly="@agotado" />
                                </td>
                                <td>
                                    <input type="number" min="0" max="@disponible" name="cantidadesDevueltas" class="form-control" value="0" readonly="@agotado" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="100" name="descuentosLinea" class="form-control" value="0" readonly="@agotado" />
                                </td>
                                <td class="text-center">
                                    @if (agotado)
                                    {
                                        <input type="checkbox" disabled />
                                        <input type="hidden" name="eliminarLineaIds" value="-1" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="eliminarLineaIds" value="@item.Id" />
                                    }
                                </td>
                                <td>
                                    <input type="text" name="observaciones" class="form-control" placeholder="Observación..." readonly="@agotado" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- INFO NOTE -->
        <div class="info-note">
            <strong>ℹ️ Importante:</strong> Los montos finales de la nota crédito serán calculados automáticamente por el sistema al guardar.
        </div>

        <!-- BOTONES -->
        <div class="action-buttons">
            <a asp-controller="Ventas" asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">
                Cancelar
            </a>
            <button type="submit" class="btn-save">
                💾 Generar Nota Crédito
            </button>
        </div>
    </form>
</div>