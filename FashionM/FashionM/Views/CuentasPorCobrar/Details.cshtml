@model IEnumerable<CuentaPorCobrar>

@{
    ViewData["Title"] = "Detalle Cuenta por Cobrar";

    var cliente = Model.FirstOrDefault()?.Cliente;

    decimal totalGeneral = Model.Sum(item =>
    {
        decimal pagado = item.Pagos.Sum(x => x.Monto);
        decimal notas = item.Venta?.NotasCredito.Sum(x => x.TotalDevuelto) ?? 0;
        return item.MontoOriginal - pagado - notas;
    });
}

<style>
    :root {
        --deep-blue: #0B2447;
        --ocean-blue: #19376D;
        --electric-blue: #576CBC;
        --light-bg: #F5F9FF;
        --pure-white: #FFFFFF;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --text-gray: #64748b;
        --border-light: #e2e8f0;
    }

    body {
        background: var(--light-bg);
        font-family: 'Inter', sans-serif;
    }

    .cxc-details-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--deep-blue) 0%, var(--electric-blue) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-subtitle {
        color: var(--text-gray);
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }

    .btn-back {
        background: #f1f5f9;
        color: var(--deep-blue);
        border: none;
        border-radius: 30px;
        padding: 0.6rem 1.5rem;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: var(--deep-blue);
            color: white;
            transform: translateY(-2px);
        }

    .alert-success {
        background: #d1fae5;
        border: 1px solid #a7f3d0;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
        color: var(--success);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .alert-error {
        background: #fee2e2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
        color: var(--danger);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .summary-card {
        background: var(--pure-white);
        border-radius: 16px;
        padding: 1rem;
        border: 1px solid var(--border-light);
    }

    .summary-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--text-gray);
        letter-spacing: 0.3px;
        margin-bottom: 0.3rem;
    }

    .summary-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--deep-blue);
    }

    .summary-total {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--success);
    }

    .table-card {
        background: var(--pure-white);
        border-radius: 20px;
        padding: 1.2rem;
        border: 1px solid var(--border-light);
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--deep-blue);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #eef2f6;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .cxc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        min-width: 900px;
    }

        .cxc-table th {
            background: var(--deep-blue);
            color: white;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 0.8rem 0.5rem;
            white-space: nowrap;
        }

            .cxc-table th:first-child {
                border-radius: 12px 0 0 12px;
            }

            .cxc-table th:last-child {
                border-radius: 0 12px 12px 0;
            }

        .cxc-table td {
            padding: 0.8rem 0.5rem;
            border-bottom: 1px solid #edf2f7;
            vertical-align: middle;
        }

        .cxc-table tbody tr:hover {
            background: rgba(87, 108, 188, 0.02);
        }

    .text-right {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    .text-danger {
        color: var(--danger);
    }

    .text-success {
        color: var(--success);
    }

    .saldo-value {
        font-weight: 700;
        color: var(--deep-blue);
    }

    .badge-success {
        display: inline-block;
        padding: 0.2rem 0.8rem;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .badge-danger {
        display: inline-block;
        padding: 0.2rem 0.8rem;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .badge-warning {
        display: inline-block;
        padding: 0.2rem 0.8rem;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning);
        border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .actions-group {
        display: flex;
        gap: 0.3rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
    }

    .btn-sale {
        background: #f3e8ff;
        color: var(--deep-blue);
    }

        .btn-sale:hover {
            background: var(--deep-blue);
            color: white;
        }

    .btn-pay {
        background: #d1fae5;
        color: var(--success);
    }

        .btn-pay:hover {
            background: var(--success);
            color: white;
        }

    .payments-row {
        background: #f8fafc;
    }

    .payments-box {
        padding: 1rem;
    }

    .payments-title {
        font-weight: 600;
        color: var(--deep-blue);
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
    }

    .payments-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.75rem;
    }

        .payments-table th {
            background: #e2e8f0;
            color: var(--deep-blue);
            padding: 0.4rem;
            text-align: left;
        }

        .payments-table td {
            padding: 0.4rem;
            border-bottom: 1px solid #e2e8f0;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background: var(--pure-white);
        border-radius: 20px;
        padding: 1.5rem;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border-light);
    }

        .modal-header h3 {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--deep-blue);
            margin: 0;
        }

    .modal-close {
        background: #fee2e2;
        color: var(--danger);
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        cursor: pointer;
        font-size: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--deep-blue);
            margin-bottom: 0.3rem;
        }

    .modal-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 1.5rem;
    }

    .btn-cancel {
        background: #f1f5f9;
        color: var(--deep-blue);
        border: none;
        border-radius: 30px;
        padding: 0.6rem 1.5rem;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .btn-save {
        background: linear-gradient(135deg, var(--deep-blue) 0%, var(--electric-blue) 100%);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 0.6rem 1.5rem;
        font-size: 0.85rem;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .cxc-details-container {
            padding: 1rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .actions-group {
            flex-direction: column;
        }

        .btn-action {
            width: 100%;
            justify-content: center;
        }

        .modal-actions {
            flex-direction: column;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="cxc-details-container">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span>💳</span> Estado de Cuenta
            </h1>

            <p class="page-subtitle">
                @(cliente?.Nombre) @(cliente?.Apellidos)
            </p>
        </div>

        <div class="header-actions">
            <a asp-action="Index" class="btn-back">
                ← Volver
            </a>
        </div>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            ✅ @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- RESUMEN -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-label">Cliente</div>
            <div class="summary-value">
                @(cliente?.Nombre) @(cliente?.Apellidos)
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Cédula</div>
            <div class="summary-value">
                @(cliente?.Cedula)
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Comercio</div>
            <div class="summary-value">
                @(cliente?.Comercio)
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Saldo Total</div>
            <div class="summary-total">
                ₡ @totalGeneral.ToString("N2")
            </div>
        </div>

    </div>

    <!-- TABLA -->
    <div class="table-card">

        <div class="section-title">
            <span>📋</span> Cuentas del Cliente
        </div>

        <div class="table-responsive">

            <table class="cxc-table">

                <thead>
                    <tr>
                        <th>Factura</th>
                        <th>Fecha</th>
                        <th>Vence</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Notas Crédito</th>
                        <th class="text-right">Pagado</th>
                        <th class="text-right">Saldo</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        decimal totalPagado = item.Pagos.Sum(x => x.Monto);

                        decimal totalNotas =
                            item.Venta?.NotasCredito.Sum(x => x.TotalDevuelto) ?? 0;

                        decimal saldo =
                            item.MontoOriginal - totalPagado - totalNotas;

                        bool pagada = saldo <= 0;

                        bool vencida =
                            !pagada &&
                            item.FechaVencimiento.HasValue &&
                            item.FechaVencimiento.Value < DateTime.UtcNow;

                        <tr>

                            <td>
                                <strong>#@item.VentaId</strong>
                            </td>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")
                            </td>

                            <td class="text-right">
                                ₡ @item.MontoOriginal.ToString("N2")
                            </td>

                            <td class="text-right text-danger">
                                ₡ @totalNotas.ToString("N2")
                            </td>

                            <td class="text-right text-success">
                                ₡ @totalPagado.ToString("N2")
                            </td>

                            <td class="text-right saldo-value">
                                ₡ @saldo.ToString("N2")
                            </td>

                            <td>

                                @if (pagada)
                                {
                                    <span class="badge-success">
                                        PAGADA
                                    </span>
                                }
                                else if (vencida)
                                {
                                    <span class="badge-danger">
                                        VENCIDA
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-warning">
                                        PENDIENTE
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <div class="actions-group">

                                    <a asp-controller="Ventas"
                                       asp-action="Details"
                                       asp-route-id="@item.VentaId"
                                       class="btn-action btn-sale">

                                        🛒 Venta

                                    </a>

                                    @if (!pagada)
                                    {
                                        <button type="button"
                                                class="btn-action btn-pay"
                                                onclick="abrirPago(@item.Id)">

                                            💵 Abonar

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>

                        @if (item.Pagos.Any())
                        {
                            <tr class="payments-row">

                                <td colspan="9">

                                    <div class="payments-box">

                                        <div class="payments-title">
                                            💰 Historial de Pagos
                                        </div>

                                        <table class="payments-table">

                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Monto</th>
                                                    <th>Método</th>
                                                    <th>Observación</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var pago in item.Pagos.OrderByDescending(x => x.Fecha))
                                                {
                                                    <tr>

                                                        <td>
                                                            @pago.Fecha.ToString("dd/MM/yyyy")
                                                        </td>

                                                        <td>
                                                            ₡ @pago.Monto.ToString("N2")
                                                        </td>

                                                        <td>
                                                            @pago.MetodoPago
                                                        </td>

                                                        <td>
                                                            @pago.Observacion
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- MODAL -->
<div class="modal-overlay" id="paymentModal">

    <div class="modal-content">

        <div class="modal-header">

            <h3>💵 Registrar Pago</h3>

            <button type="button"
                    class="modal-close"
                    onclick="cerrarPago()">
                ✕
            </button>

        </div>

        <form asp-action="RegistrarPago" method="post">

            <input type="hidden"
                   name="cuentaId"
                   id="cuentaIdInput" />

            <div class="form-group">

                <label>Monto</label>

                <input type="number"
                       step="0.01"
                       min="0.01"
                       name="monto"
                       class="form-control"
                       required />

            </div>

            <div class="form-group">

                <label>Método Pago</label>

                <select name="metodoPago"
                        class="form-control">

                    <option value="EFECTIVO">EFECTIVO</option>
                    <option value="SINPE">SINPE</option>
                    <option value="TRANSFERENCIA">TRANSFERENCIA</option>
                    <option value="TARJETA">TARJETA</option>

                </select>

            </div>

            <div class="form-group">

                <label>Observación</label>

                <textarea name="observacion"
                          rows="3"
                          class="form-control"></textarea>

            </div>

            <div class="modal-actions">

                <button type="button"
                        class="btn-cancel"
                        onclick="cerrarPago()">

                    Cancelar

                </button>

                <button type="submit"
                        class="btn-save">

                    💾 Guardar Pago

                </button>

            </div>

        </form>

    </div>

</div>

<script>

    function abrirPago(id) {

        document.getElementById('paymentModal').style.display = 'flex';

        document.getElementById('cuentaIdInput').value = id;
    }

    function cerrarPago() {

        document.getElementById('paymentModal').style.display = 'none';
    }

</script>