@model IEnumerable<CuentaPorCobrar>

@{
    ViewData["Title"] = "Detalle Cuenta por Cobrar";

    var cliente = Model.FirstOrDefault()?.Cliente;
    var empresa = Model.FirstOrDefault()?.Empresa;

    decimal totalGeneral = Model.Sum(item =>
{
    decimal pagado = item.Pagos.Sum(x => x.Monto);
    decimal notas = item.Venta?.NotasCredito.Sum(x => x.TotalDevuelto) ?? 0;

    decimal saldo =
    item.MontoOriginal
    - pagado
    - notas
    - item.DescuentoAplicado;

    return saldo < 1 ? 0 : saldo;
});
}

<link rel="stylesheet" href="~/css/CuentasXCobrar/CuentasDetails.css" />

<div class="cxc-details-container">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span>💳</span> Estado de Cuenta
            </h1>

            <p class="page-subtitle">

                @(cliente?.Nombre) @(cliente?.Apellidos)

                |

                🏢 @(empresa?.Nombre)

            </p>
        </div>

        <div class="header-actions">
            <a asp-action="Index" class="btn-back">
                ← Volver
            </a>
        </div>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            ✅ @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- RESUMEN -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-label">Cliente</div>
            <div class="summary-value">
                @(cliente?.Nombre) @(cliente?.Apellidos)
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Cédula</div>
            <div class="summary-value">
                @(cliente?.Cedula)
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Comercio</div>
            <div class="summary-value">
                @(cliente?.Comercio)
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Saldo Total</div>
            <div class="summary-total">
                ₡ @totalGeneral.ToString("N2")
            </div>
        </div>

        <div class="summary-card">

            <div class="summary-label">

                Empresa

            </div>

            <div class="summary-value">

                @(empresa?.Nombre)

            </div>

        </div>

    </div>

    <!-- TABLA -->
    <div class="table-card">

        <div class="section-title">
            <span>📋</span> Cuentas del Cliente
        </div>

        <div class="table-responsive">

            <table class="cxc-table">

                <thead>
                    <tr>
                        <th>Factura</th>
                        <th>Fecha</th>
                        <th>Vence</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Notas Crédito</th>
                        <th class="text-right">Pagado</th>
                        <th class="text-right">Saldo</th>
                        <th>Descuento</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        decimal totalPagado = item.Pagos.Sum(x => x.Monto);

                        decimal totalNotas =
                            item.Venta?.NotasCredito.Sum(x => x.TotalDevuelto) ?? 0;

                        decimal saldo =
                            item.MontoOriginal
                            - totalPagado
                            - totalNotas
                            - item.DescuentoAplicado;

                        if (saldo < 1)
                        {
                            saldo = 0;
                        }

                        bool pagada = saldo <= 0;

                        bool vencida =
                            !pagada &&
                            item.FechaVencimiento.HasValue &&
                            item.FechaVencimiento.Value < DateTime.UtcNow;

                        <tr>

                            <td>
                                <strong>#@item.VentaId</strong>
                            </td>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")
                            </td>

                            <td class="text-right">
                                ₡ @item.MontoOriginal.ToString("N2")
                            </td>

                            <td class="text-right text-danger">
                                ₡ @totalNotas.ToString("N2")
                            </td>

                            <td class="text-right text-success">
                                ₡ @totalPagado.ToString("N2")
                            </td>

                            <td class="text-right saldo-value">
                                ₡ @saldo.ToString("N2")
                            </td>

                            <td> @if (item.DescuentoOtorgado)
                                {
                                    <span class="badge-success">

                                        ✅ Aplicado

                                    </span>

                                    <br />

                                    <small>

                                        ₡ @item.DescuentoAplicado.ToString("N0")

                                    </small>
                                }
                                else
                                {
                                    decimal descuento = Math.Round(
                                        item.MontoOriginal * 0.10m,
                                        0,
                                        MidpointRounding.AwayFromZero);

                                    decimal montoConDescuento =
                                        item.MontoOriginal - descuento;

                                    decimal falta =
                                        montoConDescuento - totalPagado;

                                    if (DateTime.UtcNow <= item.Fecha.AddDays(60))
                                    {
                                        if (falta < 0)
                                        {
                                            falta = 0;
                                        }

                                        <span class="badge-warning">

                                            🎁 Faltan

                                            ₡ @falta.ToString("N0")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">

                                            ⌛ Vencido

                                        </span>
                                    }
                                }

                            </td>

                            <td>

                                @if (pagada)
                                {
                                    <span class="badge-success">
                                        PAGADA
                                    </span>
                                }
                                else if (vencida)
                                {
                                    <span class="badge-danger">
                                        VENCIDA
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-warning">
                                        PENDIENTE
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <div class="actions-group">

                                    <a asp-controller="Ventas"
                                       asp-action="Details"
                                       asp-route-id="@item.VentaId"
                                       class="btn-action btn-sale">

                                        🛒 Venta

                                    </a>

                                    @if (!pagada)
                                    {
                                        <button type="button"
                                                class="btn-action btn-pay"
                                                onclick="abrirPago(@item.Id)">

                                            💵 Abonar

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>

                        @if (item.Pagos.Any())
                        {
                            <tr class="payments-row">

                                <td colspan="10">

                                    <div class="payments-box">

                                        <div class="payments-title">
                                            💰 Historial de Pagos
                                        </div>

                                        <table class="payments-table">

                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Monto</th>
                                                    <th>Método</th>
                                                    <th>Observación</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var pago in item.Pagos.OrderByDescending(x => x.Fecha))
                                                {
                                                    <tr>

                                                        <td>
                                                            @pago.Fecha.ToString("dd/MM/yyyy")
                                                        </td>

                                                        <td>
                                                            ₡ @pago.Monto.ToString("N2")
                                                        </td>

                                                        <td>
                                                            @pago.MetodoPago
                                                        </td>

                                                        <td>
                                                            @pago.Observacion
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- MODAL -->
<div class="modal-overlay" id="paymentModal">

    <div class="modal-content">

        <div class="modal-header">

            <h3>💵 Registrar Pago</h3>

            <button type="button"
                    class="modal-close"
                    onclick="cerrarPago()">
                ✕
            </button>

        </div>

        <form asp-action="RegistrarPago" method="post">

            <input type="hidden"
                   name="cuentaId"
                   id="cuentaIdInput" />

            <div class="form-group">

                <label>Monto</label>

                <input type="number"
                       step="0.01"
                       min="0.01"
                       name="monto"
                       class="form-control"
                       required />

            </div>

            <div class="form-group">

                <label>Método Pago</label>

                <select name="metodoPago"
                        class="form-control">

                    <option value="EFECTIVO">EFECTIVO</option>
                    <option value="SINPE">SINPE</option>
                    <option value="TRANSFERENCIA">TRANSFERENCIA</option>
                    <option value="TARJETA">TARJETA</option>

                </select>

            </div>

            <div class="form-group">

                <label>Observación</label>

                <textarea name="observacion"
                          rows="3"
                          class="form-control"></textarea>

            </div>

            <div class="modal-actions">

                <button type="button"
                        class="btn-cancel"
                        onclick="cerrarPago()">

                    Cancelar

                </button>

                <button type="submit"
                        class="btn-save">

                    💾 Guardar Pago

                </button>

            </div>

        </form>

    </div>

</div>



<script>
    let cuentaActual = 0;

function abrirPago(id)
{
    cuentaActual = id;

    document.getElementById(
        "cuentaIdInput"
    ).value = id;

    document.getElementById(
        "paymentModal"
    ).style.display = "flex";
}

function cerrarPago()
{
    document.getElementById(
        "paymentModal"
    ).style.display = "none";
}

</script>