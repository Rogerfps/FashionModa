@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Cuentas por Cobrar";

    int paginaActual = ViewBag.PaginaActual != null
        ? (int)ViewBag.PaginaActual : 1;

    int totalPaginas = ViewBag.TotalPaginas != null
        ? (int)ViewBag.TotalPaginas : 0;

    int totalRegistros = ViewBag.TotalRegistros != null
        ? (int)ViewBag.TotalRegistros : Model.Count();

    int pageSize = ViewBag.PageSize != null
        ? (int)ViewBag.PageSize : 10;

    int desde = totalRegistros == 0
        ? 0 : ((paginaActual - 1) * pageSize) + 1;

    int hasta = Math.Min(paginaActual * pageSize, totalRegistros);
}

<link rel="stylesheet" href="~/css/CuentasXCobrar/CuentasIndex.css" />

<div class="cxc-container">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span>💰</span> Cuentas por Cobrar
            </h1>
            <p class="page-subtitle">
                Resumen general de clientes con saldo pendiente
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-action="ExportarExcel"
               asp-route-buscar="@ViewBag.Buscar"
               asp-route-empresaId="@ViewBag.EmpresaId"
               asp-route-estado="@ViewBag.Estado"
               asp-route-antiguedad="@ViewBag.Antiguedad"
               class="btn-exportar-excel">
                📊 Descargar Excel
            </a>

            <a asp-action="ProximosVencimientos"
               class="btn-proximos-vencimientos">
                🔔 Próximos vencimientos
            </a>
        </div>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            ✅ @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            ⚠️ @TempData["Error"]
        </div>
    }

    <!-- FILTROS -->
    <div class="filters-card">
        <form method="get" asp-action="Index" class="filters-grid">

            <div class="filter-group">
                <label>🔍 Buscar</label>
                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Código, cliente, comercio o cédula..."
                       oninput="clearTimeout(window.t); window.t = setTimeout(() => this.form.requestSubmit(), 2000);" />
            </div>

            <div class="filter-group">
                <label>🏢 Empresa</label>
                <select name="empresaId"
                        class="form-control"
                        onchange="this.form.requestSubmit()">
                    <option value="0"
                            selected="@(ViewBag.EmpresaId != null && (int)ViewBag.EmpresaId == 0)">
                        Todas las empresas
                    </option>

                    @foreach (var empresa in ViewBag.Empresas)
                    {
                        <option value="@empresa.Id"
                                selected="@(ViewBag.EmpresaId != null && (int)ViewBag.EmpresaId == empresa.Id)">
                            @empresa.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>Estado</label>
                <select name="estado"
                        class="form-control"
                        onchange="this.form.requestSubmit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Estado))">
                        Todos
                    </option>
                    <option value="Pendiente" selected="@(ViewBag.Estado == "Pendiente")">
                        Pendientes
                    </option>
                    <option value="Vencida" selected="@(ViewBag.Estado == "Vencida")">
                        Vencidas
                    </option>
                    <option value="Pagada" selected="@(ViewBag.Estado == "Pagada")">
                        Pagadas
                    </option>
                </select>
            </div>

            <div class="filter-group">
                <label>⏰ Antigüedad</label>
                <select name="antiguedad"
                        class="form-control"
                        onchange="this.form.requestSubmit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Antiguedad))">
                        Todas
                    </option>
                    <option value="menos30" selected="@(ViewBag.Antiguedad == "menos30")">
                        Menos de 30 días
                    </option>
                    <option value="30a60" selected="@(ViewBag.Antiguedad == "30a60")">
                        30 a 60 días
                    </option>
                    <option value="61a89" selected="@(ViewBag.Antiguedad == "61a89")">
                        61 a 89 días
                    </option>
                    <option value="90a199" selected="@(ViewBag.Antiguedad == "90a199")">
                        90 a 199 días
                    </option>
                    <option value="200mas" selected="@(ViewBag.Antiguedad == "200mas")">
                        200+ días
                    </option>
                </select>
            </div>

            <div class="filters-buttons">
                <button type="submit" class="btn btn-primary">
                    🔍 Buscar
                </button>

                <a asp-action="Index"
                   asp-route-empresaId="0"
                   class="btn btn-secondary">
                    ✖ Limpiar
                </a>
            </div>
        </form>
    </div>

    <!-- TABLA -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="clientes-table" id="clientesTable">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Empresa</th>
                        <th>Cédula</th>
                        <th class="text-center">Facturas</th>
                        <th class="text-right">Saldo Total</th>
                        <th class="text-center">Días de Mora</th>
                        <th>Estado</th>
                        <th class="text-center">Details</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="cliente-codigo">
                                @item.CodigoCliente
                            </td>

                            <td class="cliente-nombre">
                                <strong>@item.Nombre</strong>

                                @if (!string.IsNullOrWhiteSpace((string?)item.Comercio))
                                {
                                    <div class="cliente-comercio">
                                        @item.Comercio
                                    </div>
                                }
                            </td>

                            <td class="empresa">@item.Empresa</td>

                            <td class="cliente-cedula">@item.ClienteCedula</td>

                            <td class="text-center">
                                <span class="facturas-count">
                                    @item.CantidadFacturas
                                </span>
                            </td>

                            <td class="text-right saldo-total">
                                ₡ @(((decimal)item.Saldo).ToString("N2"))

                                @if ((decimal)item.SaldoVencido > 0)
                                {
                                    <div class="saldo-vencido">
                                        Vencido:
                                        ₡ @(((decimal)item.SaldoVencido).ToString("N2"))
                                    </div>
                                }
                            </td>

                            <td class="text-center">
                                @if ((int)item.DiasMora > 0)
                                {
                                    <span class="dias-mora-badge">
                                        @item.DiasMora días
                                    </span>
                                }
                                else
                                {
                                    <span class="dias-mora-cero">0 días</span>
                                }
                            </td>

                            <td>
                                @if (item.Estado == "Pagada")
                                {
                                    <span class="badge-success">✓ PAGADA</span>
                                }
                                else if (item.Estado == "Vencida")
                                {
                                    <span class="badge-danger">⚠ VENCIDA</span>

                                    @if ((int)item.DiasVencidos > 0)
                                    {
                                        <div class="dias-vencidos">
                                            @item.DiasVencidos días
                                        </div>
                                    }
                                }
                                else if (item.Estado == "Pago parcial")
                                {
                                    <span class="badge-info">◐ PAGO PARCIAL</span>
                                }
                                else
                                {
                                    <span class="badge-warning">⏳ PENDIENTE</span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="actions-group">
                                    <a asp-action="Details"
                                       asp-route-clienteCedula="@item.ClienteCedula"
                                       asp-route-empresaId="@item.EmpresaId"
                                       class="btn-action btn-details">
                                        📄 Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                No se encontraron cuentas con los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINACIÓN -->
    <div class="pagination-container">
        <div class="pagination-info">
            Mostrando <strong>@desde–@hasta</strong>
            de <strong>@totalRegistros</strong> clientes
        </div>

        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación de cuentas por cobrar">
                <ul class="pagination">

                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-empresaId="@ViewBag.EmpresaId"
                           asp-route-estado="@ViewBag.Estado"
                           asp-route-antiguedad="@ViewBag.Antiguedad">
                            «
                        </a>
                    </li>

                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(paginaActual - 1)"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-empresaId="@ViewBag.EmpresaId"
                           asp-route-estado="@ViewBag.Estado"
                           asp-route-antiguedad="@ViewBag.Antiguedad">
                            Anterior
                        </a>
                    </li>

                    @{
                        int inicio = Math.Max(1, paginaActual - 2);
                        int fin = Math.Min(totalPaginas, paginaActual + 2);
                    }

                    @for (int i = inicio; i <= fin; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-buscar="@ViewBag.Buscar"
                               asp-route-empresaId="@ViewBag.EmpresaId"
                               asp-route-estado="@ViewBag.Estado"
                               asp-route-antiguedad="@ViewBag.Antiguedad">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(paginaActual + 1)"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-empresaId="@ViewBag.EmpresaId"
                           asp-route-estado="@ViewBag.Estado"
                           asp-route-antiguedad="@ViewBag.Antiguedad">
                            Siguiente
                        </a>
                    </li>

                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPaginas"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-empresaId="@ViewBag.EmpresaId"
                           asp-route-estado="@ViewBag.Estado"
                           asp-route-antiguedad="@ViewBag.Antiguedad">
                            »
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>

</div>
