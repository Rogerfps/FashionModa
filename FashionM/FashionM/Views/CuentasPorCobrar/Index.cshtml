@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Cuentas por Cobrar";
}

<style>

    :root {
        --deep-blue: #0B2447;
        --ocean-blue: #19376D;
        --electric-blue: #576CBC;
        --light-bg: #F5F9FF;
        --pure-white: #FFFFFF;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --text-gray: #64748b;
        --border-light: #e2e8f0;
    }

    body {
        background: var(--light-bg);
        font-family: 'Inter', sans-serif;
    }

    .cxc-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    /* ========================================
           HEADER
        ======================================== */

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient( 135deg, var(--deep-blue) 0%, var(--electric-blue) 100% );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-subtitle {
        color: var(--text-gray);
        font-size: 0.9rem;
        margin-top: 0.4rem;
    }

    /* ========================================
           ALERTAS
        ======================================== */

    .alert-success,
    .alert-error {
        padding: 1rem 1.2rem;
        border-radius: 14px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .alert-success {
        background: #d1fae5;
        border: 1px solid #a7f3d0;
        color: var(--success);
    }

    .alert-error {
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: var(--danger);
    }

    /* ========================================
           FILTROS
        ======================================== */

    .filters-card {
        background: var(--pure-white);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid var(--border-light);
        box-shadow: 0 4px 14px rgba(0,0,0,0.03);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .filter-group label {
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--deep-blue);
            letter-spacing: 0.4px;
        }

    .form-control {
        width: 100%;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        transition: 0.2s ease;
        background: #fafcff;
    }

        .form-control:focus {
            border-color: var(--electric-blue);
            outline: none;
            box-shadow: 0 0 0 4px rgba(87,108,188,0.12);
        }

    /* ========================================
           TABLA
        ======================================== */

    .table-card {
        background: var(--pure-white);
        border-radius: 22px;
        padding: 1.5rem;
        border: 1px solid var(--border-light);
        box-shadow: 0 4px 18px rgba(0,0,0,0.03);
    }

    .table-responsive {
        overflow-x: auto;
    }

    .clientes-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 900px;
    }

        .clientes-table thead th {
            background: var(--deep-blue);
            color: white;
            padding: 1rem;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 600;
            white-space: nowrap;
        }

            .clientes-table thead th:first-child {
                border-radius: 16px 0 0 16px;
            }

            .clientes-table thead th:last-child {
                border-radius: 0 16px 16px 0;
            }

        .clientes-table tbody td {
            padding: 1.1rem 1rem;
            border-bottom: 1px solid #edf2f7;
            vertical-align: middle;
            background: white;
        }

        .clientes-table tbody tr:hover td {
            background: rgba(87,108,188,0.03);
        }

    /* ========================================
           TEXTOS
        ======================================== */

    .cliente-nombre {
        font-weight: 700;
        color: var(--deep-blue);
        font-size: 1rem;
    }

    .cliente-cedula {
        color: var(--text-gray);
        font-family: monospace;
        font-size: 0.95rem;
    }

    .saldo-total {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--deep-blue);
    }

    .text-right {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    /* ========================================
           BADGES
        ======================================== */

    .badge-success,
    .badge-warning {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem 1rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-success {
        background: rgba(16,185,129,0.12);
        color: var(--success);
        border: 1px solid rgba(16,185,129,0.2);
    }

    .badge-warning {
        background: rgba(245,158,11,0.12);
        color: var(--warning);
        border: 1px solid rgba(245,158,11,0.2);
    }

    /* ========================================
           BOTONES
        ======================================== */

    .actions-group {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
        border: none;
    }

    .btn-details {
        background: #e6f0fa;
        color: var(--info);
    }

        .btn-details:hover {
            background: var(--info);
            color: white;
        }

    /* ========================================
           RESPONSIVE
        ======================================== */

    @@media (max-width: 768px) {
        .cxc-container {
            padding: 1rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .clientes-table {
            min-width: 700px;
        }

        .btn-action {
            width: 100%;
        }

        .actions-group {
            flex-direction: column;
        }
    }

    .filters-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1rem;
    }

    @@media(max-width:768px) {

        .filters-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="cxc-container">

    <!-- HEADER -->
    <div class="page-header">

        <div>

            <h1 class="page-title">

                <span>💰</span>

                Cuentas por Cobrar

            </h1>

            <p class="page-subtitle">

                Resumen general de clientes con saldo pendiente

            </p>

        </div>

    </div>

    <!-- ALERTAS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">

            ✅ @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">

            ⚠️ @TempData["Error"]

        </div>
    }

    <!-- FILTROS -->
    <div class="filters-card">

        <form method="get" class="filters-grid">

            <div class="filter-group">

                <label>🔍 Buscar</label>

                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Cliente, comercio..."
                       oninput="clearTimeout(window.t); window.t = setTimeout(() => this.form.submit(), 2000);" />

            </div>

            <div class="filter-group">

                <label>🏢 Empresa</label>

                <select name="empresaId"
                        class="form-control"
                        onchange="this.form.submit()">

                    <option value="0"
                            selected="@(ViewBag.EmpresaId != null && (int)ViewBag.EmpresaId == 0)">
                        Todas las empresas
                    </option>

                    @foreach (var empresa in ViewBag.Empresas)
                    {
                        <option value="@empresa.Id"
                                selected="@(ViewBag.EmpresaId != null && (int)ViewBag.EmpresaId == empresa.Id)">
                            @empresa.Nombre
                        </option>
                    }

                </select>

            </div>

            <div class="filter-group">

                <label>Estado</label>

                <select name="estado"
                        class="form-control"
                        onchange="this.form.submit()">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(ViewBag.Estado))">
                        Todos
                    </option>

                    <option value="Pendiente"
                            selected="@(ViewBag.Estado == "Pendiente")">
                        Pendientes
                    </option>

                    <option value="Pagada"
                            selected="@(ViewBag.Estado == "Pagada")">
                        Pagadas
                    </option>

                </select>


            </div>


            <div class="filter-group d-flex align-items-end">

                <button type="submit" class="btn btn-primary me-2">
                    🔍 Buscar
                </button>

                <a asp-action="Index"
                   asp-route-empresaId="0"
                   class="btn btn-secondary">
                    ✖ Limpiar
                </a>

            </div>

        </form>

    </div>

    <!-- TABLA -->
    <div class="table-card">

        <div class="table-responsive">

            <table class="clientes-table"
                   id="clientesTable">

                <thead>

                    <tr>

                        <th>Cliente</th>

                        <th>Empresa</th>

                        <th>Cédula</th>

                        <th class="text-right">
                            Saldo Total
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- CLIENTE -->
                            <td class="cliente-nombre">

                                @item.Nombre

                            </td>

                            <td class="empresa">

                                @item.Empresa

                            </td>

                            <!-- CEDULA -->
                            <td class="cliente-cedula">

                                @item.ClienteCedula

                            </td>

                            <!-- SALDO -->
                            <td class="text-right saldo-total">

                                ₡ @(((decimal)item.Saldo)
                                                                    .ToString("N2"))

                            </td>

                            <!-- ESTADO -->
                            <td>

                                @if ((decimal)item.Saldo <= 0)
                                {
                                    <span class="badge-success">

                                        PAGADA

                                    </span>
                                }
                                else
                                {
                                    <span class="badge-warning">

                                        PENDIENTE

                                    </span>
                                }

                            </td>

                            <!-- ACCIONES -->
                            <td class="text-center">

                                <div class="actions-group">

                                    <a asp-action="Details"
                                       asp-route-clienteCedula="@item.ClienteCedula"
                                       asp-route-empresaId="@item.EmpresaId"
                                       class="btn-action btn-details">

                                        📄 Details

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

