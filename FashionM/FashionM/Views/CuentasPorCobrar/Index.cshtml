@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Cuentas por Cobrar";
}

<link rel="stylesheet" href="~/css/CuentasXCobrar/CuentasIndex.css" />

<div class="cxc-container">

    <!-- HEADER -->
    <div class="page-header">

        <div>

            <h1 class="page-title">

                <span>💰</span>

                Cuentas por Cobrar

            </h1>

            <p class="page-subtitle">

                Resumen general de clientes con saldo pendiente

            </p>

        </div>

    </div>

    <!-- ALERTAS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">

            ✅ @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">

            ⚠️ @TempData["Error"]

        </div>
    }

    <!-- FILTROS -->
    <div class="filters-card">

        <form method="get" class="filters-grid">

            <div class="filter-group">

                <label>🔍 Buscar</label>

                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Cliente, comercio..."
                       oninput="clearTimeout(window.t); window.t = setTimeout(() => this.form.submit(), 2000);" />

            </div>

            <div class="filter-group">

                <label>🏢 Empresa</label>

                <select name="empresaId"
                        class="form-control"
                        onchange="this.form.submit()">

                    <option value="0"
                            selected="@(ViewBag.EmpresaId != null && (int)ViewBag.EmpresaId == 0)">
                        Todas las empresas
                    </option>

                    @foreach (var empresa in ViewBag.Empresas)
                    {
                        <option value="@empresa.Id"
                                selected="@(ViewBag.EmpresaId != null && (int)ViewBag.EmpresaId == empresa.Id)">
                            @empresa.Nombre
                        </option>
                    }

                </select>

            </div>

            <div class="filter-group">

                <label>Estado</label>

                <select name="estado"
                        class="form-control"
                        onchange="this.form.submit()">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(ViewBag.Estado))">
                        Todos
                    </option>

                    <option value="Pendiente"
                            selected="@(ViewBag.Estado == "Pendiente")">
                        Pendientes
                    </option>

                    <option value="Pagada"
                            selected="@(ViewBag.Estado == "Pagada")">
                        Pagadas
                    </option>

                </select>


            </div>


            <div class="filter-group d-flex align-items-end">

                <button type="submit" class="btn btn-primary me-2">
                    🔍 Buscar
                </button>

                <a asp-action="Index"
                   asp-route-empresaId="0"
                   class="btn btn-secondary">
                    ✖ Limpiar
                </a>

            </div>

        </form>

    </div>

    <!-- TABLA -->
    <div class="table-card">

        <div class="table-responsive">

            <table class="clientes-table"
                   id="clientesTable">

                <thead>

                    <tr>

                        <th>Cliente</th>

                        <th>Empresa</th>

                        <th>Cédula</th>

                        <th class="text-right">
                            Saldo Total
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- CLIENTE -->
                            <td class="cliente-nombre">

                                @item.Nombre

                            </td>

                            <td class="empresa">

                                @item.Empresa

                            </td>

                            <!-- CEDULA -->
                            <td class="cliente-cedula">

                                @item.ClienteCedula

                            </td>

                            <!-- SALDO -->
                            <td class="text-right saldo-total">

                                ₡ @(((decimal)item.Saldo)
                                                                    .ToString("N2"))

                            </td>

                            <!-- ESTADO -->
                            <td>

                                @if ((decimal)item.Saldo <= 0)
                                {
                                    <span class="badge-success">

                                        PAGADA

                                    </span>
                                }
                                else
                                {
                                    <span class="badge-warning">

                                        PENDIENTE

                                    </span>
                                }

                            </td>

                            <!-- ACCIONES -->
                            <td class="text-center">

                                <div class="actions-group">

                                    <a asp-action="Details"
                                       asp-route-clienteCedula="@item.ClienteCedula"
                                       asp-route-empresaId="@item.EmpresaId"
                                       class="btn-action btn-details">

                                        📄 Details

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

