@model FashionM.Models.Inventario

@{
    ViewData["Title"] = "Nuevo Inventario";
}

<link rel="stylesheet" href="~/css/Inventario/InventarioCreate.css" />

<!-- HEADER MINI -->
<div class="neo-header">
    <div class="container d-flex justify-content-between align-items-center px-3">
        <h1 class="title-glow">✨ Nuevo</h1>
        <a asp-action="Index" class="back-link">←</a>
    </div>
</div>

<div class="container px-3" style="max-width: 900px;">
    <div class="form-card">

        <div asp-validation-summary="All" class="validation-summary"></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <!-- GRID -->
            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Codigo"></label>
                    <input asp-for="Codigo" class="form-control" />
                    <span asp-validation-for="Codigo" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SKU"></label>
                    <input asp-for="SKU" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Marca"></label>
                    <input asp-for="Marca" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="PrecioCosto"></label>
                    <input asp-for="PrecioCosto"
                           type="number"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="PrecioVenta"></label>
                    <input asp-for="PrecioVenta"
                           type="number"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="CodigoCabys"></label>
                    <input asp-for="CodigoCabys" class="form-control" />
                </div>

                <!-- 🔥 PROVEEDOR NUEVO -->
                <div class="form-group position-relative">
                    <label>Proveedor</label>

                    <input type="text"
                           id="proveedorBuscar"
                           class="form-control"
                           placeholder="Buscar proveedor..."
                           autocomplete="off" />

                    <!-- 🔥 NUEVO -->
                    <input type="hidden"
                           asp-for="ProveedorCatalogoId"
                           id="proveedorId"
                           required />

                    <div id="listaProveedores" class="list-group"></div>
                </div>

                <!-- EMPRESA -->
                <div class="form-group">
                    <label class="form-label">Empresa</label>

                    <div class="radio-group">

                        <label class="radio-option">
                            <input type="radio"
                                   asp-for="Empresa"
                                   value="Cocalza Plus S.A"
                                   required />
                            <span>Cocalza Plus S.A</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio"
                                   asp-for="Empresa"
                                   value="Fashion Shoes S.A" />
                            <span>Fashion Shoes S.A</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio"
                                   asp-for="Empresa"
                                   value="LSG Moda S.A" />
                            <span>LSG Moda S.A</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio"
                                   asp-for="Empresa"
                                   value="Maxi Plus 23 S.A" />
                            <span>Maxi Plus 23 S.A</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio"
                                   asp-for="Empresa"
                                   value="KYROZ" />
                            <span>KYROZ</span>
                        </label>

                    </div>

                    <span asp-validation-for="Empresa"
                          class="validation-error"></span>
                </div>

            </div>

            <!-- ========================================= -->
            <!-- GENERADOR DE VARIANTES -->
            <!-- ========================================= -->

            <div class="section-title">⚙️ Generador de Variantes</div>

            <div class="form-grid">

                <div class="form-group">
                    <label>Tipo de Zapato</label>

                    <select id="tipoZapato" class="form-control">
                        <option value="">Seleccione...</option>
                        <option value="adulto">Adulto (34 - 44)</option>
                        <option value="nino">Niño (15 - 36)</option>
                        <option value="personalizado">Personalizado</option>
                    </select>
                </div>

                <div class="form-group rangoPersonalizado d-none">
                    <label>Desde</label>
                    <input type="number"
                           id="tallaInicio"
                           class="form-control"
                           value="34" />
                </div>

                <div class="form-group rangoPersonalizado d-none">
                    <label>Hasta</label>
                    <input type="number"
                           id="tallaFin"
                           class="form-control"
                           value="44" />
                </div>

            </div>

            <hr />

            <!-- ========================================= -->
            <!-- COLORES -->
            <!-- ========================================= -->

            <div class="section-title">🎨 Colores</div>

            <div id="coloresContainer">

                <div class="d-flex gap-2 mb-2 color-row">

                    <input type="text"
                           class="form-control color-input"
                           placeholder="Ej: Negro" />

                    <button type="button"
                            class="btn-remove"
                            onclick="eliminarColor(this)">
                        ✕
                    </button>

                </div>

            </div>

            <button type="button"
                    class="btn-add"
                    onclick="agregarColor()">
                ➕ Agregar Color
            </button>

            <hr />

            <!-- ========================================= -->
            <!-- DETALLES -->
            <!-- ========================================= -->

            <div class="section-title">📝 Detalles</div>

            <div id="detallesContainer">

                <div class="d-flex gap-2 mb-2 detalle-row">

                    <input type="text"
                           class="form-control detalle-input"
                           placeholder="Ej: Charol (Opcional)" />

                    <button type="button"
                            class="btn-remove"
                            onclick="eliminarDetalle(this)">
                        ✕
                    </button>

                </div>

            </div>

            <button type="button"
                    class="btn-add"
                    onclick="agregarDetalle()">
                ➕ Agregar Detalle
            </button>

            <hr />

            <div class="text-center mb-4">

                <button type="button"
                        class="btn-primary"
                        onclick="generarVariantes()">

                    ⚡ Generar Variantes

                </button>

            </div>

            <!-- ========================================= -->
            <!-- TABLA DE VARIANTES -->
            <!-- ========================================= -->

            <div class="section-title">📏 Variantes Generadas</div>

            <table class="tallas-table" id="tablaTallas">

                <thead>

                    <tr>

                        <th>Color</th>

                        <th>Detalle</th>

                        <th>Talla</th>

                        <th>Cantidad</th>

                        <th>Precio</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>
                </tbody>

            </table>

            <button type="button"
                    class="btn-add"
                    onclick="agregarTalla()">
                ➕ Agregar Variante
            </button>

            <!-- FOTOS -->
            <div class="section-title">📸 Fotos</div>

            <input type="file"
                   name="imagenes"
                   multiple
                   class="file-input" />

            <!-- BOTONES -->
            <div class="action-buttons">
                <a asp-action="Index"
                       class="btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-primary">
                    💾 Guardar
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts{

<partial name="_ValidationScriptsPartial" />

<script>

    //==========================================
    // VARIABLES
    //==========================================

    let idx = 0;

    //==========================================
    // TIPO DE ZAPATO
    //==========================================

    document.getElementById("tipoZapato")
        .addEventListener("change", function () {

            const personalizado =
                this.value === "personalizado";

            document
                .querySelectorAll(".rangoPersonalizado")
                .forEach(x => {

                    x.classList.toggle("d-none", !personalizado);

                });

        });

    //==========================================
    // COLORES
    //==========================================

    function agregarColor() {

        const container =
            document.getElementById("coloresContainer");

        container.insertAdjacentHTML("beforeend", `

            <div class="d-flex gap-2 mb-2 color-row">

                <input type="text"
                       class="form-control color-input"
                       placeholder="Ej: Negro" />

                <button type="button"
                        class="btn-remove"
                        onclick="eliminarColor(this)">
                    ✕
                </button>

            </div>

        `);

    }

    function eliminarColor(btn) {

        const filas =
            document.querySelectorAll(".color-row");

        if (filas.length == 1) {

            btn.parentElement
                .querySelector("input")
                .value = "";

            return;

        }

        btn.parentElement.remove();

    }

    //==========================================
    // DETALLES
    //==========================================

    function agregarDetalle() {

        const container =
            document.getElementById("detallesContainer");

        container.insertAdjacentHTML("beforeend", `

            <div class="d-flex gap-2 mb-2 detalle-row">

                <input type="text"
                       class="form-control detalle-input"
                       placeholder="Ej: Charol" />

                <button type="button"
                        class="btn-remove"
                        onclick="eliminarDetalle(this)">
                    ✕
                </button>

            </div>

        `);

    }

    function eliminarDetalle(btn) {

        const filas =
            document.querySelectorAll(".detalle-row");

        if (filas.length == 1) {

            btn.parentElement
                .querySelector("input")
                .value = "";

            return;

        }

        btn.parentElement.remove();

    }

    //==========================================
    // OBTENER RANGO DE TALLAS
    //==========================================

    function obtenerTallas() {

        const tipo =
            document.getElementById("tipoZapato").value;

        let inicio = 34;
        let fin = 44;

        if (tipo === "nino") {

            inicio = 15;
            fin = 36;

        }

        if (tipo === "personalizado") {

            inicio = parseInt(
                document.getElementById("tallaInicio").value);

            fin = parseInt(
                document.getElementById("tallaFin").value);

        }

        const tallas = [];

        for (let i = inicio; i <= fin; i++) {

            tallas.push(i.toString());

        }

        return tallas;

    }

    //==========================================
    // OBTENER COLORES
    //==========================================

    function obtenerColores() {

        let colores = [];

        document
            .querySelectorAll(".color-input")
            .forEach(x => {

                const valor = x.value.trim();

                if (valor != "")
                    colores.push(valor);

            });

        return [...new Set(colores)];

    }

    //==========================================
    // OBTENER DETALLES
    //==========================================

    function obtenerDetalles() {

        let detalles = [];

        document
            .querySelectorAll(".detalle-input")
            .forEach(x => {

                const valor = x.value.trim();

                if (valor != "")
                    detalles.push(valor);

            });

        if (detalles.length == 0)
            detalles.push("");

        return [...new Set(detalles)];

    }

                //==========================================
            // GENERAR VARIANTES
            //==========================================

            function generarVariantes() {

                const tabla = document.querySelector("#tablaTallas tbody");

                    if (tabla.children.length > 0) {

                        if (!confirm("Ya existen variantes.\n\nSe perderán las variantes agregadas manualmente.\n\n¿Desea continuar?"))
                            return;

        }

                tabla.innerHTML = "";

                idx = 0;

                const precio = document.getElementById("PrecioVenta").value;

                if (precio == "") {

                    alert("Debe indicar el Precio de Venta.");

                    return;

                }

                const tipo =
                    document.getElementById("tipoZapato").value;

                if (tipo == "") {

                    alert("Seleccione el tipo de zapato.");

                    return;

                }

                const colores = obtenerColores();

                if (colores.length == 0) {

                    alert("Debe agregar al menos un color.");

                    return;

                }

                const detalles = obtenerDetalles();

                const tallas = obtenerTallas();

                colores.forEach(color => {

                    detalles.forEach(detalle => {

                        tallas.forEach(talla => {

                            crearFila(
                                color,
                                detalle,
                                talla,
                                precio
                            );

                        });

                    });

                });

            }

            //==========================================
            // CREAR FILA
            //==========================================

            function crearFila(
                color,
                detalle,
                talla,
                precio) {

                const tabla =
                    document.querySelector("#tablaTallas tbody");

                tabla.insertAdjacentHTML("beforeend", `

        <tr>

        <td>

        <input type="text"
               class="form-control"
               name="Tallas[${idx}].Color"
               value="${color}"
               readonly />

        </td>

        <td>

            <input type="text"
           class="form-control"
           name="Tallas[${idx}].Detalle"
           value="${detalle}" />

        </td>

        <td>

        <input type="text"
               class="form-control"
               name="Tallas[${idx}].Numero"
               value="${talla}"
               readonly />

        </td>

        <td>

        <input type="number"
               class="form-control"
               name="Tallas[${idx}].Cantidad"
               value="0" />

        </td>

        <td>

        <input type="number"
               class="form-control precio-variante"
               step="0.01"
               name="Tallas[${idx}].Precio"
               value="${precio}" />

        </td>

        <td>

        <button type="button"
                class="btn-remove"
                onclick="eliminarFila(this)">

        ✕

        </button>

        </td>

        </tr>

                `);

                idx++;

            }

            //==========================================
            // ELIMINAR FILA
            //==========================================

            function eliminarFila(btn) {

                btn.closest("tr").remove();

                reindexar();

            }

            //==========================================
            // REINDEXAR MVC
            //==========================================

            function reindexar() {

                const filas =
                    document.querySelectorAll("#tablaTallas tbody tr");

                idx = 0;

                filas.forEach(fila => {

                    fila.querySelector('[name$=".Color"]')
                        .name = `Tallas[${idx}].Color`;

                    fila.querySelector('[name$=".Detalle"]')
                        .name = `Tallas[${idx}].Detalle`;

                    fila.querySelector('[name$=".Numero"]')
                        .name = `Tallas[${idx}].Numero`;

                    fila.querySelector('[name$=".Cantidad"]')
                        .name = `Tallas[${idx}].Cantidad`;

                    fila.querySelector('[name$=".Precio"]')
                        .name = `Tallas[${idx}].Precio`;

                    idx++;

                });

            }

            //==========================================
            // ACTUALIZAR PRECIOS
            //==========================================

            document.getElementById("PrecioVenta")
                .addEventListener("change", function () {

                    const cajas =
                        document.querySelectorAll(".precio-variante");

                    if (cajas.length == 0)
                        return;

                    if (!confirm("¿Actualizar el precio de todas las variantes?"))
                        return;

                    cajas.forEach(x => {

                        x.value = document.getElementById("PrecioVenta").value;

                    });

                });

                    //==========================================
        // BUSCAR PROVEEDOR
        //==========================================

        let timeoutProveedor = null;

        const inputProveedor =
            document.getElementById("proveedorBuscar");

        const listaProveedores =
            document.getElementById("listaProveedores");

        const proveedorId =
            document.getElementById("proveedorId");

        if (inputProveedor) {

            inputProveedor.addEventListener("keyup", function () {

                clearTimeout(timeoutProveedor);

                let term = this.value;

                timeoutProveedor = setTimeout(() => {

                    if (term.length < 1) {

                        listaProveedores.innerHTML = "";
                        proveedorId.value = "";

                        return;
                    }

                    fetch(`/Inventarios/BuscarProveedores?term=${term}`)

                        .then(r => r.json())

                        .then(data => {

                            listaProveedores.innerHTML = "";

                            data.forEach(p => {

                                let item =
                                    document.createElement("a");

                                item.className =
                                    "list-group-item list-group-item-action";

                                item.innerHTML = `
                                    <strong>${p.nombre}</strong><br>
                                    <small>${p.codigo}</small>
                                `;

                                item.onclick = () => {

                                    inputProveedor.value =
                                        p.nombre;

                                    proveedorId.value =
                                        p.id;

                                    listaProveedores.innerHTML = "";

                                };

                                listaProveedores.appendChild(item);

                            });

                        });

                }, 300);

            });

            document.addEventListener("click", function (e) {

                if (!inputProveedor.contains(e.target)) {

                    listaProveedores.innerHTML = "";

                }

            });

        }

                //==========================================
        // AGREGAR VARIANTE MANUAL
        //==========================================

        function agregarTalla() {

            const precio =
                document.getElementById("PrecioVenta").value || 0;

            const tabla =
                document.querySelector("#tablaTallas tbody");

            tabla.insertAdjacentHTML("beforeend", `

        <tr>

            <td>
                <input type="text"
                       class="form-control"
                       name="Tallas[${idx}].Color" />
            </td>

            <td>
                <input type="text"
                       class="form-control"
                       name="Tallas[${idx}].Detalle" />
            </td>

            <td>
                <input type="text"
                       class="form-control"
                       name="Tallas[${idx}].Numero" />
            </td>

            <td>
                <input type="number"
                       class="form-control"
                       name="Tallas[${idx}].Cantidad"
                       value="0" />
            </td>

            <td>
                <input type="number"
                       step="0.01"
                       class="form-control precio-variante"
                       name="Tallas[${idx}].Precio"
                       value="${precio}" />
            </td>

            <td>
                <button type="button"
                        class="btn-remove"
                        onclick="eliminarFila(this)">
                    ✕
                </button>
            </td>

        </tr>

            `);

            idx++;
        }

    </script>

}
