@model MovimientoInventario

@{
    ViewData["Title"] = "Detalle del Movimiento";
}

<link rel="stylesheet" href="~/css/MovimientoInventario/Details.css" />

<div class="container mt-4">
    
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📋</span> Detalle del Movimiento
        </h1>
        <a asp-action="Index" class="back-link">
            <span>←</span> Volver
        </a>
    </div>

    <!-- Card principal -->
    <div class="detail-card">
        <div class="info-grid">

            <!-- Fecha -->
            <div class="info-item">
                <div class="info-label">Fecha y Hora</div>
                <div class="info-value">
                    @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            <!-- Tipo -->
            <div class="info-item">
                <div class="info-label">Tipo de Movimiento</div>
                <div class="info-value">
                    <span class="tipo-badge @(Model.Tipo == "Entrada" ? "entrada" : "salida")">
                        @Model.Tipo
                    </span>
                </div>
            </div>

            <!-- Empresa (NUEVO) -->
            <div class="info-item">
                <div class="info-label">Empresa</div>
                <div class="info-value">@Model.Empresa</div>
            </div>

            <!-- Código -->
            <div class="info-item">
                <div class="info-label">Código Producto</div>
                <div class="info-value">@Model.InventarioCodigo</div>
            </div>

            <!-- Marca -->
            <div class="info-item">
                <div class="info-label">Marca</div>
                <div class="info-value">
                    @(Model.Inventario != null ? Model.Inventario.Marca : "N/A")
                </div>
            </div>

        </div>

        <!-- Detalle adicional -->
        @if (!string.IsNullOrEmpty(Model.Detalle))
        {
            <div class="detalle-box">
                <div class="info-label">Detalle del Movimiento</div>
                <div class="detalle-texto">@Model.Detalle</div>
            </div>
        }
    </div>

    <!-- Numeración Movida -->
    <div class="section-title">
        <span>👟</span> Numeración Movida
    </div>

    <div class="tabla-wrapper">
        <table class="numeracion-table">
            <thead>
                <tr>
                    <th>Talla</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles?.Where(x => x.Cantidad > 0) ?? new List<MovimientoDetalle>())
                {
                    <tr>
                        <td class="fw-semibold">@d.Numero</td>
                        <td>
                            @if (Model.Tipo == "Entrada")
                            {
                                <span class="cantidad-entrada">+@d.Cantidad</span>
                            }
                            else
                            {
                                <span class="cantidad-salida">-@d.Cantidad</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="fw-bold">Total</td>
                    <td class="fw-bold">
                        @(Model.Detalles?.Sum(x => x.Cantidad) ?? 0)
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Botones -->
    <div class="action-buttons">
        <a asp-action="Index" class="btn-back">
            <span>←</span> Volver al listado
        </a>

        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-delete">
            🗑 Eliminar
        </a>
    </div>

</div>