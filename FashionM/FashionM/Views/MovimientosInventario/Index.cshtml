@model IEnumerable<MovimientoInventario>

@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<link rel="stylesheet" href="~/css/MovimientoInventario/Index.css" />

<div class="container mt-4">

    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📦</span> Movimientos de Inventario
        </h1>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn-neo">
                <span>➕</span> Nuevo Movimiento
            </a>

            <a asp-action="Grafico" class="btn btn-success">
                📊 Gráfico
            </a>
        </div>
    </div>

    <!-- 🔍 FILTROS -->
    <form method="get" class="filtros-form mb-3">
        <div class="row g-2">

            <!-- Empresa -->
            <div class="col-md-3">
                <select name="empresa" class="form-control">
                    <option value="">Todas las empresas</option>

                    @foreach (var e in ViewBag.Empresas)
                    {
                        <option value="@e" selected="@(e == ViewBag.Empresa ? "selected" : null)">
                            @e
                        </option>
                    }
                </select>
            </div>

            <!-- Fecha Inicio -->
            <div class="col-md-3">
                <input type="date" name="fechaInicio" class="form-control"
                       value="@ViewBag.FechaInicio" />
            </div>

            <!-- Fecha Fin -->
            <div class="col-md-3">
                <input type="date" name="fechaFin" class="form-control"
                       value="@ViewBag.FechaFin" />
            </div>

            <!-- Botones -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    🔍 Filtrar
                </button>

                <a asp-action="Index" class="btn btn-secondary w-100">
                    ❌
                </a>
            </div>

        </div>
    </form>

    <!-- Tabla -->
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Empresa</th>
                        <th>Marca</th>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Numeración</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon">📭</div>
                                    <div class="empty-text">No hay movimientos registrados</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var total = item.Detalles?.Sum(d => d.Cantidad) ?? 0;

                            <tr>
                                <td class="fecha-cell">
                                    @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>@item.Empresa</td>

                                <td class="fw-semibold">
                                    @(item.Inventario?.Marca ?? "N/A")
                                </td>

                                <td>@item.InventarioCodigo</td>

                                <td>
                                    <span class="tipo-badge @(item.Tipo == "Entrada" ? "entrada" : "salida")">
                                        @item.Tipo
                                    </span>
                                </td>

                                <td>
                                    <span class="cantidad-badge @(item.Tipo == "Entrada" ? "entrada" : "salida")">
                                        @(item.Tipo == "Entrada" ? "+" : "-")@total
                                    </span>
                                </td>

                                <td>
                                    @foreach (var d in item.Detalles ?? new List<MovimientoDetalle>())
                                    {
                                        if (d.Cantidad > 0)
                                        {
                                            <span class="detalle-badge">
                                                @d.Numero (@d.Cantidad)
                                            </span>
                                        }
                                    }
                                </td>

                                <td>
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn-action btn-view" title="Ver detalles">
                                            👁
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn-action btn-delete"
                                               onclick="return confirm('¿Eliminar este movimiento?')">
                                            🗑
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 🔢 PAGINACIÓN (CON FILTROS) -->
    @if (ViewBag.TotalPages > 1)
    {
        <ul class="pagination-modern">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-empresa="@ViewBag.Empresa"
                           asp-route-fechaInicio="@ViewBag.FechaInicio"
                           asp-route-fechaFin="@ViewBag.FechaFin">
                        ←
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-empresa="@ViewBag.Empresa"
                           asp-route-fechaInicio="@ViewBag.FechaInicio"
                           asp-route-fechaFin="@ViewBag.FechaFin">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-empresa="@ViewBag.Empresa"
                           asp-route-fechaInicio="@ViewBag.FechaInicio"
                           asp-route-fechaFin="@ViewBag.FechaFin">
                        →
                    </a>
                </li>
            }

        </ul>
    }
</div>