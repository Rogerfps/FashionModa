@model IEnumerable<MovimientoInventario>

@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<link rel="stylesheet" href="~/css/MovimientoInventario/Index.css" />

<div class="container mt-4">
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📦</span> Movimientos de Inventario
        </h1>
        <a asp-action="Create" class="btn-neo">
            <span>➕</span> Nuevo Movimiento
        </a>
    </div>

    <a asp-controller="MovimientosInventario"
           asp-action="Grafico"
           class="btn btn-success">
        📊 Ver Gráfico
    </a>

    <!-- Tabla -->
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Marca</th>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Numeración</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon">📭</div>
                                    <div class="empty-text">No hay movimientos registrados</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var total = item.Detalles.Sum(d => d.Cantidad);

                            <tr>
                                <td class="fecha-cell">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>

                                <td class="fw-semibold">@item.Inventario?.Marca</td>

                                <td>@item.InventarioCodigo</td>

                                <td>
                                    <span class="tipo-badge @(item.Tipo == "Entrada" ? "entrada" : "salida")">
                                        @item.Tipo
                                    </span>
                                </td>

                                <td>
                                    <span class="cantidad-badge @(item.Tipo == "Entrada" ? "entrada" : "salida")">
                                        @(item.Tipo == "Entrada" ? "+" : "-")@total
                                    </span>
                                </td>

                                <td>
                                    @foreach (var d in item.Detalles)
                                    {
                                        <span class="detalle-badge">
                                            @d.Numero (@d.Cantidad)
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn-action btn-view" title="Ver detalles">
                                            👁
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn-action btn-delete" title="Eliminar movimiento"
                                           onclick="return confirm('¿Eliminar este movimiento?')">
                                            🗑
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINACION -->
    @if (ViewBag.TotalPages > 1)
    {
        <ul class="pagination-modern">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                        ←
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                        →
                    </a>
                </li>
            }
        </ul>
    }
</div>