@model MovimientoInventario

@{
    ViewData["Title"] = "Nuevo Movimiento";
}

@{
    var tallas = new List<string> { "A", "B" };
    for (int i = 15; i <= 45; i++)
    {
        tallas.Add(i.ToString());
    }
}

<link rel="stylesheet" href="~/css/MovimientoInventario/Create.css" />

<style>
    .list-group {
        position: absolute;
        width: 100%;
        z-index: 1000;
    }
</style>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="page-header">
        <h1 class="page-title">📦 Registrar Movimiento</h1>
        <a asp-action="Index" class="back-link">← Volver</a>
    </div>

    <!-- FORM -->
    <div class="form-card">
        <form asp-action="Create" method="post" id="formMovimiento">

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="section-title">📋 Información del Movimiento</div>

            <div class="form-grid">

                <!-- AUTOCOMPLETE REAL -->
                <div class="form-group position-relative">
                    <label class="form-label">Producto</label>

                    <input type="text"
                           id="productoBuscar"
                           class="form-control"
                           placeholder="Buscar código o marca..."
                           autocomplete="off" />

                    <input type="hidden"
                           asp-for="InventarioCodigo"
                           id="codigoProducto" />

                    <div id="listaProductos" class="list-group"></div>
                </div>

                <div class="form-group">
                    <label class="form-label">Tipo</label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="Entrada">➕ Entrada</option>
                        <option value="Salida">➖ Salida</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Detalle</label>
                    <input asp-for="Detalle"
                           class="form-control"
                           placeholder="Ej: Compra proveedor / Venta cliente" />
                </div>

                <div class="form-group">
                    <label>Empresa</label>
                    <select asp-for="Empresa" class="form-control">
                        <option value="">Seleccione una empresa</option>

                        @foreach (var emp in ViewBag.Empresas)
                        {
                            <option value="@emp.nombre">@emp.nombre</option>
                        }
                    </select>
                </div>

            </div>

            <!-- INFO PRODUCTO -->
            <div class="section-title">🎨 Información del Producto</div>

            <div class="info-adicional-grid">
                <div class="form-group">
                    <label class="form-label">Color</label>
                    <input id="colorInput" class="form-control" placeholder="Ej: Negro, Rojo" />
                </div>

                <div class="form-group">
                    <label class="form-label">Detalle</label>
                    <input id="detalleInput" class="form-control" placeholder="Ej: Cuero" />
                </div>
            </div>

            <!-- TALLAS -->
            <div class="section-title">👟 Numeración</div>

            <div class="tabla-wrapper">
                <table class="tallas-table">
                    <thead>
                        <tr>
                            <th>Talla</th>
                            <th>Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < tallas.Count; i++)
                        {
                            <tr>
                                <td>
                                    @tallas[i]

                                    <input type="hidden"
                                           name="Detalles[@i].Numero"
                                           value="@tallas[i]" />

                                    <input type="hidden"
                                           name="Detalles[@i].Color"
                                           class="colorHidden" />

                                    <input type="hidden"
                                           name="Detalles[@i].Detalle"
                                           class="detalleHidden" />
                                </td>

                                <td>
                                    <input type="number"
                                           name="Detalles[@i].Cantidad"
                                           class="form-control"
                                           min="0"
                                           value="0" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- BOTONES -->
            <div class="action-buttons">
                <button type="submit" class="btn-save">💾 Guardar Movimiento</button>
                <a asp-action="Index" class="btn-cancel">← Cancelar</a>
            </div>

        </form>
    </div>

</div>

@section Scripts {

    <script>
        let timeout = null;

        const input = document.getElementById("productoBuscar");
        const lista = document.getElementById("listaProductos");
        const hidden = document.getElementById("codigoProducto");

        //  BUSCAR PRODUCTOS (AJAX)
        input.addEventListener("keyup", function () {
            clearTimeout(timeout);

            let term = this.value;

            timeout = setTimeout(() => {

                if (term.length < 1) {
                    lista.innerHTML = "";
                    return;
                }

                fetch(`/MovimientosInventario/BuscarInventarios?term=${term}`)
                    .then(r => r.json())
                    .then(data => {

                        lista.innerHTML = "";

                        if (data.length === 0) {
                            lista.innerHTML = `<div class="list-group-item">Sin resultados</div>`;
                            return;
                        }

                        data.forEach(p => {
                            let item = document.createElement("a");
                            item.className = "list-group-item list-group-item-action";
                            item.innerHTML = `<strong>${p.codigo}</strong> - ${p.marca}`;

                            item.onclick = () => {
                                input.value = p.codigo;
                                hidden.value = p.codigo;
                                lista.innerHTML = "";
                            };

                            lista.appendChild(item);
                        });
                    });

            }, 300);
        });

        // cerrar lista
        document.addEventListener("click", function (e) {
            if (!input.contains(e.target) && !lista.contains(e.target)) {
                lista.innerHTML = "";
            }
        });

        //  COLOR / DETALLE
        const colorInput = document.getElementById("colorInput");
        const detalleInput = document.getElementById("detalleInput");

        function actualizarHidden() {
            const color = colorInput.value;
            const detalle = detalleInput.value;

            document.querySelectorAll(".colorHidden").forEach(e => e.value = color);
            document.querySelectorAll(".detalleHidden").forEach(e => e.value = detalle);
        }

        colorInput.addEventListener("input", actualizarHidden);
        detalleInput.addEventListener("input", actualizarHidden);

        document.getElementById("formMovimiento")
            .addEventListener("submit", actualizarHidden);
    </script>

}