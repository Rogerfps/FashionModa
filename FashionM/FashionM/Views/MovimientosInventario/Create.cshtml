@model MovimientoInventario

@{
    ViewData["Title"] = "Nuevo Movimiento";
}

@{
    var tallas = new List<string> { "A", "B" };

    for (int i = 15; i <= 45; i++)
    {
        tallas.Add(i.ToString());
    }
}

<link rel="stylesheet" href="~/css/MovimientoInventario/Create.css" />

<div class="container mt-4">
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📦</span> Registrar Movimiento
        </h1>
        <a asp-action="Index" class="back-link">
            <span>←</span> Volver
        </a>
    </div>

    <!-- Formulario -->
    <div class="form-card">
        <form asp-action="Create" method="post">
            <div class="section-title">
                <span>📋</span> Información del Movimiento
            </div>

            <!-- Grid principal -->
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Producto</label>
                    <select asp-for="InventarioCodigo" class="form-select">
                        <option value="">-- Seleccionar producto --</option>
                        @foreach (var p in ViewBag.Inventarios)
                        {
                            <option value="@p.Codigo">
                                @p.Marca (@p.Codigo)
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Tipo de Movimiento</label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="Entrada">➕ Entrada</option>
                        <option value="Salida">➖ Salida</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Detalle del Movimiento</label>
                    <input asp-for="Detalle"
                           class="form-control"
                           placeholder="Ej: Compra proveedor / Venta cliente">
                    </div>
                </div>

                <!-- Información adicional del producto -->
                <div class="section-title">
                    <span>🎨</span> Información del Producto
                </div>

                <div class="info-adicional-grid">
                    <div class="form-group">
                        <label class="form-label">Color</label>
                        <input id="colorInput" class="form-control" placeholder="Ej: Negro, Rojo, Azul">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Detalle</label>
                        <input id="detalleInput" class="form-control" placeholder="Ej: Cuero, Sintético">
                    </div>
                </div>

                <!-- Numeración -->
                <div class="section-title">
                    <span>👟</span> Numeración
                </div>

                <div class="tabla-wrapper">
                    <table class="tallas-table">
                        <thead>
                            <tr>
                                <th style="width:150px">Talla</th>
                                <th style="width:200px">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < tallas.Count; i++)
                            {
                                <tr>
                                    <td class="talla-label">
                                        @tallas[i]
                                        <input type="hidden"
                                               name="Detalles[@i].Numero"
                                               value="@tallas[i]" />
                                        <input type="hidden"
                                               name="Detalles[@i].Color"
                                               class="colorHidden" />
                                        <input type="hidden"
                                               name="Detalles[@i].Detalle"
                                               class="detalleHidden" />
                                    </td>
                                    <td>
                                        <input type="number"
                                               name="Detalles[@i].Cantidad"
                                               class="cantidad-input"
                                               min="0"
                                               value="0"
                                               placeholder="0" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Botones -->
                <div class="action-buttons">
                    <button type="submit" class="btn-save">
                        <span>💾</span> Guardar Movimiento
                    </button>
                    <a asp-action="Index" class="btn-cancel">
                        <span>←</span> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.querySelector("form").addEventListener("submit", function () {
            const color = document.getElementById("colorInput").value;
            const detalle = document.getElementById("detalleInput").value;

            document.querySelectorAll(".colorHidden").forEach(e => e.value = color);
            document.querySelectorAll(".detalleHidden").forEach(e => e.value = detalle);
        });
    </script>