@model List<dynamic>

<h2>👥 Usuarios</h2>

<a asp-action="CrearUsuario" class="btn btn-success mb-3">➕ Nuevo</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Roles</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Nombre</td>
                <td>@u.Email</td>
                <td>@u.Roles</td>

                <td>
                    <a asp-action="EditarUsuario" asp-route-id="@u.Id" class="btn btn-warning btn-sm">✏️</a>
                    <a asp-action="EliminarUsuario" asp-route-id="@u.Id" class="btn btn-danger btn-sm">🗑️</a>
                </td>
            </tr>
        }
    </tbody>
</table>