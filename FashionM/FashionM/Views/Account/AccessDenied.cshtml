@{
    ViewData["Title"] = "Acceso Denegado";
}

<link rel="stylesheet" href="~/css/Home/AccessDenied.css" />

<div class="denied-section">
    <div class="denied-card">
        <!-- Icono de prohibido -->
        <div class="icon-container">
            <span>🚫</span>
        </div>

        <!-- Título -->
        <h1 class="denied-title">¡Acceso Denegado!</h1>

        <!-- Mensaje -->
        <p class="denied-message">
            Lo sentimos, no tienes permisos suficientes<br />
            para acceder a esta página.
            Habla con un administrador (Roger)
        </p>

        <!-- Botón de volver al inicio -->
        <a href="/" class="btn-home">
            <span>🏠</span> Volver al Inicio
        </a>

        <!-- Código de error -->
        <div class="error-code">
            ERROR 403 · FORBIDDEN
        </div>
    </div>
</div>