@model FashionM.Models.ClienteSemana

@{
    ViewData["Title"] = "Nueva Visita";
}

<div class="container mt-4" style="max-width:900px;">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                📝 Nueva Visita
            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="ClienteCedula" type="hidden" />

                <div class="mb-3">

                    <label asp-for="FechaVisita" class="form-label">
                        Fecha de la visita
                    </label>

                    <input asp-for="FechaVisita"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="FechaVisita" class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Usuario" class="form-label">
                        Usuario
                    </label>

                    <input asp-for="Usuario"
                           class="form-control" />

                    <span asp-validation-for="Usuario" class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="Observaciones" class="form-label">
                        Resumen de la visita
                    </label>

                    <textarea asp-for="Observaciones"
                              rows="10"
                              class="form-control"
                              placeholder="Escriba aquí el resumen de la visita..."></textarea>

                    <span asp-validation-for="Observaciones" class="text-danger"></span>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       asp-route-clienteCedula="@Model.ClienteCedula"
                       class="btn btn-secondary">

                        ← Volver

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        💾 Guardar Visita

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}