@model IEnumerable<Venta>

@using System.Globalization

@{
    ViewData["Title"] = "Ventas";
}

<link rel="stylesheet" href="~/css/Ventas/VentasIndex.css" />

<div class="ventas-container">

    <!-- HEADER -->
    <div class="page-header">

        <div>

            <h1 class="page-title">
                📊 Módulo de Ventas
            </h1>

            <p class="page-subtitle">
                Historial general de ventas y métricas
            </p>

        </div>

        <div class="header-actions">

            <a asp-action="Graficos"
               class="btn-graficos">

                📈 Dashboard

            </a>

        </div>

    </div>

    <!-- CARDS -->
    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">💰</div>

            <div>

                <div class="stat-label">
                    Total Ventas
                </div>

                <div class="stat-value"
                     id="cardTotalVentas">

                    @Model.Count()

                </div>

            </div>

        </div>

        <div class="stat-card">

            <div class="stat-icon">📦</div>

            <div>

                <div class="stat-label">
                    Total Vendido
                </div>

                <div class="stat-value"
                     id="cardTotalVendido">

                    ₡ @Model.Sum(x => x.Total).ToString("N2")

                </div>

            </div>

        </div>

        <div class="stat-card">

            <div class="stat-icon">👤</div>

            <div>

                <div class="stat-label">
                    Agentes Activos
                </div>

                <div class="stat-value"
                     id="cardAgentes">

                    @Model.Select(x => x.AgenteVenta)
                    .Distinct()
                    .Count()

                </div>

            </div>

        </div>

        <div class="alert alert-info mb-3">
            <strong>🏢 Empresa:</strong>
            @Context.Session.GetString("EmpresaNombre")
        </div>

    </div>

    <!-- FILTROS -->
    <div class="filter-card">

        <div class="filter-grid">

            <!-- BUSCAR -->
            <div class="filter-group">

                <label>
                    🔍 Buscar Cliente o Comercio
                </label>

                <input type="text"
                       id="buscarInput"
                       class="form-control"
                       placeholder="Buscar..." />

            </div>

            

            <!-- TIPO -->
            <div class="filter-group">

                <label>
                    📄 Tipo Documento
                </label>

                <select id="tipoFilter"
                        class="form-select">

                    <option value="">
                        Todos
                    </option>

                    <option value="proforma">
                        PROFORMA
                    </option>

                    <option value="factura_electronica">
                        FACTURA ELECTRÓNICA
                    </option>

                </select>

            </div>

            <!-- AGENTE -->
            <div class="filter-group">

                <label>
                    👤 Agente
                </label>

                <input type="text"
                       id="agenteFilter"
                       class="form-control"
                       placeholder="Buscar agente..." />

            </div>

            <!-- SEMANA -->
            <div class="filter-group">

                <label>
                    📅 Semana
                </label>

                <input type="number"
                       id="semanaFilter"
                       class="form-control"
                       placeholder="Semana" />

            </div>

            <!-- MES -->
            <div class="filter-group">

                <label>
                    📆 Mes
                </label>

                <select id="mesFilter"
                        class="form-select">

                    <option value="">
                        Todos
                    </option>

                    <option value="enero">Enero</option>
                    <option value="febrero">Febrero</option>
                    <option value="marzo">Marzo</option>
                    <option value="abril">Abril</option>
                    <option value="mayo">Mayo</option>
                    <option value="junio">Junio</option>
                    <option value="julio">Julio</option>
                    <option value="agosto">Agosto</option>
                    <option value="septiembre">Septiembre</option>
                    <option value="octubre">Octubre</option>
                    <option value="noviembre">Noviembre</option>
                    <option value="diciembre">Diciembre</option>

                </select>

            </div>

        </div>

        <!-- BOTÓN LIMPIAR -->
        <div class="filter-actions">

            <button type="button"
                    id="btnLimpiar"
                    class="btn-clear">

                ✖ Limpiar Filtros

            </button>

        </div>

    </div>

    <!-- TABLA -->
    <div class="table-card">

        <div class="table-header">

            <h3>
                📄 Historial de Ventas
            </h3>

        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="ventas-table">

                    <thead>

                        <tr>

                            <th>#</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Empresa</th>
                            <th>Agente</th>
                            <th>Tipo</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="venta-row"
                                data-total="@item.Total"
                                data-agente="@(item.AgenteVenta?.ToLower() ?? "")"
                                data-empresa="@(item.Empresa?.Nombre?.ToLower() ?? "")"
                                data-tipo="@(item.TipoDocumento?.ToLower() ?? "")"
                                data-semana="@item.Semana"
                                data-mes="@(CultureInfo
                                                                    .GetCultureInfo("es-CR")
                                                                    .DateTimeFormat
                                                                    .GetMonthName(item.Fecha.Month)
                                                                    .ToLower())"
                                data-buscar="@($"{item.Cliente?.Nombre} {item.Cliente?.Apellidos} {item.Cliente?.Comercio}".ToLower())">

                                <!-- ID -->
                                <td>

                                    #@item.Id

                                </td>

                                <!-- FECHA -->
                                <td>

                                    @item.Fecha.ToString("dd/MM/yyyy")

                                </td>

                                <!-- CLIENTE -->
                                <td>

                                    <div class="client-info">

                                        <strong>

                                            @item.Cliente?.Nombre
                                            @item.Cliente?.Apellidos

                                        </strong>

                                        <small>

                                            @item.Cliente?.Comercio

                                        </small>

                                    </div>

                                </td>

                                <!-- EMPRESA -->
                                <td>

                                    @item.Empresa?.Nombre

                                </td>

                                <!-- AGENTE -->
                                <td>

                                    <span class="agent-badge">

                                        👤 @item.AgenteVenta

                                    </span>

                                </td>

                                <!-- TIPO -->
                                <td>

                                    @if (item.TipoDocumento == "PROFORMA")
                                    {
                                        <span class="type-badge proforma">

                                            📄 PROFORMA

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="type-badge factura">

                                            🧾 FACTURA

                                        </span>
                                    }

                                </td>

                                <!-- TOTAL -->
                                <td class="fw-bold">

                                    ₡ @item.Total.ToString("N2")

                                </td>

                                <!-- ESTADO -->
                                <td>

                                    @if (item.Estado == "ACTIVA")
                                    {
                                        <span class="status-badge active">

                                            ✅ ACTIVA

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge canceled">

                                            ❌ @item.Estado

                                        </span>
                                    }

                                </td>

                                <!-- ACCIONES -->
                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-details">

                                        👁 Ver

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <!-- PAGINACIÓN -->
                <div class="pagination-container">

                    <button id="prevPage"
                            class="pagination-btn">

                        ← Anterior

                    </button>

                    <div id="paginationInfo"
                         class="pagination-info">
                    </div>

                    <button id="nextPage"
                            class="pagination-btn">

                        Siguiente →

                    </button>

                </div>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    📭
                </div>

                <h3>
                    No hay ventas registradas
                </h3>

                <p>
                    Las ventas aparecerán automáticamente
                    cuando se creen proformas o facturas.
                </p>

            </div>
        }

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        // ===========================
        // INPUTS
        // ===========================

        const buscarInput = document.getElementById("buscarInput");
        const tipoFilter = document.getElementById("tipoFilter");
        const agenteFilter = document.getElementById("agenteFilter");
        const semanaFilter = document.getElementById("semanaFilter");
        const mesFilter = document.getElementById("mesFilter");

        // ===========================
        // TABLA
        // ===========================

        const filas = Array.from(document.querySelectorAll(".venta-row"));

        // ===========================
        // CARDS
        // ===========================

        const cardTotalVentas = document.getElementById("cardTotalVentas");
        const cardTotalVendido = document.getElementById("cardTotalVendido");
        const cardAgentes = document.getElementById("cardAgentes");

        // ===========================
        // PAGINACIÓN
        // ===========================

        const prevPage = document.getElementById("prevPage");
        const nextPage = document.getElementById("nextPage");
        const paginationInfo = document.getElementById("paginationInfo");

        let currentPage = 1;
        const rowsPerPage = 15;
        let filasFiltradas = [];

        // ===========================
        // FILTRAR
        // ===========================

        function filtrarVentas() {

            const buscar = buscarInput.value.trim().toLowerCase();
            const tipo = tipoFilter.value.trim().toLowerCase();
            const agente = agenteFilter.value.trim().toLowerCase();
            const semana = semanaFilter.value.trim();
            const mes = mesFilter.value.trim().toLowerCase();

            let totalVendido = 0;
            let agentes = new Set();

            filasFiltradas = [];

            filas.forEach(fila => {

                const textoBuscar = (fila.dataset.buscar || "").toLowerCase();
                const textoTipo = (fila.dataset.tipo || "").toLowerCase();
                const textoAgente = (fila.dataset.agente || "").toLowerCase();
                const textoMes = (fila.dataset.mes || "").toLowerCase();
                const semanaFila = parseInt(fila.dataset.semana || "0");

                const coincideBuscar =
                    buscar === "" || textoBuscar.includes(buscar);

                const coincideTipo =
                    tipo === "" || textoTipo === tipo;

                const coincideAgente =
                    agente === "" || textoAgente.includes(agente);

                const coincideSemana =
                    semana === "" || semanaFila === parseInt(semana);

                const coincideMes =
                    mes === "" || textoMes === mes;

                const mostrar =
                    coincideBuscar &&
                    coincideTipo &&
                    coincideAgente &&
                    coincideSemana &&
                    coincideMes;

                if (mostrar) {

                    filasFiltradas.push(fila);

                    totalVendido += parseFloat(fila.dataset.total || "0");

                    if (textoAgente !== "")
                        agentes.add(textoAgente);
                }

            });

            // ===========================
            // ACTUALIZAR CARDS
            // ===========================

            cardTotalVentas.textContent = filasFiltradas.length;

            cardTotalVendido.textContent =
                "₡ " + totalVendido.toLocaleString("es-CR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

            cardAgentes.textContent = agentes.size;

            currentPage = 1;

            renderPagination();
        }

        // ===========================
        // PAGINACIÓN
        // ===========================

        function renderPagination() {

            filas.forEach(f => f.style.display = "none");

            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            filasFiltradas
                .slice(start, end)
                .forEach(f => f.style.display = "");

            const totalPages = Math.max(
                1,
                Math.ceil(filasFiltradas.length / rowsPerPage)
            );

            paginationInfo.textContent =
                `Página ${currentPage} de ${totalPages}`;

            prevPage.disabled = currentPage === 1;
            nextPage.disabled = currentPage === totalPages;
        }

        // ===========================
        // EVENTOS
        // ===========================

        buscarInput.addEventListener("input", filtrarVentas);
        tipoFilter.addEventListener("change", filtrarVentas);
        agenteFilter.addEventListener("input", filtrarVentas);
        semanaFilter.addEventListener("input", filtrarVentas);
        mesFilter.addEventListener("change", filtrarVentas);

        // ===========================
        // LIMPIAR
        // ===========================

        document
            .getElementById("btnLimpiar")
            .addEventListener("click", () => {

                buscarInput.value = "";
                tipoFilter.value = "";
                agenteFilter.value = "";
                semanaFilter.value = "";
                mesFilter.value = "";

                filtrarVentas();

            });

        // ===========================
        // PAGINACIÓN
        // ===========================

        prevPage.addEventListener("click", () => {

            if (currentPage > 1) {
                currentPage--;
                renderPagination();
            }

        });

        nextPage.addEventListener("click", () => {

            const totalPages =
                Math.max(
                    1,
                    Math.ceil(filasFiltradas.length / rowsPerPage)
                );

            if (currentPage < totalPages) {
                currentPage++;
                renderPagination();
            }

        });

        // ===========================
        // INICIO
        // ===========================

        filtrarVentas();

    });

</script>