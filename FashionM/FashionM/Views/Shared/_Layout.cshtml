@using Microsoft.AspNetCore.Identity
@using FashionM.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El David</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/Home/Layout.css" />

    
</head>

<body>

    <header class="floating-header">
        <nav class="floating-nav">

            <img src="~/images/LogoDavid.png" class="nav-logo" />

            <div class="nav-brand-center">
                EL DAVID
            </div>

            <div class="nav-menu">

                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link" asp-controller="Inventarios" asp-action="Index">Inventario</a>
                <a class="nav-link" asp-controller="PedidoCliente" asp-action="Index">Pedidos</a>

                <a class="nav-link" href="/Account/Logout">Cerrar sesión</a>

                <div class="nav-email">
                    <span>👤</span>
                    @(user?.Nombre ?? User.Identity?.Name)
                </div>

            </div>

        </nav>
    </header>

    <div class="main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-modern">
        <div class="footer-container">
            <div>© @DateTime.UtcNow.Year · El David</div>
            <div>
                <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>