@model Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
    var zapatos = Model.Zapatos?.ToList() ?? new List<Zapato>();
}

<div class="neo-header">
    <div class="container d-flex justify-content-between align-items-center px-3">
        <h1 class="title-glow">✏️ Editar Proveedor</h1>
        <a asp-action="Index" class="back-link">← Volver</a>
    </div>
</div>

<div class="container px-3" style="max-width: 1000px;">
    <div class="form-card">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- 🔴 PK -->
            <input type="hidden" asp-for="Cedula" />

            <h4>Datos del Proveedor</h4>

            <!-- 🔥 NUEVO -->
            <label>Tipo Identificación</label>
            <select asp-for="IDTipo" asp-items="ViewBag.TiposIdentificacion" class="form-control mb-2">
                <option value="">-- Seleccione --</option>
            </select>

            <label>Nombre</label>
            <input asp-for="Nombre" class="form-control mb-2" />

            <label>Apellidos</label>
            <input asp-for="Apellidos" class="form-control mb-2" />

            <label>Correo</label>
            <input asp-for="Correo" class="form-control mb-2" />

            <label>Teléfono</label>
            <input asp-for="Telefono" class="form-control mb-2" />

            <label>Comercio</label>
            <input asp-for="Comercio" class="form-control mb-2" />

            <label>Dirección</label>
            <input asp-for="Direccion" class="form-control mb-2" />

            <label>Actividad</label>
            <input asp-for="Actividad" class="form-control mb-2" />

            <label>Empresa</label>
            <input asp-for="Empresa" class="form-control mb-3" />

            <div class="form-check mb-3">
                <input asp-for="Estado" class="form-check-input" />
                <label asp-for="Estado" class="form-check-label">
                    Activo
                </label>
            </div>

            <hr />

            <h4>Zapatos</h4>

            <table class="table table-bordered" id="tablaZapatos">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Color</th>
                        <th>Suela</th> <!-- 🔥 NUEVO -->
                        <th>Detalle</th>
                        <th>Talla</th>
                        <th>Cantidad</th>
                        <th>Precio Venta</th>
                        <th>Precio Costo</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < zapatos.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" name="Zapatos[@i].Id" value="@zapatos[i].Id" />
                                <input name="Zapatos[@i].Codigo"
                                       value="@zapatos[i].Codigo"
                                       class="form-control" />
                            </td>

                            <td>
                                <input name="Zapatos[@i].Color"
                                       value="@zapatos[i].Color"
                                       class="form-control" />
                            </td>

                            <!-- 🔥 NUEVO -->
                            <td>
                                <input name="Zapatos[@i].Suela"
                                       value="@zapatos[i].Suela"
                                       class="form-control" />
                            </td>

                            <td>
                                <input name="Zapatos[@i].Detalle"
                                       value="@zapatos[i].Detalle"
                                       class="form-control" />
                            </td>

                            <td>
                                <input name="Zapatos[@i].Numero"
                                       value="@zapatos[i].Numero"
                                       class="form-control" />
                            </td>

                            <td>
                                <input name="Zapatos[@i].Cantidad"
                                       value="@zapatos[i].Cantidad"
                                       type="number"
                                       class="form-control" />
                            </td>

                            <td>
                                <input name="Zapatos[@i].PrecioVenta"
                                       value="@zapatos[i].PrecioVenta"
                                       class="form-control" />
                            </td>

                            <td>
                                <input name="Zapatos[@i].PrecioCosto"
                                       value="@zapatos[i].PrecioCosto"
                                       class="form-control" />
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-danger"
                                        onclick="removeRow(this)">
                                    X
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="button" class="btn btn-secondary mb-3" onclick="addRow()">
                ➕ Nuevo Zapato
            </button>

            <hr />

            <button class="btn btn-success">Guardar Todo</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>

        </form>

    </div>
</div>

@section Scripts {
    <script>

        function addRow(){

            let table = document.querySelector("#tablaZapatos tbody");
            let i = table.rows.length;

            table.insertAdjacentHTML("beforeend", `
            <tr>

                <td><input name="Zapatos[${i}].Codigo" class="form-control"/></td>
                <td><input name="Zapatos[${i}].Color" class="form-control"/></td>
                <td><input name="Zapatos[${i}].Suela" class="form-control"/></td>
                <td><input name="Zapatos[${i}].Detalle" class="form-control"/></td>
                <td><input name="Zapatos[${i}].Numero" class="form-control"/></td>
                <td><input name="Zapatos[${i}].Cantidad" type="number" class="form-control"/></td>
                <td><input name="Zapatos[${i}].PrecioVenta" class="form-control"/></td>
                <td><input name="Zapatos[${i}].PrecioCosto" class="form-control"/></td>

                <td>
                    <button type="button" class="btn btn-danger" onclick="removeRow(this)">
                        X
                    </button>
                </td>

            </tr>
            `);
        }

        function removeRow(btn){
            btn.closest("tr").remove();
        }

    </script>
}