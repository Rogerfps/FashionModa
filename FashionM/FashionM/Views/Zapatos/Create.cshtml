@model Zapato

<h2 class="mb-4">Nuevo Zapato</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <!-- PROVEEDOR -->
    <input type="hidden" id="proveedorCedula" value="@ViewBag.ProveedorCedula" />

    <div class="card mb-3">
        <div class="card-body">

            <!-- DATOS GENERALES (se replican) -->
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Código</label>
                    <input id="codigo" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Color</label>
                    <input id="color" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Suela</label>
                    <input id="suela" class="form-control" />
                </div>
            </div>

        </div>
    </div>

    <!-- 🔥 TABLA DE TALLAS -->
    <div class="card">
        <div class="card-body">

            <h5>Tallas</h5>

            <table class="table table-bordered" id="tablaTallas">
                <thead>
                    <tr>
                        <th>Talla</th>
                        <th>Detalle</th>
                        <th>Cantidad</th>
                        <th>Precio Costo</th>
                        <th>Precio Venta</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <button type="button" class="btn btn-primary" onclick="agregarFila()">
                + Agregar Talla
            </button>

        </div>
    </div>

    <!-- IMÁGENES -->
    <div class="card mt-3">
        <div class="card-body">
            <label class="form-label">Imágenes</label>
            <input type="file" name="imagenes" class="form-control" multiple />
        </div>
    </div>

    <!-- BOTONES -->
    <div class="mt-3">
        <button type="submit" class="btn btn-success">Guardar</button>

        <a asp-controller="Proveedores"
               asp-action="Details"
               asp-route-id="@ViewBag.ProveedorCedula"
               class="btn btn-secondary">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <script>
        let index = 0;

        function agregarFila() {

            const codigo = document.getElementById("codigo").value;
            const color = document.getElementById("color").value;
            const suela = document.getElementById("suela").value;
            const proveedor = document.getElementById("proveedorCedula").value;

            if (!codigo || !color || !suela) {
                alert("Completa código, color y suela primero");
                return;
            }

            const fila = `
                <tr>
                    <td>
                        <input name="modelos[${index}].Numero" class="form-control" required />
                    </td>
                    <td>
                        <input name="modelos[${index}].Detalle" class="form-control" />
                    </td>
                    <td>
                        <input name="modelos[${index}].Cantidad" type="number" class="form-control" required />
                    </td>
                    <td>
                        <input name="modelos[${index}].PrecioCosto" type="number" step="0.01" class="form-control" required />
                    </td>
                    <td>
                        <input name="modelos[${index}].PrecioVenta" type="number" step="0.01" class="form-control" required />
                    </td>

                    <!-- CAMPOS OCULTOS -->
                    <input type="hidden" name="modelos[${index}].Codigo" value="${codigo}" />
                    <input type="hidden" name="modelos[${index}].Color" value="${color}" />
                    <input type="hidden" name="modelos[${index}].Suela" value="${suela}" />
                    <input type="hidden" name="modelos[${index}].ProveedorCedula" value="${proveedor}" />

                    <td>
                        <button type="button" class="btn btn-danger" onclick="eliminarFila(this)">
                            X
                        </button>
                    </td>
                </tr>
            `;

            document.querySelector("#tablaTallas tbody").insertAdjacentHTML("beforeend", fila);
            index++;
        }

        function eliminarFila(btn) {
            btn.closest("tr").remove();
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}