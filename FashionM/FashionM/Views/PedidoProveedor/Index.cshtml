@model IEnumerable<PedidoProveedor>

@{
    ViewData["Title"] = "Pedidos a Proveedores";
}

<link rel="stylesheet" href="~/css/PedidoProveedor/PedidoProveedorIndex.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📦</span> Pedidos a Proveedores
    </h1>
</div>

<!-- Generar pedidos -->
<div class="card-modern">
    <div class="section-title">
        <span>⚙️</span> Generar pedidos por semana
    </div>

    <form asp-action="GenerarPedidos" method="post">
        <div class="row align-items-end">
            <div class="col-md-3">
                <label class="form-label">Semana</label>
                <input type="number"
                       name="semana"
                       class="form-control"
                       placeholder="Ej: 32"
                       required />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn-generar">
                    <span>➕</span> Generar pedidos
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Filtros -->
<div class="card-modern">
    <div class="section-title">
        <span>🔍</span> Buscar pedidos
    </div>

    <form method="get">
        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label">N° Pedido</label>
                <input type="number"
                       name="pedidoId"
                       value="@ViewBag.PedidoId"
                       class="form-control"
                       placeholder="ID" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Empresa</label>
                <input type="text"
                       name="empresa"
                       value="@ViewBag.Empresa"
                       class="form-control"
                       placeholder="Nombre empresa" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Semana</label>
                <input type="number"
                       name="semana"
                       value="@ViewBag.Semana"
                       class="form-control"
                       placeholder="Ej: 32" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn-primary">
                    <span>🔍</span> Buscar
                </button>

                <a asp-action="Index" class="btn-secondary">
                    <span>✖</span> Limpiar
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Lista de pedidos -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Empresa</th>
                    <th>Semana</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Total Pares</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.Id</td>
                        <td>@p.Empresa</td>
                        <td>@p.Semana</td>
                        <td>
                            <span class="badge-proveedor">
                                @(p.Proveedor != null ? p.Proveedor.Comercio : p.ProveedorCedula.ToString())
                            </span>
                        </td>
                        <td>@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="total-pares">@p.Detalles.Sum(d => d.Cantidad)</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details"
                                       asp-route-id="@p.Id"
                                       class="btn-view">
                                    👁 Ver
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@p.Id"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm('¿Eliminar este pedido?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-delete">
                                        🗑 Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Paginación -->
@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination-modern">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.Page == i ? "active" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pedidoId="@ViewBag.PedidoId"
                           asp-route-empresa="@ViewBag.Empresa"
                           asp-route-semana="@ViewBag.Semana">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}