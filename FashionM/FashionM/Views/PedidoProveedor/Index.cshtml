@model IEnumerable<PedidoProveedor>

@{
    ViewData["Title"] = "Pedidos a Proveedores";
}

<link rel="stylesheet" href="~/css/PedidoProveedor/PedidoProveedorIndex.css" />

<div class="container mt-4">
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📦</span> Pedidos a Proveedores
        </h1>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            ⚠️ @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            ✅ @TempData["Success"]
        </div>
    }

    <!-- GENERAR PEDIDOS Y RESUMEN -->
    <div class="card-modern">
        <div class="section-title">
            <span>⚙️</span> Generar pedidos por semana
        </div>

        <div class="buttons-row">
            <form asp-action="GenerarPedidos" method="post" style="flex: 1;">
                <div class="row g-2">
                    <div class="col-md-6">
                        <input type="number"
                               name="semana"
                               class="form-control"
                               placeholder="Semana"
                               min="1"
                               max="53"
                               required />
                    </div>
                    <div class="col-md-6">
                        <button type="submit" class="btn-generar w-100">
                            ➕ Generar pedidos
                        </button>
                    </div>
                </div>
            </form>

            <form asp-action="ResumenProveedores" method="get" style="flex: 1;">
                <div class="row g-2">
                    <div class="col-md-6">
                        <input type="number"
                               name="semana"
                               class="form-control"
                               placeholder="Semana"
                               required />
                    </div>
                    <div class="col-md-6">
                        <button type="submit" class="btn-resumen w-100">
                            📊 Ver Resumen
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="card-modern">
        <div class="section-title">
            <span>🔍</span> Buscar pedidos
        </div>

        <form method="get">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">N° Pedido</label>
                    <input type="number"
                           name="pedidoId"
                           value="@ViewBag.PedidoId"
                           class="form-control"
                           placeholder="ID" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Empresa</label>
                    <select name="empresa" class="form-control"
                            onchange="this.form.submit()">
                        <option value="">Todas</option>
                        @foreach (var e in ViewBag.Empresas)
                        {
                            <option value="@e" selected="@(e == ViewBag.Empresa)">
                                @e
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Semana</label>
                    <input type="number"
                           name="semana"
                           value="@ViewBag.Semana"
                           class="form-control"
                           placeholder="Ej: 32" />
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn-primary">
                        🔍 Buscar
                    </button>
                    <a asp-action="Index" class="btn-secondary">
                        ✖ Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- TABLA -->
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Empresa</th>
                        <th>Semana</th>
                        <th>Proveedor</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th></th>
                        <tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        📭 No hay pedidos generados
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@p.Id</td>
                                        <td>@p.Empresa</td>
                                        <td>@p.Semana</td>
                                        <td>
                                            <span class="badge-proveedor">
                                                @(p.Proveedor != null
                                                    ? $"{p.Proveedor.Codigo} - {p.Proveedor.Nombre}"
                                                    : "Sin proveedor")
                                            </span>
                                        </td>
                                        <td>@p.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold">@(p.Detalles?.Sum(d => d.Cantidad) ?? 0)</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-action="Details" asp-route-id="@p.Id" class="btn-view" title="Ver detalles">
                                                    👁
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                                      onsubmit="return confirm('¿Eliminar este pedido?')">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-delete" title="Eliminar">
                                                        🗑
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PAGINACIÓN -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination-modern">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.Page == i ? "active" : "")">
                                <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-pedidoId="@ViewBag.PedidoId"
                                       asp-route-empresa="@ViewBag.Empresa"
                                       asp-route-semana="@ViewBag.Semana">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>