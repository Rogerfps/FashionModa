@model dynamic

@{
    ViewData["Title"] = "Resumen Proveedores";
}

<link rel="stylesheet" href="~/css/PedidoProveedor/PedidoResumen.css" />

<div class="container mt-4">
    <!-- HEADER -->
    <div class="page-header">
        <h1 class="page-title">
            <span>📊</span> Resumen por Proveedor
        </h1>
        <a asp-action="Index" class="btn-back">
            ← Volver
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        foreach (var empresa in Model)
        {
            int totalPares = 0;
            decimal totalMonto = 0;

            foreach (var p in empresa.Proveedores)
            {
                totalPares += (int)p.Pares;
                totalMonto += (decimal)p.Monto;
            }

            <div class="empresa-card">
                <div class="empresa-title">
                    <span>🏢</span> @empresa.Empresa
                </div>

                <div class="table-wrapper">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th class="text-center">Pares</th>
                                <th class="text-right">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in empresa.Proveedores)
                            {
                                <tr>
                                    <td>
                                        <span class="proveedor-badge">@p.Proveedor</span>
                                    </td>
                                    <td class="text-center pares-badge">@p.Pares</td>
                                    <td class="text-right monto-value">$ @p.Monto.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="total-row">
                                <td><strong>TOTAL</strong></td>
                                <td class="text-center"><strong>@totalPares</strong></td>
                                <td class="text-right"><strong>$ @totalMonto.ToString("N0")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📊</div>
            <p>No hay datos disponibles para mostrar</p>
        </div>
    }
</div>