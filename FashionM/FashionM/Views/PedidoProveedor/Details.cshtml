@model PedidoProveedor

@{
    ViewData["Title"] = "Detalle Pedido Proveedor";
    var totalPares = Model.Detalles.Sum(d => d.Cantidad);
}

@{
    var zapatos = ViewBag.Zapatos as List<Zapato>;
}

<link rel="stylesheet" href="~/css/PedidoProveedor/PedidoProveedorDetails.css" />


<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        <span>📋</span> Pedido a Proveedor #@Model.Id
    </h1>
    <a asp-action="Index" class="back-link">
        <span>←</span> Volver
    </a>
</div>

<!-- Información General -->
<div class="detail-card">
    <div class="info-grid">
        <!-- Proveedor -->
        <div class="info-box">
            <div class="info-box-title">
                <span>🏢</span> Proveedor
            </div>
            <div class="info-row">
                <span class="info-label">Nombre</span>
                <span class="info-value">
                    @(Model.Proveedor != null ? Model.Proveedor.Nombre + " " + Model.Proveedor.Apellidos : "—")
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Comercio</span>
                <span class="info-value">
                    @(Model.Proveedor != null ? Model.Proveedor.Comercio : "—")
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Cédula</span>
                <span class="info-value">@Model.ProveedorCedula</span>
            </div>
        </div>

        <!-- Pedido -->
        <div class="info-box">
            <div class="info-box-title">
                <span>📦</span> Pedido
            </div>
            <div class="info-row">
                <span class="info-label">Empresa</span>
                <span class="info-value">@Model.Empresa</span>
            </div>
            <div class="info-row">
                <span class="info-label">Fecha</span>
                <span class="info-value">@Model.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>
</div>

<!-- Detalle del Pedido -->
<div class="detail-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="section-title" style="margin-bottom: 0; border-bottom: none;">
            <span>🛒</span> Detalle del Pedido
        </div>
        <a asp-action="ExportarExcel"
               asp-route-id="@Model.Id"
               class="btn-excel">
            <span>📊</span> Descargar Excel
        </a>
    </div>

    <div class="table-wrapper">
        <table class="detalle-table">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Código</th>
                    <th>Color</th>
                    <th>Talla</th>
                    <th>Detalle</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>
                            @{
                                var zapato = zapatos?
                                .FirstOrDefault(z => z.Codigo == d.CodigoProducto && z.Color == d.Color);

                                if (zapato != null && zapato.Imagenes.Any())
                                {
                                    <img src="@zapato.Imagenes.First().Url"
                                         class="producto-img" />
                                }
                                else
                                {
                                    <div class="no-image">📷</div>
                                }
                            }
                        </td>
                        <td class="fw-semibold">@d.CodigoProducto</td>
                        <td>@d.Color</td>
                        <td>@d.Talla</td>
                        <td>@d.Detalle</td>
                        <td class="fw-bold" style="color: var(--deep-blue);">@d.Cantidad</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Total Pares -->
    <div class="total-box">
        <div class="total-label">Total Pares</div>
        <div class="total-value">@totalPares unidades</div>
    </div>
</div>

<!-- Botón Volver -->
<div>
    <a asp-action="Index" class="btn-back">
        ← Volver al listado
    </a>
</div>