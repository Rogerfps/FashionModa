@model PedidoProveedor

@{
    ViewData["Title"] = "Detalle Pedido Proveedor";
    var zapatos = ViewBag.Zapatos as List<Zapato>;

    var tallas = Enumerable.Range(30, 15).ToList();

    // ✅ AGRUPACIÓN CORRECTA (SIN PRECIO)
    var grupos = Model.Detalles
        .GroupBy(d => new
        {
            d.CodigoProducto,
            d.Color,
            d.Detalle
        })
        .ToList();

    var totalPares = Model.Detalles.Sum(d => d.Cantidad);
}

<link rel="stylesheet" href="~/css/PedidoProveedor/PedidoProveedorDetails.css" />

<!-- Header -->
<div class="page-header">
    <h1 class="page-title">
        📋 Pedido a Proveedor #@Model.Id
    </h1>
    <a asp-action="Index" class="back-link">← Volver</a>
</div>

<!-- INFO -->
<div class="detail-card">
    <div class="info-grid">

        <div class="info-box">
            <div class="info-box-title">🏢 Proveedor</div>

            <div class="info-row">
                <span class="info-label">Proveedor</span>
                <span class="info-value">
                    @(Model.Proveedor != null
                        ? $"{Model.Proveedor.Codigo} - {Model.Proveedor.Nombre}"
                        : "—")
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">ID</span>
                <span class="info-value">@Model.ProveedorCatalogoId</span>
            </div>
        </div>

        <div class="info-box">
            <div class="info-box-title">📦 Pedido</div>

            <div class="info-row">
                <span class="info-label">Empresa</span>
                <span class="info-value">@Model.Empresa</span>
            </div>

            <div class="info-row">
                <span class="info-label">Semana</span>
                <span class="info-value">@Model.Semana</span>
            </div>

            <div class="info-row">
                <span class="info-label">Fecha</span>
                <span class="info-value">
                    @Model.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy")
                </span>
            </div>
        </div>

    </div>
</div>

<!-- DETALLE -->
<div class="detail-card">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="section-title">🛒 Detalle del Pedido</div>

        <a asp-action="ExportarExcel"
               asp-route-id="@Model.Id"
               class="btn-excel">
            📊 Excel
        </a>
    </div>

    <div class="table-wrapper">
        <table class="detalle-table">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Código</th>
                    <th>Color</th>
                    <th>Detalle</th>

                    @foreach (var t in tallas)
                    {
                        <th>@t</th>
                    }

                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var g in grupos)
                {
                    int totalFila = 0;

                    <tr>
                        <!-- FOTO -->
                        <td>
                            @{
                                var zapato = zapatos?
                                    .FirstOrDefault(z =>
                                        z.Codigo == g.Key.CodigoProducto &&
                                        z.Color == g.Key.Color);

                                if (zapato != null && zapato.Imagenes.Any())
                                {
                                    <img src="@zapato.Imagenes.First().Url"
                                         class="producto-img" />
                                }
                                else
                                {
                                    <div class="no-image">📷</div>
                                }
                            }
                        </td>

                        <!-- INFO -->
                        <td>@g.Key.CodigoProducto</td>
                        <td>@g.Key.Color</td>
                        <td>@g.Key.Detalle</td>

                        <!-- TALLAS -->
                        @foreach (var t in tallas)
                        {
                            var cantidad = g
                                .Where(x => x.Talla == t.ToString())
                                .Sum(x => x.Cantidad);

                            totalFila += cantidad;

                            <td class="text-center">
                                @(cantidad > 0 ? cantidad.ToString() : "")
                            </td>
                        }

                        <!-- TOTAL -->
                        <td class="fw-bold">@totalFila</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- TOTAL GENERAL -->
    <div class="total-box">
        <div class="total-label">Total Pares</div>
        <div class="total-value">@totalPares unidades</div>
    </div>

</div>

<!-- VOLVER -->
<div>
    <a asp-action="Index" class="btn-back">
        ← Volver al listado
    </a>
</div>